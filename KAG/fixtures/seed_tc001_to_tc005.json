{
  "_meta": {
    "purpose": "Verify that TIO_EVSLA.schema can express all fields of test_cases_20.json TC001-TC005 + TC020 (Complex multi-metric ceiling).",
    "schema_version": "TIO_EVSLA-0.1.1",
    "covers_test_cases": ["TC001", "TC002", "TC003", "TC004", "TC005", "TC020"],
    "audit_across_all_20_cases": {
      "metrics_used": ["latency", "packet_loss", "guaranteed_bandwidth"],
      "scopes_used": ["hubToAllSpokes", "specificSpoke"],
      "statistics_used": ["p95", "p99", "minimum"],
      "operators_used": ["LESS_THAN", "GREATER_THAN_OR_EQUAL"],
      "time_windows_used": ["fiveMinuteWindow"],
      "multi_metric_cases": ["TC020 (only)"],
      "specific_spoke_cases": ["TC003", "TC006", "TC009", "TC012", "TC015", "TC018"],
      "unused_schema_enum_values": [
        "TIO_SlaScope: perSpoke",
        "TIO_SlaStatistic: average, maximum",
        "TIO_MatchCondition: LESS_THAN_OR_EQUAL, GREATER_THAN, EQUALS",
        "TIO_TimeWindow: oneHourWindow, monthlySlaWindow"
      ]
    },
    "schema_file": "../schema/TIO_EVSLA.schema",
    "convention": {
      "id_prefix": "tenant- / svc- / hub- / spoke- / topo- / exp- / intent- / concept-",
      "IND#_value_rule": "value is the id of a ConceptType hyponym instance defined in concept_members"
    },
    "gaps_found": [
      "GAP-1 (FIXED in schema v0.1.1): SlaExpectation when IND#hasScope = specificSpoke cannot pin down WHICH SpokeSite. Surfaced by TC003 (高雄倉儲中心). Fix applied: added `targetSpoke: SpokeSite` relation on SlaExpectation."
    ],
    "out_of_scope_fields_in_test_cases": [
      "test_case.description : human comment for test set, not the intent's description — kept on side, not stored in KG",
      "test_case.expected_tio_elements : evaluator metadata, not KG facts",
      "test_case.ontology_terms : evaluator metadata, not KG facts",
      "test_case.complexity / category : test set classification, not KG facts",
      "compliance_window.unit : always 'percent_of_time', hardcoded in evaluator/output rather than stored"
    ]
  },

