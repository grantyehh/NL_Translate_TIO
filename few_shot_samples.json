{
  "description": "Few-shot examples for EnterpriseVpnSlaOntology (evsla) hub-and-spoke enterprise VPN SLA intents. The LLM sees only pattern, nl_intent, and jsonld; evsla terms are therefore embedded inside jsonld.",
  "examples": [
    {
      "pattern": "evsla_latency_p95_hub_to_all_spokes",
      "nl_intent": "確保安捷銀行總部至所有分點之延遲在95%的時間內低於50ms。",
      "jsonld": {
        "@context": "https://tmforum.org/schemas/intent-ontology/v1.jsonld",
        "@type": "Intent",
        "id": "intent-fs-evsla-01",
        "name": "Enterprise VPN Hub-Spoke SLA Intent",
        "description": "Assure enterprise VPN SLA requirements for 安捷銀行 using EnterpriseVpnSlaOntology vocabulary.",
        "intentOwner": {
          "id": "ops-manager-01",
          "name": "Network Operations Center"
        },
        "tenant": {
          "id": "tenant-安捷銀行",
          "name": "安捷銀行",
          "@type": "evsla:Tenant"
        },
        "intentExpectation": [
          {
            "id": "exp-fs-01-latency",
            "name": "Hub-to-Spoke Latency SLA Expectation",
            "description": "Guarantee evsla:latency for 安捷銀行 enterprise VPN service within the requested hub-and-spoke scope.",
            "@type": "PropertyExpectation",
            "expectationObject": {
              "id": "service-安捷銀行-enterprise-vpn",
              "name": "安捷銀行 Enterprise VPN Service",
              "@type": "Service",
              "evsla:forTenant": {
                "id": "tenant-安捷銀行",
                "name": "安捷銀行",
                "@type": "evsla:Tenant"
              },
              "ontologyType": "evsla:EnterpriseVpnService"
            },
            "expectationTarget": [
              {
                "name": "Hub-to-Spoke Latency",
                "targetProperty": "evsla:latency",
                "matchCondition": "LESS_THAN",
                "targetValue": {
                  "value": 50,
                  "unit": "ms",
                  "@type": "quan:Quantity"
                },
                "evsla:hasMetric": "evsla:latency",
                "evsla:hasThreshold": {
                  "value": 50,
                  "unit": "ms",
                  "@type": "quan:Quantity"
                },
                "evsla:hasStatistic": "evsla:p95",
                "evsla:hasScope": "evsla:hubToAllSpokes",
                "evsla:hasMeasurementMethod": "evsla:twamp",
                "evsla:hasTimeWindow": "evsla:fiveMinuteWindow",
                "scope": {
                  "hub": "台北總部",
                  "spokes": [
                    "新竹分行",
                    "台中分行",
                    "高雄分行"
                  ]
                }
              }
            ],
            "ontologyType": "evsla:SlaExpectation"
          }
        ],
        "intentContext": [
          {
            "id": "topology-fs-01",
            "@type": "Context",
            "name": "Hub-and-Spoke Topology",
            "evsla:hasHub": {
              "@type": "evsla:HubSite",
              "name": "台北總部"
            },
            "evsla:hasSpoke": [
              {
                "@type": "evsla:SpokeSite",
                "name": "新竹分行"
              },
              {
                "@type": "evsla:SpokeSite",
                "name": "台中分行"
              },
              {
                "@type": "evsla:SpokeSite",
                "name": "高雄分行"
              }
            ],
            "ontologyType": "evsla:HubAndSpokeTopology"
          }
        ],
        "intentReport": {
          "reportingInterval": "PT5M",
          "handlerResponse": "Continuous"
        },
        "ontologyType": "evsla:EnterpriseVpnSlaIntent"
      }
    },
    {
