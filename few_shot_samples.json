{
  "description": "Few-shot examples for nl_to_tio.py. Learn the API-friendly TIO JSON-LD payload shape: top-level Intent metadata, intentExpectation array, structured expectationObject, structured expectationTarget with targetProperty/matchCondition/targetValue, optional intentContext, and intentReport. Core intent semantics must be represented as JSON fields, not only in description.",
  "examples": [
    {
      "pattern": "delivery_expectation",
      "nl_intent": "在高雄與屏東之間提供企業專用 5G 切片服務。",
      "jsonld": {
        "@context": "https://tmforum.org/schemas/intent-ontology/v1.jsonld",
        "@type": "Intent",
        "id": "intent-fs-d01",
        "name": "Enterprise 5G Slice Delivery Intent",
        "description": "Provide a dedicated enterprise 5G slice between Kaohsiung and Pingtung.",
        "intentOwner": {
          "id": "ops-manager-01",
          "name": "Network Operations Center"
        },
        "intentExpectation": [
          {
            "id": "exp-delivery-01",
            "name": "5G Slice Delivery",
            "description": "Deliver an enterprise 5G slice service for the requested geographic scope.",
            "@type": "DeliveryExpectation",
            "expectationObject": {
              "id": "service-enterprise-5g-slice",
              "name": "Enterprise 5G Slice Service",
              "@type": "Service"
            },
            "expectationTarget": [
              {
                "name": "Connectivity Scope",
                "targetProperty": "connectivity",
                "matchCondition": "EQUALS",
                "targetValue": {
                  "from": "Kaohsiung",
                  "to": "Pingtung"
                }
              }
            ]
          }
        ],
        "intentContext": [
          {
            "id": "ctx-location-01",
            "name": "Geographic Scope",
            "@type": "LocationContext",
            "value": "Kaohsiung_to_Pingtung"
          }
        ],
        "intentReport": {
          "reportingInterval": "PT5M",
          "handlerResponse": "Continuous"
        }
      }
    },
    {
      "pattern": "property_expectation_latency",
      "nl_intent": "確保視訊會議流量的延遲低於 20ms。",
      "jsonld": {
        "@context": "https://tmforum.org/schemas/intent-ontology/v1.jsonld",
        "@type": "Intent",
        "id": "intent-fs-p01",
        "name": "Video Conferencing Latency Intent",
        "description": "Ensure video conferencing traffic latency stays below 20 ms.",
        "intentOwner": {
          "id": "ops-manager-01",
          "name": "Network Operations Center"
        },
        "intentExpectation": [
          {
            "id": "exp-latency-01",
            "name": "Latency Expectation",
            "description": "The end-to-end latency must be kept below 20 ms.",
            "@type": "PropertyExpectation",
            "expectationObject": {
              "id": "service-video-conference",
              "name": "Video Conferencing Traffic",
              "@type": "Service"
            },
            "expectationTarget": [
              {
                "name": "End-to-End Latency",
                "targetProperty": "latency",
                "matchCondition": "LESS_THAN",
                "targetValue": {
                  "value": 20,
                  "unit": "ms"
                }
              }
            ]
          }
        ],
        "intentContext": [],
        "intentReport": {
          "reportingInterval": "PT5M",
          "handlerResponse": "Continuous"
        }
      }
    },
    {
      "pattern": "multi_property_same_object",
      "nl_intent": "保證企業備援連線的下載速度高於 200Mbps 且延遲低於 15ms。",
      "jsonld": {
        "@context": "https://tmforum.org/schemas/intent-ontology/v1.jsonld",
        "@type": "Intent",
        "id": "intent-fs-mp01",
        "name": "Enterprise Backup Link Performance Intent",
        "description": "Ensure the enterprise backup link meets throughput and latency requirements.",
        "intentOwner": {
          "id": "ops-manager-01",
          "name": "Network Operations Center"
        },
        "intentExpectation": [
          {
            "id": "exp-throughput-01",
            "name": "Download Throughput Expectation",
            "description": "Download throughput must be greater than 200 Mbps.",
            "@type": "PropertyExpectation",
            "expectationObject": {
              "id": "service-enterprise-backup-link",
              "name": "Enterprise Backup Link",
              "@type": "Service"
            },
            "expectationTarget": [
              {
                "name": "Download Throughput",
                "targetProperty": "throughput",
                "matchCondition": "GREATER_THAN",
                "targetValue": {
                  "value": 200,
                  "unit": "Mbps"
                }
              }
            ]
          },
          {
            "id": "exp-latency-01",
            "name": "Latency Expectation",
            "description": "Latency must be below 15 ms.",
            "@type": "PropertyExpectation",
            "expectationObject": {
              "id": "service-enterprise-backup-link",
              "name": "Enterprise Backup Link",
              "@type": "Service"
            },
            "expectationTarget": [
              {
                "name": "End-to-End Latency",
                "targetProperty": "latency",
                "matchCondition": "LESS_THAN",
                "targetValue": {
                  "value": 15,
                  "unit": "ms"
                }
              }
            ]
          }
        ],
        "intentContext": [],
        "intentReport": {
          "reportingInterval": "PT5M",
          "handlerResponse": "Continuous"
        }
      }
    },
    {
      "pattern": "context_plus_property_expectation",
      "nl_intent": "在週末晚間時段，將園區備份流量限制在 300Mbps 以下。",
      "jsonld": {
        "@context": "https://tmforum.org/schemas/intent-ontology/v1.jsonld",
        "@type": "Intent",
        "id": "intent-fs-c01",
        "name": "Campus Backup Traffic Throttle Intent",
        "description": "Limit campus backup traffic bandwidth during weekend evenings.",
        "intentOwner": {
          "id": "ops-manager-01",
          "name": "Network Operations Center"
        },
        "intentExpectation": [
          {
            "id": "exp-bandwidth-limit-01",
            "name": "Backup Traffic Bandwidth Limit",
            "description": "Backup traffic must stay below 300 Mbps during the specified time window.",
            "@type": "PropertyExpectation",
            "expectationObject": {
              "id": "service-campus-backup-traffic",
              "name": "Campus Backup Traffic",
              "@type": "Service"
            },
            "expectationTarget": [
              {
                "name": "Bandwidth Limit",
                "targetProperty": "bandwidth",
                "matchCondition": "LESS_THAN",
                "targetValue": {
                  "value": 300,
                  "unit": "Mbps"
                }
              }
            ]
          }
        ],
        "intentContext": [
          {
            "id": "ctx-weekend-evening-01",
            "name": "Weekend Evening Window",
            "@type": "TimeContext",
            "value": "weekend_evening"
          }
        ],
        "intentReport": {
          "reportingInterval": "PT5M",
          "handlerResponse": "Continuous"
        }
      }
    }
  ]
}
