    {
      "pattern": "evsla_minimum_bandwidth_specific_spoke",
      "nl_intent": "提供宏達物流總部至高雄倉儲中心100Mbps以上保證頻寬。",
      "jsonld": {
        "@context": "https://tmforum.org/schemas/intent-ontology/v1.jsonld",
        "@type": "Intent",
        "id": "intent-fs-evsla-03",
        "name": "Enterprise VPN Hub-Spoke SLA Intent",
        "description": "Assure enterprise VPN SLA requirements for 宏達物流 using EnterpriseVpnSlaOntology vocabulary.",
        "intentOwner": {
          "id": "ops-manager-01",
          "name": "Network Operations Center"
        },
        "tenant": {
          "id": "tenant-宏達物流",
          "name": "宏達物流",
          "@type": "evsla:Tenant"
        },
        "intentExpectation": [
          {
            "id": "exp-fs-03-guaranteed-bandwidth",
            "name": "Guaranteed Bandwidth SLA Expectation",
            "description": "Guarantee evsla:guaranteedBandwidth for 宏達物流 enterprise VPN service within the requested hub-and-spoke scope.",
            "@type": "PropertyExpectation",
            "expectationObject": {
              "id": "service-宏達物流-enterprise-vpn",
              "name": "宏達物流 Enterprise VPN Service",
              "@type": "Service",
              "evsla:forTenant": {
                "id": "tenant-宏達物流",
                "name": "宏達物流",
                "@type": "evsla:Tenant"
              },
              "ontologyType": "evsla:EnterpriseVpnService"
            },
            "expectationTarget": [
              {
                "name": "Guaranteed Bandwidth",
                "targetProperty": "evsla:guaranteedBandwidth",
                "matchCondition": "GREATER_THAN_OR_EQUAL",
                "targetValue": {
                  "value": 100,
                  "unit": "Mbps",
                  "@type": "quan:Quantity"
                },
                "evsla:hasMetric": "evsla:guaranteedBandwidth",
                "evsla:hasThreshold": {
                  "value": 100,
                  "unit": "Mbps",
                  "@type": "quan:Quantity"
                },
                "evsla:hasStatistic": "evsla:minimum",
                "evsla:hasScope": "evsla:specificSpoke",
                "evsla:hasMeasurementMethod": "evsla:activeMeasurement",
                "evsla:hasTimeWindow": "evsla:fiveMinuteWindow",
                "scope": {
                  "hub": "台北營運總部",
                  "spokes": [
                    "高雄倉儲中心"
                  ]
                }
              }
            ],
            "ontologyType": "evsla:SlaExpectation"
          }
        ],
        "intentContext": [
          {
            "id": "topology-fs-03",
            "@type": "Context",
            "name": "Hub-and-Spoke Topology",
            "evsla:hasHub": {
              "@type": "evsla:HubSite",
              "name": "台北營運總部"
            },
            "evsla:hasSpoke": [
              {
                "@type": "evsla:SpokeSite",
                "name": "高雄倉儲中心"
              }
            ],
            "ontologyType": "evsla:HubAndSpokeTopology"
          }
        ],
        "intentReport": {
          "reportingInterval": "PT5M",
          "handlerResponse": "Continuous"
        },
        "ontologyType": "evsla:EnterpriseVpnSlaIntent"
      }
    },
    {
