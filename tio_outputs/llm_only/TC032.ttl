@prefix icm:   <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix quan:  <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix log:   <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix met:   <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex:    <http://example.org/tio-instance/tc032/> .

ex:intent a icm:Intent, evsla:EnterpriseVpnSlaIntent ;
  icm:intentElements ex:exp-latency, ex:cond-latency, ex:exp-guaranteed-bandwidth, ex:cond-guaranteed-bandwidth, ex:topology ;
  rdfs:comment "Assure hub-to-all-spokes latency and guaranteed bandwidth SLA for 鑫橋金融 enterprise VPN."@en .

ex:tenant a evsla:Tenant ;
  rdfs:label "鑫橋金融"@zh .

ex:service a evsla:EnterpriseVpnService ;
  evsla:forTenant ex:tenant .

ex:exp-latency a icm:PropertyExpectation, evsla:SlaExpectation ;
  icm:target ex:tgt-latency ;
  rdfs:comment "Latency must stay below 15 ms at p99 across all spokes."@en .

ex:tgt-latency a icm:Target ;
  evsla:hasMetric evsla:latency ;
  icm:valuesOfTargetProperty ex:thr-latency ;
  evsla:hasThreshold ex:thr-latency ;
  evsla:hasStatistic evsla:p99 ;
  evsla:hasScope evsla:hubToAllSpokes ;
  evsla:hasMeasurementMethod evsla:twamp ;
  evsla:hasTimeWindow evsla:fiveMinuteWindow .

ex:thr-latency a quan:Quantity ;
  rdf:value 15 ;
  quan:unit "ms" .

ex:cond-latency a log:Condition ;
  quan:smaller ( ex:obs-latency-value ex:thr-latency ) .

ex:obs-latency a met:Observation ;
  met:observedMetric evsla:latency .

ex:obs-latency-value a quan:Quantity ;
  met:observedValue ( ex:obs-latency ) .

ex:exp-guaranteed-bandwidth a icm:PropertyExpectation, evsla:SlaExpectation ;
  icm:target ex:tgt-guaranteed-bandwidth ;
  rdfs:comment "Guaranteed bandwidth must be at least 500 Mbps across all spokes."@en .

ex:tgt-guaranteed-bandwidth a icm:Target ;
  evsla:hasMetric evsla:guaranteedBandwidth ;
  icm:valuesOfTargetProperty ex:thr-guaranteed-bandwidth ;
  evsla:hasThreshold ex:thr-guaranteed-bandwidth ;
  evsla:hasStatistic evsla:minimum ;
  evsla:hasScope evsla:hubToAllSpokes ;
  evsla:hasMeasurementMethod evsla:activeMeasurement ;
  evsla:hasTimeWindow evsla:fiveMinuteWindow .

ex:thr-guaranteed-bandwidth a quan:Quantity ;
  rdf:value 500 ;
  quan:unit "Mbps" .

ex:cond-guaranteed-bandwidth a log:Condition ;
  quan:atLeast ( ex:obs-guaranteed-bandwidth-value ex:thr-guaranteed-bandwidth ) .

ex:obs-guaranteed-bandwidth a met:Observation ;
  met:observedMetric evsla:guaranteedBandwidth .

ex:obs-guaranteed-bandwidth-value a quan:Quantity ;
  met:observedValue ( ex:obs-guaranteed-bandwidth ) .

ex:topology a icm:Context, evsla:HubAndSpokeTopology ;
  evsla:hasHub [ a evsla:HubSite ; rdfs:label "信義金融總部"@zh ] ;
  evsla:hasSpoke [ a evsla:SpokeSite ; rdfs:label "交易室一"@zh ] ;
  evsla:hasSpoke [ a evsla:SpokeSite ; rdfs:label "交易室二"@zh ] ;
  evsla:hasSpoke [ a evsla:SpokeSite ; rdfs:label "交易室三"@zh ] .