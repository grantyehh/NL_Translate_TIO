@prefix icm:   <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix quan:  <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix log:   <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix met:   <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex:    <http://example.org/tio-instance/tc026/> .

ex:intent a icm:Intent, evsla:EnterpriseVpnSlaIntent ;
  icm:intentElements ex:exp-latency-xinzhu, ex:cond-latency-xinzhu, ex:exp-latency-kaohsiung, ex:cond-latency-kaohsiung, ex:topology ;
  rdfs:comment "Assure per-spoke latency SLA for 星河銀行 enterprise VPN from hub to named spokes at p95."@en .

ex:tenant a evsla:Tenant ;
  rdfs:label "星河銀行"@zh .

ex:service a evsla:EnterpriseVpnService ;
  evsla:forTenant ex:tenant .

ex:exp-latency-xinzhu a icm:PropertyExpectation, evsla:SlaExpectation ;
  icm:target ex:tgt-latency-xinzhu ;
  rdfs:comment "Latency from the hub to 新竹分行 must stay below 30 ms at p95."@en .

ex:tgt-latency-xinzhu a icm:Target ;
  evsla:hasMetric evsla:latency ;
  icm:valuesOfTargetProperty ex:thr-latency-xinzhu ;
  evsla:hasThreshold ex:thr-latency-xinzhu ;
  evsla:hasStatistic evsla:p95 ;
  evsla:hasScope evsla:specificSpoke ;
  evsla:hasMeasurementMethod evsla:twamp ;
  evsla:hasTimeWindow evsla:fiveMinuteWindow .

ex:thr-latency-xinzhu a quan:Quantity ;
  rdf:value 30 ;
  quan:unit "ms" .

ex:cond-latency-xinzhu a log:Condition ;
  quan:smaller ( ex:obs-latency-xinzhu-value ex:thr-latency-xinzhu ) .

ex:obs-latency-xinzhu a met:Observation ;
  met:observedMetric evsla:latency .

ex:obs-latency-xinzhu-value a quan:Quantity ;
  met:observedValue ( ex:obs-latency-xinzhu ) .

ex:exp-latency-kaohsiung a icm:PropertyExpectation, evsla:SlaExpectation ;
  icm:target ex:tgt-latency-kaohsiung ;
  rdfs:comment "Latency from the hub to 高雄分行 must stay below 60 ms at p95."@en .

ex:tgt-latency-kaohsiung a icm:Target ;
  evsla:hasMetric evsla:latency ;
  icm:valuesOfTargetProperty ex:thr-latency-kaohsiung ;
  evsla:hasThreshold ex:thr-latency-kaohsiung ;
  evsla:hasStatistic evsla:p95 ;
  evsla:hasScope evsla:specificSpoke ;
  evsla:hasMeasurementMethod evsla:twamp ;
  evsla:hasTimeWindow evsla:fiveMinuteWindow .

ex:thr-latency-kaohsiung a quan:Quantity ;
  rdf:value 60 ;
  quan:unit "ms" .

ex:cond-latency-kaohsiung a log:Condition ;
  quan:smaller ( ex:obs-latency-kaohsiung-value ex:thr-latency-kaohsiung ) .

ex:obs-latency-kaohsiung a met:Observation ;
  met:observedMetric evsla:latency .

ex:obs-latency-kaohsiung-value a quan:Quantity ;
  met:observedValue ( ex:obs-latency-kaohsiung ) .

ex:topology a icm:Context, evsla:HubAndSpokeTopology ;
  evsla:hasHub [ a evsla:HubSite ; rdfs:label "台北總部"@zh ] ;
  evsla:hasSpoke [ a evsla:SpokeSite ; rdfs:label "新竹分行"@zh ] ;
  evsla:hasSpoke [ a evsla:SpokeSite ; rdfs:label "高雄分行"@zh ] .