@prefix icm:   <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix quan:  <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix log:   <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix met:   <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex:    <http://example.org/tio-instance/tc040/> .

ex:intent a icm:Intent, evsla:EnterpriseVpnSlaIntent ;
  icm:intentElements ex:exp-packet-loss, ex:cond-packet-loss, ex:exp-bandwidth, ex:cond-bandwidth, ex:topology ;
  rdfs:comment "Assure packet loss and guaranteed bandwidth SLA from the Taipei core hub to five PoP spokes for 聯光電信 enterprise VPN."@en .

ex:tenant a evsla:Tenant ;
  rdfs:label "聯光電信"@zh .

ex:service a evsla:EnterpriseVpnService ;
  evsla:forTenant ex:tenant .

ex:exp-packet-loss a icm:PropertyExpectation, evsla:SlaExpectation ;
  icm:target ex:tgt-packet-loss ;
  rdfs:comment "Packet loss must not exceed 0.3% across all spokes."@en .

ex:tgt-packet-loss a icm:Target ;
  evsla:hasMetric evsla:packetLoss ;
  icm:valuesOfTargetProperty ex:thr-packet-loss ;
  evsla:hasThreshold ex:thr-packet-loss ;
  evsla:hasStatistic evsla:maximum ;
  evsla:hasScope evsla:hubToAllSpokes ;
  evsla:hasMeasurementMethod evsla:twamp ;
  evsla:hasTimeWindow evsla:fiveMinuteWindow .

ex:thr-packet-loss a quan:Quantity ;
  rdf:value 0.3 ;
  quan:unit "%" .

ex:cond-packet-loss a log:Condition ;
  quan:smaller ( ex:obs-packet-loss-value ex:thr-packet-loss ) .

ex:obs-packet-loss a met:Observation ;
  met:observedMetric evsla:packetLoss .

ex:obs-packet-loss-value a quan:Quantity ;
  met:observedValue ( ex:obs-packet-loss ) .

ex:exp-bandwidth a icm:PropertyExpectation, evsla:SlaExpectation ;
  icm:target ex:tgt-bandwidth ;
  rdfs:comment "Guaranteed bandwidth must be at least 500 Mbps across all spokes."@en .

ex:tgt-bandwidth a icm:Target ;
  evsla:hasMetric evsla:guaranteedBandwidth ;
  icm:valuesOfTargetProperty ex:thr-bandwidth ;
  evsla:hasThreshold ex:thr-bandwidth ;
  evsla:hasStatistic evsla:average ;
  evsla:hasScope evsla:hubToAllSpokes ;
  evsla:hasMeasurementMethod evsla:activeMeasurement ;
  evsla:hasTimeWindow evsla:fiveMinuteWindow .

ex:thr-bandwidth a quan:Quantity ;
  rdf:value 500 ;
  quan:unit "Mbps" .

ex:cond-bandwidth a log:Condition ;
  quan:atLeast ( ex:obs-bandwidth-value ex:thr-bandwidth ) .

ex:obs-bandwidth a met:Observation ;
  met:observedMetric evsla:guaranteedBandwidth .

ex:obs-bandwidth-value a quan:Quantity ;
  met:observedValue ( ex:obs-bandwidth ) .

ex:topology a icm:Context, evsla:HubAndSpokeTopology ;
  evsla:hasHub [ a evsla:HubSite ; rdfs:label "台北核心機房"@zh ] ;
  evsla:hasSpoke [ a evsla:SpokeSite ; rdfs:label "PoP節點一"@zh ] ;
  evsla:hasSpoke [ a evsla:SpokeSite ; rdfs:label "PoP節點二"@zh ] ;
  evsla:hasSpoke [ a evsla:SpokeSite ; rdfs:label "PoP節點三"@zh ] ;
  evsla:hasSpoke [ a evsla:SpokeSite ; rdfs:label "PoP節點四"@zh ] ;
  evsla:hasSpoke [ a evsla:SpokeSite ; rdfs:label "PoP節點五"@zh ] .