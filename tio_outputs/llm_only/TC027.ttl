@prefix icm:   <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix quan:  <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix log:   <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix met:   <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex:    <http://example.org/tio-instance/tc027/> .

ex:intent a icm:Intent, evsla:EnterpriseVpnSlaIntent ;
  icm:intentElements ex:exp-latency, ex:cond-latency, ex:exp-packet-loss, ex:cond-packet-loss, ex:topology ;
  rdfs:comment "Assure p99 latency below 20 ms to 基隆電廠 and p99 packet loss below 0.05% to 苗栗電廠 and 彰濱電廠 for 昇晟能源 enterprise VPN."@en .

ex:tenant a evsla:Tenant ;
  rdfs:label "昇晟能源"@zh .

ex:service a evsla:EnterpriseVpnService ;
  evsla:forTenant ex:tenant .

ex:exp-latency a icm:PropertyExpectation, evsla:SlaExpectation ;
  icm:target ex:tgt-latency ;
  rdfs:comment "Latency must stay below 20 ms at p99 to the specified spoke."@en .

ex:tgt-latency a icm:Target ;
  evsla:hasMetric evsla:latency ;
  icm:valuesOfTargetProperty ex:thr-latency ;
  evsla:hasThreshold ex:thr-latency ;
  evsla:hasStatistic evsla:p99 ;
  evsla:hasScope evsla:specificSpoke ;
  evsla:hasMeasurementMethod evsla:twamp ;
  evsla:hasTimeWindow evsla:fiveMinuteWindow .

ex:thr-latency a quan:Quantity ;
  rdf:value 20 ;
  quan:unit "ms" .

ex:cond-latency a log:Condition ;
  quan:smaller ( ex:obs-latency-value ex:thr-latency ) .

ex:obs-latency a met:Observation ;
  met:observedMetric evsla:latency .

ex:obs-latency-value a quan:Quantity ;
  met:observedValue ( ex:obs-latency ) .

ex:exp-packet-loss a icm:PropertyExpectation, evsla:SlaExpectation ;
  icm:target ex:tgt-packet-loss ;
  rdfs:comment "Packet loss must stay below 0.05% at p99 to the specified spokes."@en .

ex:tgt-packet-loss a icm:Target ;
  evsla:hasMetric evsla:packetLoss ;
  icm:valuesOfTargetProperty ex:thr-packet-loss ;
  evsla:hasThreshold ex:thr-packet-loss ;
  evsla:hasStatistic evsla:p99 ;
  evsla:hasScope evsla:specificSpoke ;
  evsla:hasMeasurementMethod evsla:twamp ;
  evsla:hasTimeWindow evsla:fiveMinuteWindow .

ex:thr-packet-loss a quan:Quantity ;
  rdf:value 0.05 ;
  quan:unit "%" .

ex:cond-packet-loss a log:Condition ;
  quan:smaller ( ex:obs-packet-loss-value ex:thr-packet-loss ) .

ex:obs-packet-loss a met:Observation ;
  met:observedMetric evsla:packetLoss .

ex:obs-packet-loss-value a quan:Quantity ;
  met:observedValue ( ex:obs-packet-loss ) .

ex:topology a icm:Context, evsla:HubAndSpokeTopology ;
  evsla:hasHub [ a evsla:HubSite ; rdfs:label "台北能源調度中心"@zh ] ;
  evsla:hasSpoke [ a evsla:SpokeSite ; rdfs:label "基隆電廠"@zh ] ;
  evsla:hasSpoke [ a evsla:SpokeSite ; rdfs:label "苗栗電廠"@zh ] ;
  evsla:hasSpoke [ a evsla:SpokeSite ; rdfs:label "彰濱電廠"@zh ] .