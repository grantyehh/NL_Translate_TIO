@prefix ex: <http://example.org/tio-instance/tc009/> .
@prefix tio: <http://example.org/tio#> .
@prefix evsla: <http://example.org/evsla#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:intent-tc009 a tio:Intent ;
    tio:hasService ex:vpn-service-tc009 .

ex:vpn-service-tc009 a evsla:EnterpriseVPNService ;
    evsla:hasTopology evsla:HubAndSpoke ;
    evsla:hasHubSite ex:site-headquarters ;
    evsla:hasSpokeSite ex:site-changbin-windfarm ;
    evsla:hasSLA ex:sla-tc009 .

ex:site-headquarters a evsla:Site ;
    evsla:siteName "綠能電力總部" .

ex:site-changbin-windfarm a evsla:Site ;
    evsla:siteName "彰濱風場" .

ex:sla-tc009 a evsla:SLA ;
    evsla:hasObjective ex:bandwidth-objective-tc009 .

ex:bandwidth-objective-tc009 a evsla:SLAObjective ;
    evsla:metric evsla:Bandwidth ;
    evsla:statistic evsla:Guaranteed ;
    evsla:scope evsla:EndToEnd ;
    evsla:method evsla:Minimum ;
    evsla:operator evsla:GreaterThanOrEqual ;
    evsla:value "200"^^xsd:decimal ;
    evsla:unit evsla:Mbps .