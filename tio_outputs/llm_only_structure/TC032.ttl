@prefix ex: <http://example.org/tio-instance/tc032/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/Quantity/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:intent
    a icm:Intent ;
    icm:intentElements ex:exp-latency, ex:exp-bandwidth, ex:topology, ex:cond-latency, ex:cond-bandwidth ;
    rdfs:comment "Xinqiao Financial requires latency from Xinyi Financial headquarters to all trading rooms to stay below 15 ms for 99% of the time, and guaranteed bandwidth to be no less than 500 Mbps."@en .

ex:exp-latency
    a icm:PropertyExpectation ;
    icm:target ex:tgt-latency .

ex:tgt-latency
    a icm:Target ;
    ex:metricPredicate ex:latency ;
    icm:valuesOfTargetProperty ex:thr-latency ;
    ex:thresholdPredicate ex:thr-latency ;
    ex:statisticPredicate ex:p99 ;
    ex:scopePredicate ex:hub-to-all-spokes ;
    ex:methodPredicate ex:measured ;
    ex:windowPredicate ex:time-99-percent .

ex:thr-latency
    a quan:Quantity ;
    rdf:value 15 ;
    quan:unit "ms" .

ex:cond-latency
    a log:Condition ;
    ex:strictlySmaller ( ex:obs-latency-value ex:thr-latency ) .

ex:obs-latency
    ex:observed-metric-predicate ex:latency .

ex:obs-latency-value
    a quan:Quantity ;
    ex:observed-value-predicate ( ex:obs-latency ) .

ex:exp-bandwidth
    a icm:PropertyExpectation ;
    icm:target ex:tgt-bandwidth .

ex:tgt-bandwidth
    a icm:Target ;
    ex:metricPredicate ex:bandwidth ;
    icm:valuesOfTargetProperty ex:thr-bandwidth ;
    ex:thresholdPredicate ex:thr-bandwidth ;
    ex:statisticPredicate ex:guaranteed ;
    ex:scopePredicate ex:hub-to-all-spokes ;
    ex:methodPredicate ex:measured ;
    ex:windowPredicate ex:service-period .

ex:thr-bandwidth
    a quan:Quantity ;
    rdf:value 500 ;
    quan:unit "Mbps" .

ex:cond-bandwidth
    a log:Condition ;
    ex:atLeast ( ex:obs-bandwidth-value ex:thr-bandwidth ) .

ex:obs-bandwidth
    ex:observed-metric-predicate ex:bandwidth .

ex:obs-bandwidth-value
    a quan:Quantity ;
    ex:observed-value-predicate ( ex:obs-bandwidth ) .

ex:topology
    a icm:Context ;
    ex:hubPredicate ex:hub ;
    ex:spokePredicate ex:spoke-1 .

ex:hub
    rdfs:label "信義金融總部"@zh .

ex:spoke-1
    rdfs:label "交易室"@zh .