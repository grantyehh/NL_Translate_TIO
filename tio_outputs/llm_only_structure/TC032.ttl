@prefix ex: <http://example.org/tio-instance/tc032/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaIntent/> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix quan: <http://www.w3.org/2005/01/wf/flow#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:intent
  a icm:Intent, evsla:EnterpriseVpnSlaIntent ;
  icm:intentElements ex:exp-latency, ex:exp-bandwidth, ex:topology, ex:cond-latency, ex:cond-bandwidth ;
  rdfs:comment "Xinqiao Financial requires latency from Xinyi Financial Headquarters to all trading rooms to stay below 15 ms at the 99% level, and assured bandwidth to be no less than 500 Mbps."@en .

ex:exp-latency
  a icm:PropertyExpectation ;
  icm:target ex:tgt-latency ;
  evsla:serviceMetric evsla:OneWayLatency ;
  evsla:threshold ex:thr-latency ;
  evsla:statistic evsla:Percentile99 ;
  evsla:scope evsla:HubToAllSpokes ;
  evsla:measurementMethod evsla:ActiveMeasurement ;
  evsla:timeWindow evsla:DefaultTimeWindow .

ex:tgt-latency
  a icm:Target ;
  icm:valuesOfTargetProperty ex:thr-latency .

ex:thr-latency
  a quan:Quantity ;
  rdf:value 15 ;
  quan:unit "ms" .

ex:exp-bandwidth
  a icm:PropertyExpectation ;
  icm:target ex:tgt-bandwidth ;
  evsla:serviceMetric evsla:AssuredBandwidth ;
  evsla:threshold ex:thr-bandwidth ;
  evsla:statistic evsla:Minimum ;
  evsla:scope evsla:HubToAllSpokes ;
  evsla:measurementMethod evsla:ConfiguredBandwidth ;
  evsla:timeWindow evsla:DefaultTimeWindow .

ex:tgt-bandwidth
  a icm:Target ;
  icm:valuesOfTargetProperty ex:thr-bandwidth .

ex:thr-bandwidth
  a quan:Quantity ;
  rdf:value 500 ;
  quan:unit "Mbps" .

ex:cond-latency
  a log:Condition ;
  log:lessThan ( ex:obs-latency-value ex:thr-latency ) .

ex:obs-latency
  evsla:observedMetric evsla:OneWayLatency ;
  evsla:observedValue ( ex:obs-latency ) .

ex:obs-latency-value
  a quan:Quantity .

ex:cond-bandwidth
  a log:Condition ;
  log:notLessThan ( ex:obs-bandwidth-value ex:thr-bandwidth ) .

ex:obs-bandwidth
  evsla:observedMetric evsla:AssuredBandwidth ;
  evsla:observedValue ( ex:obs-bandwidth ) .

ex:obs-bandwidth-value
  a quan:Quantity .

ex:topology
  a icm:Context, evsla:HubAndSpokeTopology ;
  evsla:hasHub ex:hub ;
  evsla:hasSpoke ex:spoke-1 ;
  evsla:forTenant ex:tenant .

ex:tenant
  a evsla:EnterpriseTenant ;
  rdfs:label "鑫橋金融"@zh .

ex:hub
  a evsla:HubSite ;
  rdfs:label "信義金融總部"@zh .

ex:spoke-1
  a evsla:SpokeSite ;
  rdfs:label "交易室"@zh .