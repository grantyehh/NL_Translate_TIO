@prefix ex: <http://example.org/tio-instance/tc026/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix icm: <http://example.org/icm#> .
@prefix log: <http://example.org/log#> .
@prefix quan: <http://example.org/quan#> .

ex:intent
    a icm:Intent ;
    icm:intentElements ex:exp-hsinchu, ex:exp-kaohsiung, ex:topology, ex:cond-hsinchu, ex:cond-kaohsiung ;
    rdfs:comment "星河銀行要求台北總部到新竹分行延遲低於30ms、到高雄分行延遲低於60ms，皆以95% p95衡量。"@en .

ex:tenant
    rdfs:label "星河銀行"@zh .

ex:topology
    a icm:Context ;
    ex:forTenant ex:tenant ;
    ex:hubPredicate ex:hub-taipei ;
    ex:spokePredicate ex:spoke-hsinchu, ex:spoke-kaohsiung .

ex:hub-taipei
    rdfs:label "台北總部"@zh .

ex:spoke-hsinchu
    rdfs:label "新竹分行"@zh .

ex:spoke-kaohsiung
    rdfs:label "高雄分行"@zh .

ex:exp-hsinchu
    a icm:PropertyExpectation ;
    icm:target ex:tgt-hsinchu ;
    ex:metricPredicate ex:latency ;
    ex:thresholdPredicate ex:thr-hsinchu ;
    ex:statisticPredicate ex:p95 ;
    ex:scopePredicate ex:hubToSpoke ;
    ex:methodPredicate ex:defaultMethod ;
    ex:windowPredicate ex:defaultWindow .

ex:tgt-hsinchu
    a icm:Target ;
    icm:valuesOfTargetProperty ex:thr-hsinchu .

ex:thr-hsinchu
    a quan:Quantity ;
    rdf:value 30 ;
    quan:unit "ms" .

ex:cond-hsinchu
    a log:Condition ;
    ex:strictlySmallerThan ( ex:obs-hsinchu-value ex:thr-hsinchu ) .

ex:obs-hsinchu
    ex:observedMetricPredicate ex:latency .

ex:obs-hsinchu-value
    a quan:Quantity ;
    ex:observedValuePredicate ( ex:obs-hsinchu ) .

ex:exp-kaohsiung
    a icm:PropertyExpectation ;
    icm:target ex:tgt-kaohsiung ;
    ex:metricPredicate ex:latency ;
    ex:thresholdPredicate ex:thr-kaohsiung ;
    ex:statisticPredicate ex:p95 ;
    ex:scopePredicate ex:hubToSpoke ;
    ex:methodPredicate ex:defaultMethod ;
    ex:windowPredicate ex:defaultWindow .

ex:tgt-kaohsiung
    a icm:Target ;
    icm:valuesOfTargetProperty ex:thr-kaohsiung .

ex:thr-kaohsiung
    a quan:Quantity ;
    rdf:value 60 ;
    quan:unit "ms" .

ex:cond-kaohsiung
    a log:Condition ;
    ex:strictlySmallerThan ( ex:obs-kaohsiung-value ex:thr-kaohsiung ) .

ex:obs-kaohsiung
    ex:observedMetricPredicate ex:latency .

ex:obs-kaohsiung-value
    a quan:Quantity ;
    ex:observedValuePredicate ( ex:obs-kaohsiung ) .