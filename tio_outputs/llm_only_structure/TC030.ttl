@prefix ex: <http://example.org/tio-instance/tc030/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix icm: <http://example.org/icm#> .
@prefix quan: <http://example.org/quan#> .
@prefix log: <http://example.org/log#> .

ex:intent
  a icm:Intent ;
  icm:intentElements ex:exp-loss, ex:exp-bandwidth, ex:topology, ex:cond-loss, ex:cond-bandwidth ;
  rdfs:comment "Taipei hub to Tainan spoke packet loss rate below 0.01% for 99% of the time, and Taipei hub to Kaohsiung spoke guaranteed bandwidth at least 1000Mbps."@en .

ex:exp-loss
  a icm:PropertyExpectation ;
  icm:target ex:tgt-loss .

ex:tgt-loss
  a icm:Target ;
  ex:metricPredicate ex:packetLossRate ;
  icm:valuesOfTargetProperty ex:thr-loss ;
  ex:thresholdPredicate ex:thr-loss ;
  ex:statisticPredicate ex:percentile99 ;
  ex:scopePredicate ex:taipei-to-tainan ;
  ex:methodPredicate ex:guaranteed ;
  ex:windowPredicate ex:timeWindow99Percent .

ex:thr-loss
  a quan:Quantity ;
  rdf:value 0.01 ;
  quan:unit "%" .

ex:cond-loss
  a log:Condition ;
  ex:strictlySmallerThan ( ex:obs-loss-value ex:thr-loss ) .

ex:obs-loss
  ex:observedMetricPredicate ex:packetLossRate .

ex:obs-loss-value
  a quan:Quantity ;
  ex:observedValuePredicate ( ex:obs-loss ) .

ex:exp-bandwidth
  a icm:PropertyExpectation ;
  icm:target ex:tgt-bandwidth .

ex:tgt-bandwidth
  a icm:Target ;
  ex:metricPredicate ex:guaranteedBandwidth ;
  icm:valuesOfTargetProperty ex:thr-bandwidth ;
  ex:thresholdPredicate ex:thr-bandwidth ;
  ex:statisticPredicate ex:minimum ;
  ex:scopePredicate ex:taipei-to-kaohsiung ;
  ex:methodPredicate ex:guaranteed ;
  ex:windowPredicate ex:serviceWindow .

ex:thr-bandwidth
  a quan:Quantity ;
  rdf:value 1000 ;
  quan:unit "Mbps" .

ex:cond-bandwidth
  a log:Condition ;
  ex:greaterThanOrEqualTo ( ex:obs-bandwidth-value ex:thr-bandwidth ) .

ex:obs-bandwidth
  ex:observedMetricPredicate ex:guaranteedBandwidth .

ex:obs-bandwidth-value
  a quan:Quantity ;
  ex:observedValuePredicate ( ex:obs-bandwidth ) .

ex:topology
  a icm:Context ;
  ex:hubPredicate ex:taipei ;
  ex:spokePredicate ex:tainan, ex:kaohsiung .

ex:taipei
  rdfs:label "台北機房"@zh .

ex:tainan
  rdfs:label "台南機房"@zh .

ex:kaohsiung
  rdfs:label "高雄機房"@zh .

ex:taipei-to-tainan
  rdfs:label "台北機房到台南機房"@zh .

ex:taipei-to-kaohsiung
  rdfs:label "台北機房到高雄機房"@zh .