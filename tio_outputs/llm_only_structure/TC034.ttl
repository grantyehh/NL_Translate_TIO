@prefix ex: <http://example.org/tio-instance/tc034/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/Quantity/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:intent
    a icm:Intent ;
    icm:intentElements ex:exp-loss, ex:exp-bandwidth, ex:topology, ex:cond-loss, ex:cond-bandwidth ;
    rdfs:comment "Kaohsiung main plant to Tainan, Chiayi, and Pingtung spoke VPN SLA: packet loss rate below 0.02% for 99% of the time, and guaranteed bandwidth at least 200 Mbps."@en .

ex:exp-loss
    a icm:PropertyExpectation ;
    icm:target ex:tgt-loss .

ex:tgt-loss
    a icm:Target ;
    ex:metricPredicate ex:packetLossRate ;
    icm:valuesOfTargetProperty ex:thr-loss ;
    ex:thresholdPredicate ex:thr-loss ;
    ex:statisticPredicate ex:timeCoverage99 ;
    ex:scopePredicate ex:hubToAllSpokes ;
    ex:methodPredicate ex:measured ;
    ex:windowPredicate ex:serviceTime .

ex:thr-loss
    a quan:Quantity ;
    rdf:value 0.02 ;
    quan:unit "%" .

ex:cond-loss
    a log:Condition ;
    ex:strictlySmaller ( ex:obs-loss-value ex:thr-loss ) .

ex:obs-loss
    ex:observedMetricPredicate ex:packetLossRate .

ex:obs-loss-value
    a quan:Quantity ;
    ex:observedValuePredicate ( ex:obs-loss ) .

ex:exp-bandwidth
    a icm:PropertyExpectation ;
    icm:target ex:tgt-bandwidth .

ex:tgt-bandwidth
    a icm:Target ;
    ex:metricPredicate ex:guaranteedBandwidth ;
    icm:valuesOfTargetProperty ex:thr-bandwidth ;
    ex:thresholdPredicate ex:thr-bandwidth ;
    ex:statisticPredicate ex:minimum ;
    ex:scopePredicate ex:hubToAllSpokes ;
    ex:methodPredicate ex:guaranteed ;
    ex:windowPredicate ex:serviceTime .

ex:thr-bandwidth
    a quan:Quantity ;
    rdf:value 200 ;
    quan:unit "Mbps" .

ex:cond-bandwidth
    a log:Condition ;
    ex:atLeast ( ex:obs-bandwidth-value ex:thr-bandwidth ) .

ex:obs-bandwidth
    ex:observedMetricPredicate ex:guaranteedBandwidth .

ex:obs-bandwidth-value
    a quan:Quantity ;
    ex:observedValuePredicate ( ex:obs-bandwidth ) .

ex:topology
    a icm:Context ;
    ex:hubPredicate ex:hub ;
    ex:spokePredicate ex:spoke-tainan, ex:spoke-chiayi, ex:spoke-pingtung .

ex:hub
    rdfs:label "高雄電機總廠"@zh .

ex:spoke-tainan
    rdfs:label "台南廠"@zh .

ex:spoke-chiayi
    rdfs:label "嘉義廠"@zh .

ex:spoke-pingtung
    rdfs:label "屏東廠"@zh .