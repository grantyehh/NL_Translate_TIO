@prefix ex: <http://example.org/tio-instance/tc020/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/Quantity/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:intent
    a icm:Intent ;
    icm:intentElements ex:exp-latency, ex:exp-loss, ex:topology, ex:cond-latency, ex:cond-loss ;
    rdfs:comment "Ensure latency from the Taipei R&D headquarters hub to the Zhubei laboratory and Tainan manufacturing plant spokes stays below 35 ms for 95% of the time, and packet loss between the hub and each spoke stays below 0.05% for 99% of the time."@en .

ex:exp-latency
    a icm:PropertyExpectation ;
    icm:target ex:tgt-latency .

ex:tgt-latency
    a icm:Target ;
    ex:metricPredicate ex:latency ;
    icm:valuesOfTargetProperty ex:thr-latency ;
    ex:thresholdPredicate ex:thr-latency ;
    ex:statisticPredicate ex:p95 ;
    ex:scopePredicate ex:hub-to-all-spokes ;
    ex:methodPredicate ex:measurement-method ;
    ex:windowPredicate ex:time-window-95 .

ex:thr-latency
    a quan:Quantity ;
    rdf:value 35 ;
    quan:unit "ms" .

ex:exp-loss
    a icm:PropertyExpectation ;
    icm:target ex:tgt-loss .

ex:tgt-loss
    a icm:Target ;
    ex:metricPredicate ex:packet-loss-rate ;
    icm:valuesOfTargetProperty ex:thr-loss ;
    ex:thresholdPredicate ex:thr-loss ;
    ex:statisticPredicate ex:p99 ;
    ex:scopePredicate ex:hub-to-all-spokes ;
    ex:methodPredicate ex:measurement-method ;
    ex:windowPredicate ex:time-window-99 .

ex:thr-loss
    a quan:Quantity ;
    rdf:value 0.05 ;
    quan:unit "%" .

ex:cond-latency
    a log:Condition ;
    ex:strictly-smallerThan ( ex:obs-latency-value ex:thr-latency ) .

ex:obs-latency
    ex:observed-metric-predicate ex:latency ;
    ex:observed-value-predicate ( ex:obs-latency ) .

ex:obs-latency-value
    a quan:Quantity .

ex:cond-loss
    a log:Condition ;
    ex:strictly-smallerThan ( ex:obs-loss-value ex:thr-loss ) .

ex:obs-loss
    ex:observed-metric-predicate ex:packet-loss-rate ;
    ex:observed-value-predicate ( ex:obs-loss ) .

ex:obs-loss-value
    a quan:Quantity .

ex:topology
    a icm:Context ;
    ex:hubPredicate [
        rdfs:label "精準醫材台北研發總部"@zh
    ] ;
    ex:spokePredicate [
        rdfs:label "竹北實驗室"@zh
    ] ;
    ex:spokePredicate [
        rdfs:label "台南製造廠"@zh
    ] .