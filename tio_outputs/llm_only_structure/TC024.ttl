@prefix ex: <http://example.org/tio-instance/tc024/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/Quantity/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:intent
    a icm:Intent ;
    icm:intentElements ex:exp-latency, ex:topology, ex:cond-latency ;
    rdfs:comment "Enterprise VPN hub-to-spokes SLA requiring latency below 70 ms at the 95th percentile for each spoke."@en .

ex:exp-latency
    a icm:PropertyExpectation ;
    icm:target ex:tgt-latency .

ex:tgt-latency
    a icm:Target ;
    icm:valuesOfTargetProperty ex:thr-latency .

ex:thr-latency
    a quan:Quantity ;
    rdf:value 70 ;
    quan:unit "ms" .

ex:cond-latency
    a log:Condition .

ex:topology
    a icm:Context ;
    ex:hubSite ex:hub ;
    ex:spokeSite ex:spoke-1, ex:spoke-2, ex:spoke-3 .

ex:hub
    rdfs:label "嘉義農業資訊中心"@zh .

ex:spoke-1
    rdfs:label "新營農場"@zh .

ex:spoke-2
    rdfs:label "麻豆農場"@zh .

ex:spoke-3
    rdfs:label "玉井農場"@zh .

ex:tenant
    rdfs:label "豐茂農業"@zh .