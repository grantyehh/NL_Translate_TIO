@prefix ex: <http://example.org/tio-instance/tc025/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix quan: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:intent
    a icm:Intent ;
    icm:intentElements ex:exp-packet-loss, ex:topology, ex:cond-packet-loss ;
    rdfs:comment "德豐物流要求高雄物流中心到屏東配送站與台東配送站，每個分點各自的封包遺失率在95%時間內低於0.2%。"@en .

ex:exp-packet-loss
    a icm:PropertyExpectation ;
    icm:target ex:tgt-packet-loss ;
    ex:metricPredicate ex:packetLossRate ;
    ex:thresholdPredicate ex:thr-packet-loss ;
    ex:statisticPredicate ex:p95 ;
    ex:scopePredicate ex:perSpoke ;
    ex:methodPredicate ex:defaultMeasurementMethod ;
    ex:windowPredicate ex:defaultTimeWindow .

ex:tgt-packet-loss
    a icm:Target ;
    icm:valuesOfTargetProperty ex:thr-packet-loss .

ex:thr-packet-loss
    a quan:Quantity ;
    rdf:value 0.2 ;
    quan:unit "%" .

ex:cond-packet-loss
    a log:Condition ;
    ex:strictlySmaller ( ex:obs-packet-loss-value ex:thr-packet-loss ) .

ex:obs-packet-loss
    ex:observedMetricPredicate ex:packetLossRate .

ex:obs-packet-loss-value
    a quan:Quantity ;
    ex:observedValuePredicate ( ex:obs-packet-loss ) .

ex:topology
    a icm:Context ;
    ex:hubPredicate ex:hub-kaohsiung ;
    ex:spokePredicate ex:spoke-pingtung, ex:spoke-taitung ;
    ex:forTenant ex:tenant .

ex:tenant
    a ex:Tenant ;
    rdfs:label "德豐物流"@zh .

ex:hub-kaohsiung
    a ex:HubSite ;
    rdfs:label "高雄物流中心"@zh .

ex:spoke-pingtung
    a ex:SpokeSite ;
    rdfs:label "屏東配送站"@zh .

ex:spoke-taitung
    a ex:SpokeSite ;
    rdfs:label "台東配送站"@zh .