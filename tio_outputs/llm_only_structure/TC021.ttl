@prefix ex: <http://example.org/tio-instance/tc021/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix quan: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix evsla: <http://example.org/evsla#> .

ex:intent
    a icm:Intent, evsla:EnterpriseVpnSlaIntent ;
    icm:intentElements ex:exp-latency, ex:topology, ex:cond-latency ;
    rdfs:comment "宏遠科技要求台北總部到桃園廠與台南廠各分點延遲在95%時間內低於40ms。"@en .

ex:exp-latency
    a icm:PropertyExpectation ;
    icm:target ex:tgt-latency ;
    evsla:metric evsla:OneWayDelay ;
    evsla:threshold ex:thr-latency ;
    evsla:statistic evsla:Percentile95 ;
    evsla:scope evsla:PerSpoke ;
    evsla:measurementMethod evsla:DefaultActiveMeasurement ;
    evsla:timeWindow evsla:DefaultTimeWindow .

ex:tgt-latency
    a icm:Target ;
    icm:valuesOfTargetProperty ex:thr-latency .

ex:thr-latency
    a quan:Quantity ;
    rdf:value 40 ;
    quan:unit evsla:Millisecond .

ex:cond-latency
    a log:Condition ;
    evsla:StrictlySmaller ( ex:obs-latency-value ex:thr-latency ) .

ex:obs-latency
    evsla:observedMetric evsla:OneWayDelay .

ex:obs-latency-value
    a quan:Quantity ;
    evsla:observedValueOf ( ex:obs-latency ) .

ex:topology
    a icm:Context, evsla:HubAndSpokeTopology ;
    evsla:forTenant ex:tenant ;
    evsla:hasHub ex:hub-taipei ;
    evsla:hasSpoke ex:spoke-taoyuan, ex:spoke-tainan .

ex:tenant
    a evsla:EnterpriseTenant ;
    rdfs:label "宏遠科技"@zh .

ex:hub-taipei
    a evsla:HubSite ;
    rdfs:label "台北總部"@zh .

ex:spoke-taoyuan
    a evsla:SpokeSite ;
    rdfs:label "桃園廠"@zh .

ex:spoke-tainan
    a evsla:SpokeSite ;
    rdfs:label "台南廠"@zh .