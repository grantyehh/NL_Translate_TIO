@prefix ex: <http://example.org/tio-instance/tc033/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaIntent/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/Quantity/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:intent
  a icm:Intent, evsla:EnterpriseVpnSlaIntent ;
  icm:intentElements ex:exp-delay, ex:exp-loss, ex:exp-bandwidth, ex:topology, ex:cond-delay, ex:cond-loss, ex:cond-bandwidth ;
  rdfs:comment "Hongxu Pharmaceutical requires hub-to-all-spokes delay below 50 ms at 95% time, packet loss rate below 0.1% at 99% time, and assured bandwidth no less than 100 Mbps."@en .

ex:exp-delay
  a icm:PropertyExpectation ;
  icm:target ex:tgt-delay ;
  evsla:serviceMetric evsla:OneWayDelay ;
  evsla:threshold ex:thr-delay ;
  evsla:statistic evsla:Percentile95 ;
  evsla:scope evsla:HubToAllSpokes ;
  evsla:measurementMethod evsla:ActiveMeasurement ;
  evsla:timeWindow evsla:DefaultTimeWindow .

ex:tgt-delay
  a icm:Target ;
  icm:valuesOfTargetProperty ex:thr-delay .

ex:thr-delay
  a quan:Quantity ;
  rdf:value 50 ;
  quan:unit "ms" .

ex:cond-delay
  a log:Condition ;
  log:StrictlySmaller ( ex:obs-delay-value ex:thr-delay ) .

ex:obs-delay
  evsla:observedMetric evsla:OneWayDelay .

ex:obs-delay-value
  a quan:Quantity ;
  evsla:observedValueOf ( ex:obs-delay ) .

ex:exp-loss
  a icm:PropertyExpectation ;
  icm:target ex:tgt-loss ;
  evsla:serviceMetric evsla:PacketLossRate ;
  evsla:threshold ex:thr-loss ;
  evsla:statistic evsla:Percentile99 ;
  evsla:scope evsla:HubToAllSpokes ;
  evsla:measurementMethod evsla:ActiveMeasurement ;
  evsla:timeWindow evsla:DefaultTimeWindow .

ex:tgt-loss
  a icm:Target ;
  icm:valuesOfTargetProperty ex:thr-loss .

ex:thr-loss
  a quan:Quantity ;
  rdf:value 0.1 ;
  quan:unit "%" .

ex:cond-loss
  a log:Condition ;
  log:StrictlySmaller ( ex:obs-loss-value ex:thr-loss ) .

ex:obs-loss
  evsla:observedMetric evsla:PacketLossRate .

ex:obs-loss-value
  a quan:Quantity ;
  evsla:observedValueOf ( ex:obs-loss ) .

ex:exp-bandwidth
  a icm:PropertyExpectation ;
  icm:target ex:tgt-bandwidth ;
  evsla:serviceMetric evsla:AssuredBandwidth ;
  evsla:threshold ex:thr-bandwidth ;
  evsla:statistic evsla:Minimum ;
  evsla:scope evsla:HubToAllSpokes ;
  evsla:measurementMethod evsla:PassiveMeasurement ;
  evsla:timeWindow evsla:DefaultTimeWindow .

ex:tgt-bandwidth
  a icm:Target ;
  icm:valuesOfTargetProperty ex:thr-bandwidth .

ex:thr-bandwidth
  a quan:Quantity ;
  rdf:value 100 ;
  quan:unit "Mbps" .

ex:cond-bandwidth
  a log:Condition ;
  log:AtLeast ( ex:obs-bandwidth-value ex:thr-bandwidth ) .

ex:obs-bandwidth
  evsla:observedMetric evsla:AssuredBandwidth .

ex:obs-bandwidth-value
  a quan:Quantity ;
  evsla:observedValueOf ( ex:obs-bandwidth ) .

ex:topology
  a icm:Context, evsla:HubAndSpokeTopology ;
  evsla:forTenant ex:tenant ;
  evsla:hasHub ex:hub ;
  evsla:hasSpoke ex:spoke-1 .

ex:tenant
  a evsla:EnterpriseTenant ;
  rdfs:label "鴻旭製藥"@zh .

ex:hub
  a evsla:HubSite ;
  rdfs:label "台中藥廠總部"@zh .

ex:spoke-1
  a evsla:SpokeSite ;
  rdfs:label "所有分點"@zh .