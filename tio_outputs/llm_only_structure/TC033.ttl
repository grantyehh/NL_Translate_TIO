@prefix ex: <http://example.org/tio-instance/tc033/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix icm: <http://example.org/icm#> .
@prefix log: <http://example.org/log#> .
@prefix quan: <http://example.org/quan#> .

ex:intent
    a icm:Intent ;
    icm:intentElements ex:exp-delay, ex:exp-loss, ex:exp-bandwidth, ex:topology, ex:cond-delay, ex:cond-loss, ex:cond-bandwidth ;
    rdfs:comment "Hung Hsu Pharmaceutical requires hub-to-all-spokes latency below 50 ms for 95% of the time, packet loss rate below 0.1% for 99% of the time, and guaranteed bandwidth of at least 100 Mbps."@en .

ex:exp-delay
    a icm:PropertyExpectation ;
    icm:target ex:tgt-delay .

ex:tgt-delay
    a icm:Target ;
    ex:metricPredicate ex:Latency ;
    icm:valuesOfTargetProperty ex:thr-delay ;
    ex:thresholdPredicate ex:thr-delay ;
    ex:statisticPredicate ex:Percentile95 ;
    ex:scopePredicate ex:HubToAllSpokes ;
    ex:methodPredicate ex:Measured ;
    ex:windowPredicate ex:TimeWindow95 .

ex:thr-delay
    a quan:Quantity ;
    rdf:value 50 ;
    quan:unit "ms" .

ex:cond-delay
    a log:Condition ;
    ex:strictlySmallerThan ( ex:obs-delay-value ex:thr-delay ) .

ex:obs-delay
    ex:observedMetricPredicate ex:Latency .

ex:obs-delay-value
    a quan:Quantity ;
    ex:observedValuePredicate ( ex:obs-delay ) .

ex:exp-loss
    a icm:PropertyExpectation ;
    icm:target ex:tgt-loss .

ex:tgt-loss
    a icm:Target ;
    ex:metricPredicate ex:PacketLossRate ;
    icm:valuesOfTargetProperty ex:thr-loss ;
    ex:thresholdPredicate ex:thr-loss ;
    ex:statisticPredicate ex:Percentile99 ;
    ex:scopePredicate ex:HubToAllSpokes ;
    ex:methodPredicate ex:Measured ;
    ex:windowPredicate ex:TimeWindow99 .

ex:thr-loss
    a quan:Quantity ;
    rdf:value 0.1 ;
    quan:unit "%" .

ex:cond-loss
    a log:Condition ;
    ex:strictlySmallerThan ( ex:obs-loss-value ex:thr-loss ) .

ex:obs-loss
    ex:observedMetricPredicate ex:PacketLossRate .

ex:obs-loss-value
    a quan:Quantity ;
    ex:observedValuePredicate ( ex:obs-loss ) .

ex:exp-bandwidth
    a icm:PropertyExpectation ;
    icm:target ex:tgt-bandwidth .

ex:tgt-bandwidth
    a icm:Target ;
    ex:metricPredicate ex:GuaranteedBandwidth ;
    icm:valuesOfTargetProperty ex:thr-bandwidth ;
    ex:thresholdPredicate ex:thr-bandwidth ;
    ex:statisticPredicate ex:Minimum ;
    ex:scopePredicate ex:HubToAllSpokes ;
    ex:methodPredicate ex:Guaranteed ;
    ex:windowPredicate ex:Always .

ex:thr-bandwidth
    a quan:Quantity ;
    rdf:value 100 ;
    quan:unit "Mbps" .

ex:cond-bandwidth
    a log:Condition ;
    ex:atLeast ( ex:obs-bandwidth-value ex:thr-bandwidth ) .

ex:obs-bandwidth
    ex:observedMetricPredicate ex:GuaranteedBandwidth .

ex:obs-bandwidth-value
    a quan:Quantity ;
    ex:observedValuePredicate ( ex:obs-bandwidth ) .

ex:topology
    a icm:Context ;
    ex:hubPredicate ex:hub ;
    ex:spokePredicate ex:spoke-1, ex:spoke-2, ex:spoke-3 .

ex:hub
    rdfs:label "台中藥廠總部"@zh .

ex:spoke-1
    rdfs:label "分點1"@zh .

ex:spoke-2
    rdfs:label "分點2"@zh .

ex:spoke-3
    rdfs:label "分點3"@zh .