@prefix ex: <http://example.org/tio-instance/tc028/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityAndUnits/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:intent
    a icm:Intent ;
    icm:intentElements ex:exp-taichung, ex:exp-kaohsiung, ex:topology, ex:cond-bandwidth-taichung, ex:cond-bandwidth-kaohsiung ;
    rdfs:comment "Hub-and-spoke VPN SLA intent requiring bandwidth of at least 200 Mbps from Hsinchu headquarters to Taichung R&D Center and at least 100 Mbps from Hsinchu headquarters to Kaohsiung Test Center."@en .

ex:exp-taichung
    a icm:PropertyExpectation ;
    icm:target ex:tgt-taichung .

ex:tgt-taichung
    a icm:Target ;
    ex:metricPredicate ex:bandwidth ;
    icm:valuesOfTargetProperty ex:thr-bandwidth-taichung ;
    ex:thresholdPredicate ex:thr-bandwidth-taichung ;
    ex:scopePredicate ex:hsinchu-to-taichung .

ex:thr-bandwidth-taichung
    a quan:Quantity ;
    rdf:value 200 ;
    quan:unit "Mbps" .

ex:exp-kaohsiung
    a icm:PropertyExpectation ;
    icm:target ex:tgt-kaohsiung .

ex:tgt-kaohsiung
    a icm:Target ;
    ex:metricPredicate ex:bandwidth ;
    icm:valuesOfTargetProperty ex:thr-bandwidth-kaohsiung ;
    ex:thresholdPredicate ex:thr-bandwidth-kaohsiung ;
    ex:scopePredicate ex:hsinchu-to-kaohsiung .

ex:thr-bandwidth-kaohsiung
    a quan:Quantity ;
    rdf:value 100 ;
    quan:unit "Mbps" .

ex:cond-bandwidth-taichung
    a log:Condition ;
    ex:atLeastOperator ( ex:obs-bandwidth-taichung-value ex:thr-bandwidth-taichung ) .

ex:obs-bandwidth-taichung
    ex:observed-metric-predicate ex:bandwidth ;
    ex:observed-value-predicate ( ex:obs-bandwidth-taichung ) .

ex:obs-bandwidth-taichung-value
    a quan:Quantity .

ex:cond-bandwidth-kaohsiung
    a log:Condition ;
    ex:atLeastOperator ( ex:obs-bandwidth-kaohsiung-value ex:thr-bandwidth-kaohsiung ) .

ex:obs-bandwidth-kaohsiung
    ex:observed-metric-predicate ex:bandwidth ;
    ex:observed-value-predicate ( ex:obs-bandwidth-kaohsiung ) .

ex:obs-bandwidth-kaohsiung-value
    a quan:Quantity .

ex:topology
    a icm:Context ;
    ex:hubPredicate [ rdfs:label "新竹總部"@zh ] ;
    ex:spokePredicate [ rdfs:label "台中研發中心"@zh ] ;
    ex:spokePredicate [ rdfs:label "高雄測試中心"@zh ] .