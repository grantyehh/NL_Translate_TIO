@prefix ex: <http://example.org/tio-instance/tc003/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix quan: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix evsla: <http://example.org/evsla#> .

ex:intent
    a icm:Intent, evsla:EnterpriseVpnSlaIntent ;
    icm:intentElements ex:exp-bandwidth, ex:topology, ex:cond-bandwidth ;
    rdfs:comment "宏海物流 tenant requires guaranteed bandwidth of at least 100 Mbps from headquarters to Kaohsiung warehouse center."@en .

ex:service
    evsla:forTenant ex:tenant .

ex:tenant
    a evsla:Tenant ;
    rdfs:label "宏海物流"@zh .

ex:exp-bandwidth
    a icm:PropertyExpectation ;
    icm:target ex:tgt-bandwidth ;
    evsla:serviceMetric evsla:GuaranteedBandwidth ;
    evsla:threshold ex:thr-bandwidth ;
    evsla:statistic evsla:Minimum ;
    evsla:scope evsla:HubToSpoke ;
    evsla:measurementMethod evsla:ActiveMeasurement ;
    evsla:timeWindow evsla:DefaultTimeWindow .

ex:tgt-bandwidth
    a icm:Target ;
    icm:valuesOfTargetProperty ex:thr-bandwidth .

ex:thr-bandwidth
    a quan:Quantity ;
    rdf:value 100 ;
    quan:unit "Mbps" .

ex:cond-bandwidth
    a log:Condition ;
    log:atLeast ( ex:obs-bandwidth-value ex:thr-bandwidth ) .

ex:obs-bandwidth
    evsla:observedMetric evsla:GuaranteedBandwidth ;
    evsla:observedValue ex:obs-bandwidth-value .

ex:obs-bandwidth-value
    a quan:Quantity .

ex:topology
    a icm:Context, evsla:HubAndSpokeTopology ;
    evsla:hasHub ex:hub ;
    evsla:hasSpoke ex:spoke-1 .

ex:hub
    a evsla:HubSite ;
    rdfs:label "總部"@zh .

ex:spoke-1
    a evsla:SpokeSite ;
    rdfs:label "高雄倉儲中心"@zh .