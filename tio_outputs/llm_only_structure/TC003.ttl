@prefix ex: <http://example.org/tio-instance/tc003/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix icm: <http://example.org/icm#> .
@prefix log: <http://example.org/log#> .
@prefix quan: <http://example.org/quan#> .

ex:intent
    a icm:Intent ;
    icm:intentElements ex:exp-bandwidth, ex:topology, ex:cond-bandwidth ;
    rdfs:comment "Provide guaranteed bandwidth of at least 100 Mbps from Honghai Logistics headquarters to Kaohsiung Warehouse Center."@en .

ex:exp-bandwidth
    a icm:PropertyExpectation ;
    icm:target ex:tgt-bandwidth .

ex:tgt-bandwidth
    a icm:Target ;
    ex:metricPredicate ex:GuaranteedBandwidth ;
    icm:valuesOfTargetProperty ex:thr-bandwidth ;
    ex:thresholdPredicate ex:thr-bandwidth ;
    ex:statisticPredicate ex:Minimum ;
    ex:scopePredicate ex:HubToSpoke ;
    ex:methodPredicate ex:Guaranteed ;
    ex:windowPredicate ex:ServicePeriod .

ex:thr-bandwidth
    a quan:Quantity ;
    rdf:value 100 ;
    quan:unit "Mbps" .

ex:cond-bandwidth
    a log:Condition ;
    ex:atLeastOperator ( ex:obs-bandwidth-value ex:thr-bandwidth ) .

ex:obs-bandwidth
    ex:observedMetricPredicate ex:GuaranteedBandwidth .

ex:obs-bandwidth-value
    a quan:Quantity ;
    ex:observedValuePredicate ( ex:obs-bandwidth ) .

ex:topology
    a icm:Context ;
    ex:hubPredicate ex:hub ;
    ex:spokePredicate ex:spoke-1 .

ex:hub
    rdfs:label "宏海物流總部"@zh .

ex:spoke-1
    rdfs:label "高雄倉儲中心"@zh .