@prefix ex: <http://example.org/tio-instance/tc039/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaIntent/> .
@prefix quan: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:intent
    a icm:Intent, evsla:EnterpriseVpnSlaIntent ;
    icm:intentElements ex:exp-delay, ex:topology, ex:cond-delay ;
    rdfs:comment "Monthly SLA window average latency from Taichung industrial headquarters to six factory branch sites must stay below 80 ms."@en .

ex:exp-delay
    a icm:PropertyExpectation ;
    icm:target ex:tgt-delay ;
    evsla:latencyMetric evsla:OneWayLatency ;
    evsla:latencyThreshold ex:thr-delay ;
    evsla:statistic evsla:Average ;
    evsla:scope evsla:HubToAllSpokes ;
    evsla:measurementMethod evsla:ActiveMeasurement ;
    evsla:timeWindow evsla:MonthlyWindow .

ex:tgt-delay
    a icm:Target ;
    icm:valuesOfTargetProperty ex:thr-delay .

ex:thr-delay
    a quan:Quantity ;
    rdf:value 80 ;
    quan:unit unit:MilliSEC .

ex:cond-delay
    a log:Condition ;
    log:lessThan ( ex:obs-delay-value ex:thr-delay ) .

ex:obs-delay
    evsla:observedLatencyMetric evsla:OneWayLatency ;
    evsla:observedValue ex:obs-delay-value .

ex:obs-delay-value
    a quan:Quantity .

ex:topology
    a icm:Context, evsla:HubAndSpokeTopology ;
    evsla:forTenant ex:tenant ;
    evsla:hubSite ex:hub ;
    evsla:spokeSite ex:spoke-1, ex:spoke-2, ex:spoke-3, ex:spoke-4, ex:spoke-5, ex:spoke-6 .

ex:tenant
    a evsla:EnterpriseTenant ;
    rdfs:label "中台工業集團"@zh .

ex:hub
    a evsla:HubSite ;
    rdfs:label "台中工業總部"@zh .

ex:spoke-1
    a evsla:SpokeSite ;
    rdfs:label "廠區分點一"@zh .

ex:spoke-2
    a evsla:SpokeSite ;
    rdfs:label "廠區分點二"@zh .

ex:spoke-3
    a evsla:SpokeSite ;
    rdfs:label "廠區分點三"@zh .

ex:spoke-4
    a evsla:SpokeSite ;
    rdfs:label "廠區分點四"@zh .

ex:spoke-5
    a evsla:SpokeSite ;
    rdfs:label "廠區分點五"@zh .

ex:spoke-6
    a evsla:SpokeSite ;
    rdfs:label "廠區分點六"@zh .