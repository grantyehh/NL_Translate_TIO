@prefix ex: <http://example.org/tio-instance/tc029/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/Quantity/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:intent
    a icm:Intent ;
    icm:intentElements ex:exp-banqiao, ex:exp-xizhi, ex:exp-sanchong, ex:topology, ex:cond-banqiao, ex:cond-xizhi, ex:cond-sanchong ;
    rdfs:comment "Federal Hospital requires latency from Taipei Medical Information Center to Banqiao Campus to stay below 10 ms at the 99th-percentile level, and latency to Xizhi Campus and Sanchong Campus to stay below 25 ms at the 95th-percentile level."@en .

ex:exp-banqiao
    a icm:PropertyExpectation ;
    icm:target ex:tgt-banqiao ;
    ex:metricPredicate ex:latency ;
    ex:thresholdPredicate ex:thr-banqiao ;
    ex:statisticPredicate ex:p99 ;
    ex:scopePredicate ex:hub-to-banqiao ;
    ex:methodPredicate ex:default-method ;
    ex:windowPredicate ex:default-window .

ex:tgt-banqiao
    a icm:Target ;
    icm:valuesOfTargetProperty ex:thr-banqiao .

ex:thr-banqiao
    a quan:Quantity ;
    rdf:value 10 ;
    quan:unit "ms" .

ex:exp-xizhi
    a icm:PropertyExpectation ;
    icm:target ex:tgt-xizhi ;
    ex:metricPredicate ex:latency ;
    ex:thresholdPredicate ex:thr-xizhi ;
    ex:statisticPredicate ex:p95 ;
    ex:scopePredicate ex:hub-to-xizhi ;
    ex:methodPredicate ex:default-method ;
    ex:windowPredicate ex:default-window .

ex:tgt-xizhi
    a icm:Target ;
    icm:valuesOfTargetProperty ex:thr-xizhi .

ex:thr-xizhi
    a quan:Quantity ;
    rdf:value 25 ;
    quan:unit "ms" .

ex:exp-sanchong
    a icm:PropertyExpectation ;
    icm:target ex:tgt-sanchong ;
    ex:metricPredicate ex:latency ;
    ex:thresholdPredicate ex:thr-sanchong ;
    ex:statisticPredicate ex:p95 ;
    ex:scopePredicate ex:hub-to-sanchong ;
    ex:methodPredicate ex:default-method ;
    ex:windowPredicate ex:default-window .

ex:tgt-sanchong
    a icm:Target ;
    icm:valuesOfTargetProperty ex:thr-sanchong .

ex:thr-sanchong
    a quan:Quantity ;
    rdf:value 25 ;
    quan:unit "ms" .

ex:cond-banqiao
    a log:Condition ;
    ex:strictly-smaller ( ex:obs-banqiao-value ex:thr-banqiao ) .

ex:obs-banqiao
    ex:observed-metric-predicate ex:latency ;
    ex:obs-banqiao-value a quan:Quantity ;
    ex:observed-value-predicate ( ex:obs-banqiao ) .

ex:cond-xizhi
    a log:Condition ;
    ex:strictly-smaller ( ex:obs-xizhi-value ex:thr-xizhi ) .

ex:obs-xizhi
    ex:observed-metric-predicate ex:latency ;
    ex:obs-xizhi-value a quan:Quantity ;
    ex:observed-value-predicate ( ex:obs-xizhi ) .

ex:cond-sanchong
    a log:Condition ;
    ex:strictly-smaller ( ex:obs-sanchong-value ex:thr-sanchong ) .

ex:obs-sanchong
    ex:observed-metric-predicate ex:latency ;
    ex:obs-sanchong-value a quan:Quantity ;
    ex:observed-value-predicate ( ex:obs-sanchong ) .

ex:topology
    a icm:Context ;
    ex:hubPredicate ex:hub ;
    ex:spokePredicate ex:banqiao, ex:xizhi, ex:sanchong .

ex:hub
    rdfs:label "台北醫療資訊中心"@zh .

ex:banqiao
    rdfs:label "板橋院區"@zh .

ex:xizhi
    rdfs:label "汐止院區"@zh .

ex:sanchong
    rdfs:label "三重院區"@zh .