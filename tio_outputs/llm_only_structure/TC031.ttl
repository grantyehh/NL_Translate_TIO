@prefix ex: <http://example.org/tio-instance/tc031/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/Quantity/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:intent
    a icm:Intent ;
    icm:intentElements ex:exp-latency, ex:exp-packet-loss, ex:topology, ex:cond-latency, ex:cond-packet-loss ;
    rdfs:comment "映盛科技要求台北數據中心至所有分點的延遲在95%時間內低於30ms，且封包遺失率在99%時間內低於0.05%。"@en .

ex:exp-latency
    a icm:PropertyExpectation ;
    icm:target ex:tgt-latency .

ex:tgt-latency
    a icm:Target ;
    icm:valuesOfTargetProperty ex:thr-latency .

ex:thr-latency
    a quan:Quantity ;
    rdf:value 30 .

ex:exp-packet-loss
    a icm:PropertyExpectation ;
    icm:target ex:tgt-packet-loss .

ex:tgt-packet-loss
    a icm:Target ;
    icm:valuesOfTargetProperty ex:thr-packet-loss .

ex:thr-packet-loss
    a quan:Quantity ;
    rdf:value 0.05 .

ex:cond-latency
    a log:Condition .

ex:obs-latency-value
    a quan:Quantity .

ex:cond-packet-loss
    a log:Condition .

ex:obs-packet-loss-value
    a quan:Quantity .

ex:topology
    a icm:Context ;
    rdfs:label "台北數據中心至所有分點"@zh .