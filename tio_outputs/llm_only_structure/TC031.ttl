@prefix ex: <http://example.org/tio-instance/tc031/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix icm: <http://example.org/icm#> .
@prefix log: <http://example.org/log#> .
@prefix quan: <http://example.org/quan#> .

ex:intent
    a icm:Intent ;
    icm:intentElements ex:exp-latency, ex:exp-loss, ex:topology, ex:cond-latency, ex:cond-loss ;
    rdfs:comment "Yingsheng Technology requires latency from the Taipei data center to all branches to stay below 30 ms for 95% of the time, and packet loss rate to stay below 0.05% for 99% of the time."@en .

ex:exp-latency
    a icm:PropertyExpectation ;
    icm:target ex:tgt-latency .

ex:tgt-latency
    a icm:Target ;
    ex:metricPredicate ex:latency ;
    icm:valuesOfTargetProperty ex:thr-latency ;
    ex:thresholdPredicate ex:thr-latency ;
    ex:statisticPredicate ex:p95 ;
    ex:scopePredicate ex:hub-to-all-spokes ;
    ex:methodPredicate ex:measurement-method ;
    ex:windowPredicate ex:time-window .

ex:thr-latency
    a quan:Quantity ;
    rdf:value 30 ;
    quan:unit "ms" .

ex:cond-latency
    a log:Condition ;
    ex:strictly-smallerThan ( ex:obs-latency-value ex:thr-latency ) .

ex:obs-latency
    ex:observed-metric-predicate ex:latency ;
    ex:obs-latency-value a quan:Quantity ;
    ex:observed-value-predicate ( ex:obs-latency ) .

ex:exp-loss
    a icm:PropertyExpectation ;
    icm:target ex:tgt-loss .

ex:tgt-loss
    a icm:Target ;
    ex:metricPredicate ex:packet-loss-rate ;
    icm:valuesOfTargetProperty ex:thr-loss ;
    ex:thresholdPredicate ex:thr-loss ;
    ex:statisticPredicate ex:p99 ;
    ex:scopePredicate ex:hub-to-all-spokes ;
    ex:methodPredicate ex:measurement-method ;
    ex:windowPredicate ex:time-window .

ex:thr-loss
    a quan:Quantity ;
    rdf:value 0.05 ;
    quan:unit "%" .

ex:cond-loss
    a log:Condition ;
    ex:strictly-smallerThan ( ex:obs-loss-value ex:thr-loss ) .

ex:obs-loss
    ex:observed-metric-predicate ex:packet-loss-rate ;
    ex:obs-loss-value a quan:Quantity ;
    ex:observed-value-predicate ( ex:obs-loss ) .

ex:topology
    a icm:Context ;
    ex:hubPredicate ex:hub-taipei-dc ;
    ex:spokePredicate ex:spoke-1, ex:spoke-2, ex:spoke-3 .

ex:hub-taipei-dc
    rdfs:label "台北數據中心"@zh .

ex:spoke-1
    rdfs:label "分點1"@zh .

ex:spoke-2
    rdfs:label "分點2"@zh .

ex:spoke-3
    rdfs:label "分點3"@zh .