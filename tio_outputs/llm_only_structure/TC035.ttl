@prefix ex: <http://example.org/tio-instance/tc035/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/Quantity/> .

ex:intent
    a icm:Intent ;
    icm:intentElements ex:exp-latency, ex:exp-bandwidth, ex:topology, ex:cond-latency, ex:cond-bandwidth ;
    rdfs:comment "Enterprise VPN hub-and-spoke SLA intent for tenant 泰盛航太: latency below 25 ms at 95% level and bandwidth at least 300 Mbps from 桃園航太製造總部 to 台中零件廠 and 高雄組裝廠."@en .

ex:exp-latency
    a icm:PropertyExpectation ;
    icm:target ex:tgt-latency ;
    ex:metricPredicate ex:latencyMetric ;
    ex:thresholdPredicate ex:thr-latency ;
    ex:statisticPredicate ex:p95 ;
    ex:scopePredicate ex:hubToAllSpokes ;
    ex:methodPredicate ex:defaultMethod ;
    ex:windowPredicate ex:defaultWindow .

ex:tgt-latency
    a icm:Target ;
    icm:valuesOfTargetProperty ex:thr-latency .

ex:thr-latency
    a quan:Quantity ;
    rdf:value 25 ;
    quan:unit "ms" .

ex:exp-bandwidth
    a icm:PropertyExpectation ;
    icm:target ex:tgt-bandwidth ;
    ex:metricPredicate ex:bandwidthMetric ;
    ex:thresholdPredicate ex:thr-bandwidth ;
    ex:statisticPredicate ex:defaultStatistic ;
    ex:scopePredicate ex:hubToAllSpokes ;
    ex:methodPredicate ex:defaultMethod ;
    ex:windowPredicate ex:defaultWindow .

ex:tgt-bandwidth
    a icm:Target ;
    icm:valuesOfTargetProperty ex:thr-bandwidth .

ex:thr-bandwidth
    a quan:Quantity ;
    rdf:value 300 ;
    quan:unit "Mbps" .

ex:cond-latency
    a log:Condition ;
    ex:strictlySmaller ( ex:obs-latency-value ex:thr-latency ) .

ex:obs-latency
    ex:observedMetricPredicate ex:latencyMetric .

ex:obs-latency-value
    a quan:Quantity ;
    ex:observedValuePredicate ( ex:obs-latency ) .

ex:cond-bandwidth
    a log:Condition ;
    ex:atLeast ( ex:obs-bandwidth-value ex:thr-bandwidth ) .

ex:obs-bandwidth
    ex:observedMetricPredicate ex:bandwidthMetric .

ex:obs-bandwidth-value
    a quan:Quantity ;
    ex:observedValuePredicate ( ex:obs-bandwidth ) .

ex:topology
    a icm:Context ;
    ex:hubPredicate ex:hub-site ;
    ex:spokePredicate ex:spoke-site-1, ex:spoke-site-2 .

ex:hub-site
    rdfs:label "桃園航太製造總部"@zh .

ex:spoke-site-1
    rdfs:label "台中零件廠"@zh .

ex:spoke-site-2
    rdfs:label "高雄組裝廠"@zh .

ex:tenant
    rdfs:label "泰盛航太"@zh .