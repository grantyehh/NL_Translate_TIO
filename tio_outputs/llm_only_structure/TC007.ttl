@prefix ex: <http://example.org/tio-instance/tc007/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/Quantity/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix evsla: <http://example.org/evsla#> .

ex:intent
    a icm:Intent, evsla:EnterpriseVpnSlaIntent ;
    icm:intentElements ex:exp-latency, ex:topology, ex:cond-latency ;
    rdfs:comment "Ensure latency from the Kaohsiung Port operations center hub to all port branch spokes stays below 80 ms for 95% of the time."@en .

ex:exp-latency
    a icm:PropertyExpectation ;
    icm:target ex:tgt-latency ;
    evsla:latencyMetric evsla:OneWayDelay ;
    evsla:latencyThreshold ex:thr-latency ;
    evsla:latencyStatistic evsla:Percentile95 ;
    evsla:latencyScope evsla:HubToAllSpokes ;
    evsla:latencyMeasurementMethod evsla:ActiveMeasurement ;
    evsla:latencyTimeWindow evsla:DefaultTimeWindow .

ex:tgt-latency
    a icm:Target ;
    icm:valuesOfTargetProperty ex:thr-latency .

ex:thr-latency
    a quan:Quantity ;
    rdf:value 80 ;
    quan:unit "ms" .

ex:cond-latency
    a log:Condition ;
    log:strictlySmaller ( ex:obs-latency-value ex:thr-latency ) .

ex:obs-latency
    evsla:observedLatencyMetric evsla:OneWayDelay .

ex:obs-latency-value
    a quan:Quantity ;
    evsla:observedValueOf ( ex:obs-latency ) .

ex:topology
    a icm:Context, evsla:HubAndSpokeTopology ;
    evsla:hasHub ex:hub ;
    evsla:hasSpoke ex:spoke-1 .

ex:hub
    a evsla:HubSite ;
    rdfs:label "高雄港營運中心"@zh .

ex:spoke-1
    a evsla:SpokeSite ;
    rdfs:label "所有港站分點"@zh .

ex:service
    evsla:forTenant ex:tenant .

ex:tenant
    a evsla:EnterpriseTenant ;
    rdfs:label "海港航運"@zh .