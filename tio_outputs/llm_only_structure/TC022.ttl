@prefix ex: <http://example.org/tio-instance/tc022/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix icm: <http://example.org/icm#> .
@prefix log: <http://example.org/log#> .
@prefix quan: <http://example.org/quan#> .

ex:intent
    a icm:Intent ;
    icm:intentElements ex:exp-loss, ex:topology, ex:cond-loss ;
    rdfs:comment "Taipei warehouse hub to each spoke warehouse must keep packet loss rate below 0.1% for 99% of the time."@en .

ex:exp-loss
    a icm:PropertyExpectation ;
    icm:target ex:tgt-loss .

ex:tgt-loss
    a icm:Target ;
    ex:metricPredicate ex:packetLossRate ;
    icm:valuesOfTargetProperty ex:thr-loss ;
    ex:thresholdPredicate ex:thr-loss ;
    ex:statisticPredicate ex:timeCoverage99Percent ;
    ex:scopePredicate ex:perSpoke ;
    ex:methodPredicate ex:measurementMethod ;
    ex:windowPredicate ex:timeWindow .

ex:thr-loss
    a quan:Quantity ;
    rdf:value 0.1 ;
    quan:unit "%" .

ex:cond-loss
    a log:Condition ;
    ex:strictlySmallerThan ( ex:obs-loss-value ex:thr-loss ) .

ex:obs-loss
    ex:observedMetricPredicate ex:packetLossRate .

ex:obs-loss-value
    a quan:Quantity ;
    ex:observedValuePredicate ( ex:obs-loss ) .

ex:topology
    a icm:Context ;
    ex:hubPredicate [ rdfs:label "台北倉儲中心"@zh ] ;
    ex:spokePredicate [ rdfs:label "新北倉"@zh ] ;
    ex:spokePredicate [ rdfs:label "桃園倉"@zh ] ;
    ex:spokePredicate [ rdfs:label "台中倉"@zh ] .