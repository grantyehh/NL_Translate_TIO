@prefix ex: <http://example.org/tio-instance/tc022/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix icm: <http://example.org/icm#> .
@prefix log: <http://example.org/log#> .
@prefix quan: <http://example.org/quan#> .

ex:intent
    a icm:Intent ;
    icm:intentElements ex:exp-packet-loss, ex:topology, ex:cond-packet-loss ;
    rdfs:comment "Hub-to-spokes packet loss rate shall stay below 0.1% for each spoke at the 99% level."@en .

ex:exp-packet-loss
    a icm:PropertyExpectation ;
    icm:target ex:tgt-packet-loss ;
    ex:metricPredicate ex:packetLossRate ;
    ex:thresholdPredicate ex:thr-packet-loss ;
    ex:statisticPredicate ex:p99 ;
    ex:scopePredicate ex:perSpoke ;
    ex:methodPredicate ex:defaultMeasurementMethod ;
    ex:windowPredicate ex:defaultTimeWindow .

ex:tgt-packet-loss
    a icm:Target ;
    icm:valuesOfTargetProperty ex:thr-packet-loss .

ex:thr-packet-loss
    a quan:Quantity ;
    rdf:value 0.1 ;
    quan:unit "%" .

ex:cond-packet-loss
    a log:Condition ;
    ex:strictlySmaller ( ex:obs-packet-loss-value ex:thr-packet-loss ) .

ex:obs-packet-loss
    ex:observedMetricPredicate ex:packetLossRate .

ex:obs-packet-loss-value
    a quan:Quantity ;
    ex:observedValuePredicate ( ex:obs-packet-loss ) .

ex:topology
    a icm:Context ;
    ex:forTenant ex:tenant ;
    ex:hubPredicate ex:hub-taipei ;
    ex:spokePredicate ex:spoke-newtaipei, ex:spoke-taoyuan, ex:spoke-taichung .

ex:tenant
    a ex:Tenant ;
    rdfs:label "翔益電商"@zh .

ex:hub-taipei
    a ex:HubSite ;
    rdfs:label "台北倉儲中心"@zh .

ex:spoke-newtaipei
    a ex:SpokeSite ;
    rdfs:label "新北倉"@zh .

ex:spoke-taoyuan
    a ex:SpokeSite ;
    rdfs:label "桃園倉"@zh .

ex:spoke-taichung
    a ex:SpokeSite ;
    rdfs:label "台中倉"@zh .