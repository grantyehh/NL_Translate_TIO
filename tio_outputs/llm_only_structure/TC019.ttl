@prefix ex: <http://example.org/tio-instance/tc019/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix quan: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:intent
    a icm:Intent ;
    icm:intentElements ex:exp-latency, ex:topology, ex:cond-latency ;
    rdfs:comment "Ensure latency from the security monitoring headquarters to all branches stays below 40 ms for 95% of the time."@en .

ex:exp-latency
    a icm:PropertyExpectation ;
    icm:target ex:tgt-latency .

ex:tgt-latency
    a icm:Target ;
    icm:valuesOfTargetProperty ex:thr-latency .

ex:thr-latency
    a quan:Quantity ;
    rdf:value 40 ;
    quan:unit "ms" .

ex:cond-latency
    a log:Condition .

ex:obs-latency
    ex:observedMetric ex:latencyMetric .

ex:obs-latency-value
    a quan:Quantity .

ex:topology
    a icm:Context ;
    ex:hubPredicate ex:hub ;
    ex:spokePredicate ex:spoke-1 .

ex:hub
    rdfs:label "安全監控總部"@zh .

ex:spoke-1
    rdfs:label "所有分點"@zh .