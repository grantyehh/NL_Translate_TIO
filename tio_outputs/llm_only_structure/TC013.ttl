@prefix ex: <http://example.org/tio-instance/tc013/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaIntent/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:intent
    a icm:Intent, evsla:EnterpriseVpnSlaIntent ;
    icm:intentElements ex:exp-latency, ex:topology, ex:cond-latency ;
    rdfs:comment "Ensure latency from the Cloud Education headquarters to all campus branches stays below 60 ms for 95% of the time."@en .

ex:service
    evsla:forTenant ex:tenant .

ex:tenant
    a evsla:Tenant ;
    rdfs:label "雲端教育"@zh .

ex:exp-latency
    a icm:PropertyExpectation ;
    icm:target ex:tgt-latency ;
    evsla:serviceTopology ex:topology ;
    evsla:latency evsla:OneWayDelay ;
    evsla:threshold ex:thr-latency ;
    evsla:statistic evsla:Percentile95 ;
    evsla:scope evsla:HubToAllSpokes ;
    evsla:measurementMethod evsla:ActiveMeasurement ;
    evsla:timeWindow evsla:DefaultTimeWindow .

ex:tgt-latency
    a icm:Target ;
    icm:valuesOfTargetProperty ex:thr-latency .

ex:thr-latency
    a quan:Quantity ;
    rdf:value 60 ;
    quan:unit "ms" .

ex:cond-latency
    a log:Condition ;
    log:strictlyLessThan ( ex:obs-latency-value ex:thr-latency ) .

ex:obs-latency
    evsla:observedLatency evsla:OneWayDelay .

ex:obs-latency-value
    a quan:Quantity ;
    evsla:observedValueOf ( ex:obs-latency ) .

ex:topology
    a icm:Context, evsla:HubAndSpokeTopology ;
    evsla:hubSite ex:hub ;
    evsla:spokeSite ex:spoke-1 .

ex:hub
    a evsla:HubSite ;
    rdfs:label "總部"@zh .

ex:spoke-1
    a evsla:SpokeSite ;
    rdfs:label "所有校區分點"@zh .