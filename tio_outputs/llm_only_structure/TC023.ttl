@prefix ex: <http://example.org/tio-instance/tc023/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/Quantity/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:intent
    a icm:Intent ;
    icm:intentElements ex:exp-bandwidth, ex:topology, ex:cond-bandwidth ;
    rdfs:comment "Taifu Construction requires bandwidth from Taichung headquarters to each spoke site to be at least 50 Mbps."@en .

ex:exp-bandwidth
    a icm:PropertyExpectation ;
    icm:target ex:tgt-bandwidth .

ex:tgt-bandwidth
    a icm:Target ;
    icm:valuesOfTargetProperty ex:thr-bandwidth .

ex:thr-bandwidth
    a quan:Quantity ;
    rdf:value 50 ;
    quan:unit "Mbps" .

ex:cond-bandwidth
    a log:Condition .

ex:topology
    a icm:Context ;
    ex:hubPredicate ex:hub-site ;
    ex:spokePredicate ex:spoke-site-1, ex:spoke-site-2 .

ex:hub-site
    rdfs:label "台中總部"@zh .

ex:spoke-site-1
    rdfs:label "苗栗工地"@zh .

ex:spoke-site-2
    rdfs:label "彰化工地"@zh .

ex:tenant
    rdfs:label "泰富建設"@zh .