@prefix ex: <http://example.org/tio-instance/tc023/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix icm: <http://example.org/icm#> .
@prefix log: <http://example.org/log#> .
@prefix quan: <http://example.org/quan#> .

ex:intent
    a icm:Intent ;
    icm:intentElements ex:exp-miaoli, ex:exp-changhua, ex:topology, ex:cond-miaoli, ex:cond-changhua ;
    rdfs:comment "Taifu Construction requires bandwidth from the Taichung headquarters hub to the Miaoli site and the Changhua site, with each spoke guaranteed at least 50 Mbps."@en .

ex:exp-miaoli
    a icm:PropertyExpectation ;
    icm:target ex:tgt-miaoli .

ex:tgt-miaoli
    a icm:Target ;
    ex:metricPredicate ex:bandwidth ;
    icm:valuesOfTargetProperty ex:thr-bandwidth ;
    ex:thresholdPredicate ex:thr-bandwidth ;
    ex:scopePredicate ex:miaoli-spoke .

ex:exp-changhua
    a icm:PropertyExpectation ;
    icm:target ex:tgt-changhua .

ex:tgt-changhua
    a icm:Target ;
    ex:metricPredicate ex:bandwidth ;
    icm:valuesOfTargetProperty ex:thr-bandwidth ;
    ex:thresholdPredicate ex:thr-bandwidth ;
    ex:scopePredicate ex:changhua-spoke .

ex:thr-bandwidth
    a quan:Quantity ;
    rdf:value 50 ;
    quan:unit "Mbps" .

ex:cond-miaoli
    a log:Condition ;
    ex:atLeastOperator ( ex:obs-miaoli-value ex:thr-bandwidth ) .

ex:obs-miaoli
    ex:observed-metric-predicate ex:bandwidth .

ex:obs-miaoli-value
    a quan:Quantity ;
    ex:observed-value-predicate ( ex:obs-miaoli ) .

ex:cond-changhua
    a log:Condition ;
    ex:atLeastOperator ( ex:obs-changhua-value ex:thr-bandwidth ) .

ex:obs-changhua
    ex:observed-metric-predicate ex:bandwidth .

ex:obs-changhua-value
    a quan:Quantity ;
    ex:observed-value-predicate ( ex:obs-changhua ) .

ex:topology
    a icm:Context ;
    ex:hubPredicate ex:hub-taichung ;
    ex:spokePredicate ex:spoke-miaoli, ex:spoke-changhua .

ex:hub-taichung
    rdfs:label "台中總部"@zh .

ex:spoke-miaoli
    rdfs:label "苗栗工地"@zh .

ex:spoke-changhua
    rdfs:label "彰化工地"@zh .