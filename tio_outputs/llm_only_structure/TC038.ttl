@prefix ex: <http://example.org/tio-instance/tc038/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix quan: <http://qudt.org/schema/qudt/> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

ex:intent
    a icm:Intent ;
    icm:intentElements ex:exp-bandwidth, ex:topology, ex:cond-bandwidth ;
    rdfs:comment "Far EasTone Smart Retail requires guaranteed minimum bandwidth of at least 80 Mbps from the Taipei retail cloud hub to five flagship store spokes within the monthly SLA window."@en .

ex:exp-bandwidth
    a icm:PropertyExpectation ;
    icm:target ex:tgt-bandwidth .

ex:tgt-bandwidth
    a icm:Target ;
    ex:metricPredicate ex:bandwidth ;
    icm:valuesOfTargetProperty ex:thr-bandwidth ;
    ex:thresholdPredicate ex:thr-bandwidth ;
    ex:statisticPredicate ex:minimum ;
    ex:scopePredicate ex:hubToAllSpokes ;
    ex:methodPredicate ex:guaranteed ;
    ex:windowPredicate ex:monthlySLAWindow .

ex:thr-bandwidth
    a quan:Quantity ;
    rdf:value 80 ;
    quan:unit "Mbps" .

ex:cond-bandwidth
    a log:Condition ;
    ex:atLeastOperator ( ex:obs-bandwidth-value ex:thr-bandwidth ) .

ex:obs-bandwidth
    ex:observedMetricPredicate ex:bandwidth ;
    ex:observedValuePredicate ( ex:obs-bandwidth ) .

ex:obs-bandwidth-value
    a quan:Quantity .

ex:topology
    a icm:Context ;
    ex:hubPredicate [ rdfs:label "台北零售雲總部"@zh ] ;
    ex:spokePredicate [ rdfs:label "旗艦門市1"@zh ] ;
    ex:spokePredicate [ rdfs:label "旗艦門市2"@zh ] ;
    ex:spokePredicate [ rdfs:label "旗艦門市3"@zh ] ;
    ex:spokePredicate [ rdfs:label "旗艦門市4"@zh ] ;
    ex:spokePredicate [ rdfs:label "旗艦門市5"@zh ] .