@prefix ex: <http://example.org/tio-instance/tc038/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix quan: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:intent
    a icm:Intent ;
    icm:intentElements ex:exp-bandwidth, ex:topology, ex:cond-bandwidth ;
    rdfs:comment "Monthly SLA for hub-to-five-spoke bandwidth minimum not less than 80 Mbps."@en .

ex:exp-bandwidth
    a icm:PropertyExpectation ;
    icm:target ex:tgt-bandwidth ;
    ex:metricPredicate ex:bandwidth ;
    ex:thresholdPredicate ex:thr-bandwidth ;
    ex:statisticPredicate ex:minimum ;
    ex:scopePredicate ex:hubToAllSpokes ;
    ex:methodPredicate ex:defaultMeasurementMethod ;
    ex:windowPredicate ex:monthlyWindow .

ex:tgt-bandwidth
    a icm:Target ;
    icm:valuesOfTargetProperty ex:thr-bandwidth .

ex:thr-bandwidth
    a quan:Quantity ;
    rdf:value 80 ;
    quan:unit "Mbps" .

ex:cond-bandwidth
    a log:Condition ;
    ex:atLeastOperator ( ex:obs-bandwidth-value ex:thr-bandwidth ) .

ex:obs-bandwidth
    ex:observedMetricPredicate ex:bandwidth .

ex:obs-bandwidth-value
    a quan:Quantity ;
    ex:observedValuePredicate ( ex:obs-bandwidth ) .

ex:service
    ex:forTenant ex:tenant ;
    ex:hasTopology ex:topology .

ex:tenant
    a ex:Tenant ;
    rdfs:label "遠傳智慧零售"@zh .

ex:topology
    a icm:Context, ex:HubAndSpokeTopology ;
    ex:hubPredicate ex:hub ;
    ex:spokePredicate ex:spoke1, ex:spoke2, ex:spoke3, ex:spoke4, ex:spoke5 .

ex:hub
    a ex:HubSite ;
    rdfs:label "台北零售雲總部"@zh .

ex:spoke1
    a ex:SpokeSite ;
    rdfs:label "旗艦門市一"@zh .

ex:spoke2
    a ex:SpokeSite ;
    rdfs:label "旗艦門市二"@zh .

ex:spoke3
    a ex:SpokeSite ;
    rdfs:label "旗艦門市三"@zh .

ex:spoke4
    a ex:SpokeSite ;
    rdfs:label "旗艦門市四"@zh .

ex:spoke5
    a ex:SpokeSite ;
    rdfs:label "旗艦門市五"@zh .