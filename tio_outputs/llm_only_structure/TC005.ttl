@prefix ex: <http://example.org/tio-instance/tc005/> .
@prefix icm: <http://example.org/icm#> .
@prefix log: <http://example.org/log#> .
@prefix quan: <http://example.org/quan#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:intent
    a icm:Intent ;
    icm:intentElements ex:exp-packet-loss, ex:topology, ex:cond-packet-loss ;
    rdfs:comment "Ensure packet loss rate between Morning Star Retail hub and all spokes stays below 0.05% at the 99% level."@en .

ex:exp-packet-loss
    a icm:PropertyExpectation ;
    icm:target ex:tgt-packet-loss ;
    ex:metricPredicate ex:packetLossRate ;
    ex:thresholdPredicate ex:thr-packet-loss ;
    ex:statisticPredicate ex:p99 ;
    ex:scopePredicate ex:hubToAllSpokes ;
    ex:methodPredicate ex:defaultMeasurementMethod ;
    ex:windowPredicate ex:defaultTimeWindow .

ex:tgt-packet-loss
    a icm:Target ;
    icm:valuesOfTargetProperty ex:thr-packet-loss .

ex:thr-packet-loss
    a quan:Quantity ;
    rdf:value 0.05 ;
    quan:unit "%" .

ex:cond-packet-loss
    a log:Condition ;
    ex:strictlySmallerThan ( ex:obs-packet-loss-value ex:thr-packet-loss ) .

ex:obs-packet-loss
    ex:observedMetricPredicate ex:packetLossRate .

ex:obs-packet-loss-value
    a quan:Quantity ;
    ex:observedValuePredicate ( ex:obs-packet-loss ) .

ex:topology
    a icm:Context ;
    ex:hubPredicate ex:hub ;
    ex:spokePredicate ex:spoke-1 .

ex:hub
    rdfs:label "晨星零售Hub"@zh .

ex:spoke-1
    rdfs:label "各Spoke"@zh .