@prefix ex: <http://example.org/tio-instance/tc005/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix icm: <http://example.org/icm#> .
@prefix quan: <http://example.org/quan#> .
@prefix log: <http://example.org/log#> .

ex:intent
    a icm:Intent ;
    icm:intentElements ex:exp-packet-loss, ex:topology, ex:cond-packet-loss ;
    rdfs:comment "Ensure packet loss rate between Morningstar Retail Hub and each Spoke stays below 0.05% for 99% of the time."@en .

ex:exp-packet-loss
    a icm:PropertyExpectation ;
    icm:target ex:tgt-packet-loss .

ex:tgt-packet-loss
    a icm:Target ;
    ex:metricPredicate ex:packet-loss-rate ;
    icm:valuesOfTargetProperty ex:thr-packet-loss ;
    ex:thresholdPredicate ex:thr-packet-loss ;
    ex:statisticPredicate ex:p99 ;
    ex:scopePredicate ex:hub-to-all-spokes ;
    ex:methodPredicate ex:measurement-method ;
    ex:windowPredicate ex:time-window .

ex:thr-packet-loss
    a quan:Quantity ;
    rdf:value 0.05 ;
    quan:unit "%" .

ex:cond-packet-loss
    a log:Condition ;
    ex:strictly-smallerThan ( ex:obs-packet-loss-value ex:thr-packet-loss ) .

ex:obs-packet-loss
    ex:observed-metric-predicate ex:packet-loss-rate ;
    ex:observed-value-predicate ( ex:obs-packet-loss ) .

ex:obs-packet-loss-value
    a quan:Quantity .

ex:topology
    a icm:Context ;
    ex:hubPredicate ex:hub ;
    ex:spokePredicate ex:spoke-1, ex:spoke-2, ex:spoke-3 .

ex:hub
    rdfs:label "晨星零售Hub"@zh .

ex:spoke-1
    rdfs:label "Spoke 1"@en .

ex:spoke-2
    rdfs:label "Spoke 2"@en .

ex:spoke-3
    rdfs:label "Spoke 3"@en .