@prefix ex: <http://example.org/tio-instance/tc018/> .
@prefix icm: <http://example.org/icm#> .
@prefix log: <http://example.org/log#> .
@prefix quan: <http://example.org/quan#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:intent
  a icm:Intent ;
  icm:intentElements ex:exp-bandwidth, ex:topology, ex:cond-bandwidth ;
  rdfs:comment "Provide guaranteed bandwidth of at least 80 Mbps from 東岸觀光總部 to 綠島服務站."@en .

ex:exp-bandwidth
  a icm:PropertyExpectation ;
  icm:target ex:tgt-bandwidth ;
  ex:metricPredicate ex:bandwidth ;
  ex:thresholdPredicate ex:thr-bandwidth ;
  ex:statisticPredicate ex:guaranteed ;
  ex:scopePredicate ex:hubToSpoke ;
  ex:methodPredicate ex:defaultMethod ;
  ex:windowPredicate ex:defaultWindow .

ex:tgt-bandwidth
  a icm:Target ;
  icm:valuesOfTargetProperty ex:thr-bandwidth .

ex:thr-bandwidth
  a quan:Quantity ;
  rdf:value 80 ;
  quan:unit "Mbps" .

ex:cond-bandwidth
  a log:Condition ;
  ex:atLeastOperator ( ex:obs-bandwidth-value ex:thr-bandwidth ) .

ex:obs-bandwidth
  ex:observedMetricPredicate ex:bandwidth .

ex:obs-bandwidth-value
  a quan:Quantity ;
  ex:observedValuePredicate ( ex:obs-bandwidth ) .

ex:topology
  a icm:Context ;
  ex:hubPredicate ex:hub ;
  ex:spokePredicate ex:spoke .

ex:hub
  rdfs:label "東岸觀光總部"@zh .

ex:spoke
  rdfs:label "綠島服務站"@zh .