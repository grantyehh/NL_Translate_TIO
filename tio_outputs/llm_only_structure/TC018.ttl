@prefix ex: <http://example.org/tio-instance/tc018/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix icm: <http://example.org/icm#> .
@prefix quan: <http://example.org/quan#> .
@prefix log: <http://example.org/log#> .

ex:intent
    a icm:Intent ;
    icm:intentElements ex:exp-bandwidth, ex:topology, ex:cond-bandwidth ;
    rdfs:comment "Guaranteed bandwidth of at least 80 Mbps from East Coast Tourism Headquarters to Green Island Service Station."@en .

ex:exp-bandwidth
    a icm:PropertyExpectation ;
    icm:target ex:tgt-bandwidth .

ex:tgt-bandwidth
    a icm:Target ;
    ex:metricPredicate ex:GuaranteedBandwidth ;
    icm:valuesOfTargetProperty ex:thr-bandwidth ;
    ex:thresholdPredicate ex:thr-bandwidth .

ex:thr-bandwidth
    a quan:Quantity ;
    rdf:value 80 ;
    quan:unit "Mbps" .

ex:cond-bandwidth
    a log:Condition ;
    ex:atLeastOperator ( ex:obs-bandwidth-value ex:thr-bandwidth ) .

ex:obs-bandwidth
    ex:observedMetricPredicate ex:GuaranteedBandwidth ;
    ex:obs-bandwidth-value a quan:Quantity ;
    ex:observedValuePredicate ( ex:obs-bandwidth ) .

ex:topology
    a icm:Context ;
    ex:hubPredicate [ rdfs:label "東岸觀光總部"@zh ] ;
    ex:spokePredicate [ rdfs:label "綠島服務站"@zh ] .