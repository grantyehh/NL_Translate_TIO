@prefix ex: <http://example.org/tio-instance/tc037/> .
@prefix icm: <http://example.org/icm/> .
@prefix log: <http://example.org/log/> .
@prefix quan: <http://example.org/quan/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:intent
    a icm:Intent ;
    icm:intentElements ex:exp-packet-loss, ex:topology, ex:cond-packet-loss ;
    rdfs:comment "Shengde Logistics requires the maximum packet loss rate from Linkou logistics headquarters to five spoke warehouses to stay no more than 0.5% within an hourly window."@en .

ex:exp-packet-loss
    a icm:PropertyExpectation ;
    icm:target ex:tgt-packet-loss ;
    ex:metricPredicate ex:packetLossRate ;
    ex:thresholdPredicate ex:thr-packet-loss ;
    ex:statisticPredicate ex:maximum ;
    ex:scopePredicate ex:hubToAllSpokes ;
    ex:methodPredicate ex:defaultMeasurementMethod ;
    ex:windowPredicate ex:oneHourWindow .

ex:tgt-packet-loss
    a icm:Target ;
    icm:valuesOfTargetProperty ex:thr-packet-loss .

ex:thr-packet-loss
    a quan:Quantity ;
    rdf:value 0.5 ;
    quan:unit "%" .

ex:cond-packet-loss
    a log:Condition ;
    ex:atMostOperator ( ex:obs-packet-loss-value ex:thr-packet-loss ) .

ex:obs-packet-loss
    ex:observedMetricPredicate ex:packetLossRate .

ex:obs-packet-loss-value
    a quan:Quantity ;
    ex:observedValuePredicate ( ex:obs-packet-loss ) .

ex:topology
    a icm:Context ;
    ex:forTenant ex:tenant ;
    ex:hubPredicate ex:hub ;
    ex:spokePredicate ex:spoke-1, ex:spoke-2, ex:spoke-3, ex:spoke-4, ex:spoke-5 .

ex:tenant
    rdfs:label "盛德物流"@zh .

ex:hub
    rdfs:label "林口物流總部"@zh .

ex:spoke-1
    rdfs:label "分倉一"@zh .

ex:spoke-2
    rdfs:label "分倉二"@zh .

ex:spoke-3
    rdfs:label "分倉三"@zh .

ex:spoke-4
    rdfs:label "分倉四"@zh .

ex:spoke-5
    rdfs:label "分倉五"@zh .