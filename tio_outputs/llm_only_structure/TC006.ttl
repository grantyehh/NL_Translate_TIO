@prefix ex: <http://example.org/tio-instance/tc006/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix icm: <http://example.org/icm#> .
@prefix log: <http://example.org/log#> .
@prefix quan: <http://example.org/quan#> .

ex:intent
    a icm:Intent ;
    icm:intentElements ex:exp-bandwidth, ex:topology, ex:cond-bandwidth ;
    rdfs:comment "Guaranteed bandwidth from Beichen Securities headquarters to Taichung trading room shall be at least 500 Mbps."@en .

ex:exp-bandwidth
    a icm:PropertyExpectation ;
    icm:target ex:tgt-bandwidth .

ex:tgt-bandwidth
    a icm:Target ;
    ex:metricPredicate ex:GuaranteedBandwidth ;
    icm:valuesOfTargetProperty ex:thr-bandwidth ;
    ex:thresholdPredicate ex:thr-bandwidth ;
    ex:statisticPredicate ex:Minimum ;
    ex:scopePredicate ex:HubToSpoke ;
    ex:methodPredicate ex:Guaranteed ;
    ex:windowPredicate ex:ServicePeriod .

ex:thr-bandwidth
    a quan:Quantity ;
    rdf:value 500 ;
    quan:unit "Mbps" .

ex:cond-bandwidth
    a log:Condition ;
    ex:AtLeastOperator ( ex:obs-bandwidth-value ex:thr-bandwidth ) .

ex:obs-bandwidth
    ex:observed-metric-predicate ex:GuaranteedBandwidth ;
    ex:obs-bandwidth-value a quan:Quantity ;
    ex:observed-value-predicate ( ex:obs-bandwidth ) .

ex:topology
    a icm:Context ;
    ex:hubPredicate [ rdfs:label "北辰證券總部"@zh ] ;
    ex:spokePredicate [ rdfs:label "台中交易室"@zh ] .