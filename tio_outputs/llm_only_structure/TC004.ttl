@prefix ex: <http://example.org/tio-instance/tc004/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaIntent/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/Quantity/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:intent
    a icm:Intent, evsla:EnterpriseVpnSlaIntent ;
    icm:intentElements ex:exp-latency, ex:topology, ex:cond-latency ;
    rdfs:comment "Ensure latency from Taipei medical cloud hub to all branch sites stays below 30 ms for 95% of the time."@en .

ex:exp-latency
    a icm:PropertyExpectation ;
    icm:target ex:tgt-latency ;
    evsla:serviceMetric evsla:OneWayLatency ;
    evsla:threshold ex:thr-latency ;
    evsla:statistic evsla:Percentile95 ;
    evsla:scope evsla:HubToAllSpokes ;
    evsla:measurementMethod evsla:ActiveMeasurement ;
    evsla:timeWindow evsla:DefaultTimeWindow .

ex:tgt-latency
    a icm:Target ;
    icm:valuesOfTargetProperty ex:thr-latency .

ex:thr-latency
    a quan:Quantity ;
    rdf:value 30 ;
    quan:unit "ms" .

ex:cond-latency
    a log:Condition ;
    log:StrictlySmaller ( ex:obs-latency-value ex:thr-latency ) .

ex:obs-latency
    evsla:observedMetric evsla:OneWayLatency .

ex:obs-latency-value
    a quan:Quantity ;
    evsla:observedValueOf ( ex:obs-latency ) .

ex:topology
    a icm:Context, evsla:HubAndSpokeTopology ;
    evsla:forTenant ex:tenant ;
    evsla:hasHub ex:hub ;
    evsla:hasSpoke ex:spoke-1 .

ex:tenant
    a evsla:EnterpriseTenant ;
    rdfs:label "康健醫療"@zh .

ex:hub
    a evsla:HubSite ;
    rdfs:label "台北醫療雲中心"@zh .

ex:spoke-1
    a evsla:SpokeSite ;
    rdfs:label "所有院區分點"@zh .