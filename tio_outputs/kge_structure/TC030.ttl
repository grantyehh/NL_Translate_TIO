@prefix ex: <http://example.org/tio-instance/tc030/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix ig: <http://tio.models.tmforum.org/tio/v3.6.0/IntentGuaranteeOntology/> .
@prefix imo: <http://tio.models.tmforum.org/tio/v3.6.0/IntentManagementOntology/> .
@prefix met: <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix pbi: <http://tio.models.tmforum.org/tio/v3.6.0/ProposalBestIntent/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix mf: <http://tio.models.tmforum.org/tio/v3.6.0/MathFunctionscoefficients> .
@prefix set: <http://tio.models.tmforum.org/tio/v3.6.0/SetOperators/> .
@prefix insp: <http://tio.models.tmforum.org/tio/v3.6.0/IntentSpecification/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:intent
    a icm:Intent ;
    icm:intentElements ex:exp-loss, ex:exp-bw, ex:topology, ex:cond-loss, ex:cond-bw ;
    rdfs:comment "Enterprise VPN hub-and-spoke SLA: Taipei hub to Tainan packet loss below 0.01% for 99% time, and Taipei hub to Kaohsiung guaranteed bandwidth at least 1000 Mbps, for tenant Red Telecom."@en .

ex:service
    a evsla:EnterpriseVpnService ;
    evsla:forTenant ex:tenant .

ex:tenant
    rdfs:label "瑞德電信"@zh .

ex:exp-loss
    a icm:PropertyExpectation, evsla:SlaExpectation ;
    evsla:forTenant ex:tenant ;
    evsla:serviceTarget ex:service ;
    icm:target ex:tgt-loss .

ex:tgt-loss
    a icm:Target ;
    met:observedMetric evsla:packetLoss ;
    icm:valuesOfTargetProperty ex:thr-loss ;
    evsla:hasThreshold ex:thr-loss .

ex:thr-loss
    a quan:Quantity ;
    rdf:value 0.01 ;
    quan:unit "%" .

ex:exp-bw
    a icm:PropertyExpectation, evsla:SlaExpectation ;
    evsla:forTenant ex:tenant ;
    evsla:serviceTarget ex:service ;
    icm:target ex:tgt-bw .

ex:tgt-bw
    a icm:Target ;
    met:observedMetric evsla:guaranteedBandwidth ;
    icm:valuesOfTargetProperty ex:thr-bw ;
    evsla:hasThreshold ex:thr-bw .

ex:thr-bw
    a quan:Quantity ;
    rdf:value 1000 ;
    quan:unit "Mbps" .

ex:cond-loss
    a log:Condition ;
    rdfs:comment "below threshold"@en .

ex:obs-loss
    met:observedMetric evsla:packetLoss .

ex:obs-loss-value
    a quan:Quantity .

ex:cond-bw
    a log:Condition ;
    rdfs:comment "at least threshold"@en .

ex:obs-bw
    met:observedMetric evsla:guaranteedBandwidth .

ex:obs-bw-value
    a quan:Quantity .

ex:topology
    evsla:forTenant ex:tenant ;
    rdfs:comment "Hub-and-spoke topology with Taipei as hub and Tainan, Kaohsiung as spokes."@en ;
    ex:hub ex:taipei ;
    ex:spoke ex:tainan, ex:kaohsiung .

ex:taipei
    rdfs:label "台北機房"@zh .

ex:tainan
    rdfs:label "台南機房"@zh .

ex:kaohsiung
    rdfs:label "高雄機房"@zh .