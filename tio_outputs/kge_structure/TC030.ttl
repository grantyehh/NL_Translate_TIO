@prefix ex: <http://example.org/tio-instance/tc030/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix met: <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:intent
    a icm:Intent, evsla:EnterpriseVpnService ;
    icm:intentElements ex:exp-packetLoss, ex:exp-guaranteedBandwidth, ex:topology, ex:cond-packetLoss, ex:cond-guaranteedBandwidth ;
    evsla:forTenant ex:tenant ;
    rdfs:comment "瑞德電信要求台北機房到台南機房封包遺失率在99%時間內低於0.01%，到高雄機房保證頻寬不低於1000Mbps。"@en .

ex:tenant
    a evsla:Tenant ;
    rdfs:label "瑞德電信"@zh .

ex:exp-packetLoss
    a icm:PropertyExpectation, evsla:SlaExpectation ;
    icm:target ex:tgt-packetLoss .

ex:tgt-packetLoss
    a icm:Target ;
    evsla:hasMetric evsla:packetLoss ;
    icm:valuesOfTargetProperty ex:thr-packetLoss ;
    evsla:hasThreshold ex:thr-packetLoss ;
    evsla:hasStatistic evsla:p99 ;
    evsla:hasScope evsla:specificSpoke ;
    evsla:hasMeasurementMethod evsla:twamp ;
    evsla:hasTimeWindow evsla:fiveMinuteWindow .

ex:thr-packetLoss
    a quan:Quantity ;
    rdf:value "0.01"^^xsd:decimal ;
    quan:unit "%" .

ex:cond-packetLoss
    a log:Condition ;
    quan:smaller ( ex:obs-packetLoss-value ex:thr-packetLoss ) .

ex:obs-packetLoss
    evsla:packetLoss evsla:packetLoss .

ex:obs-packetLoss-value
    a quan:Quantity ;
    fun:valueOf ( ex:obs-packetLoss ) .

ex:exp-guaranteedBandwidth
    a icm:PropertyExpectation, evsla:SlaExpectation ;
    icm:target ex:tgt-guaranteedBandwidth .

ex:tgt-guaranteedBandwidth
    a icm:Target ;
    evsla:hasMetric evsla:guaranteedBandwidth ;
    icm:valuesOfTargetProperty ex:thr-guaranteedBandwidth ;
    evsla:hasThreshold ex:thr-guaranteedBandwidth ;
    evsla:hasStatistic evsla:minimum ;
    evsla:hasScope evsla:specificSpoke ;
    evsla:hasMeasurementMethod evsla:activeMeasurement ;
    evsla:hasTimeWindow evsla:fiveMinuteWindow .

ex:thr-guaranteedBandwidth
    a quan:Quantity ;
    rdf:value "1000"^^xsd:decimal ;
    quan:unit "Mbps" .

ex:cond-guaranteedBandwidth
    a log:Condition ;
    quan:atLeast ( ex:obs-guaranteedBandwidth-value ex:thr-guaranteedBandwidth ) .

ex:obs-guaranteedBandwidth
    evsla:guaranteedBandwidth evsla:guaranteedBandwidth .

ex:obs-guaranteedBandwidth-value
    a quan:Quantity ;
    fun:valueOf ( ex:obs-guaranteedBandwidth ) .

ex:topology
    a icm:Context, evsla:HubAndSpokeTopology ;
    evsla:hasHub ex:hub-taipei ;
    evsla:hasSpoke ex:spoke-tainan, ex:spoke-kaohsiung .

ex:hub-taipei
    a evsla:HubSite ;
    rdfs:label "台北機房"@zh .

ex:spoke-tainan
    a evsla:SpokeSite ;
    rdfs:label "台南機房"@zh .

ex:spoke-kaohsiung
    a evsla:SpokeSite ;
    rdfs:label "高雄機房"@zh .