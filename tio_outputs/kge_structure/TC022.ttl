@prefix ex: <http://example.org/tio-instance/tc022/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix met: <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:intent
    a icm:Intent, evsla:HubAndSpokeTopology ;
    icm:intentElements ex:exp-packetloss, ex:topology, ex:cond-packetloss ;
    rdfs:comment "Taipei warehouse hub to New Taipei, Taoyuan, and Taichung spokes: packet loss per spoke stays below 0.1% at the p99 level."@en .

ex:exp-packetloss
    a icm:PropertyExpectation, evsla:SlaExpectation ;
    icm:target ex:tgt-packetloss .

ex:tgt-packetloss
    a icm:Target ;
    evsla:hasMetric evsla:packetLoss ;
    icm:valuesOfTargetProperty ex:thr-packetloss ;
    evsla:hasThreshold ex:thr-packetloss ;
    evsla:hasStatistic evsla:p99 ;
    evsla:hasScope evsla:perSpoke ;
    evsla:hasMeasurementMethod evsla:activeMeasurement ;
    evsla:hasTimeWindow evsla:monthlySlaWindow .

ex:thr-packetloss
    a quan:Quantity ;
    rdf:value "0.1"^^xsd:decimal ;
    quan:unit "%" .

ex:cond-packetloss
    a log:Condition ;
    quan:smaller ( ex:obs-packetloss-value ex:thr-packetloss ) .

ex:obs-packetloss
    met:packetLoss evsla:packetLoss ;
    met:observedValue ( ex:obs-packetloss ) .

ex:obs-packetloss-value
    a quan:Quantity .

ex:topology
    a icm:Context, evsla:HubAndSpokeTopology ;
    evsla:hasHub ex:site-taipei ;
    evsla:hasSpoke ex:site-newtaipei, ex:site-taoyuan, ex:site-taichung .

ex:site-taipei
    a evsla:HubSite ;
    rdfs:label "台北倉儲中心"@zh .

ex:site-newtaipei
    a evsla:SpokeSite ;
    rdfs:label "新北倉"@zh .

ex:site-taoyuan
    a evsla:SpokeSite ;
    rdfs:label "桃園倉"@zh .

ex:site-taichung
    a evsla:SpokeSite ;
    rdfs:label "台中倉"@zh .