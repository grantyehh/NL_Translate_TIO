@prefix ex: <http://example.org/tio-instance/tc035/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix met: <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:intent
    a icm:Intent, evsla:HubAndSpokeTopology ;
    icm:intentElements ex:exp-latency, ex:exp-bandwidth, ex:topology, ex:cond-latency, ex:cond-bandwidth ;
    rdfs:comment "Taisheng Aerospace requires latency from Taoyuan aerospace manufacturing headquarters to the Taichung parts plant and Kaohsiung assembly plant to stay below 25 ms at the p95 level, and guaranteed bandwidth to be at least 300 Mbps."@en .

ex:exp-latency
    a icm:PropertyExpectation, evsla:SlaExpectation ;
    icm:target ex:tgt-latency .

ex:tgt-latency
    a icm:Target ;
    evsla:hasMetric evsla:latency ;
    icm:valuesOfTargetProperty ex:thr-latency ;
    evsla:hasThreshold ex:thr-latency ;
    evsla:hasStatistic evsla:p95 ;
    evsla:hasScope evsla:hubToAllSpokes ;
    evsla:hasMeasurementMethod evsla:twamp ;
    evsla:hasTimeWindow evsla:monthlySlaWindow .

ex:thr-latency
    a quan:Quantity ;
    rdf:value "25"^^xsd:decimal ;
    quan:unit "ms" .

ex:exp-bandwidth
    a icm:PropertyExpectation, evsla:SlaExpectation ;
    icm:target ex:tgt-bandwidth .

ex:tgt-bandwidth
    a icm:Target ;
    evsla:hasMetric evsla:guaranteedBandwidth ;
    icm:valuesOfTargetProperty ex:thr-bandwidth ;
    evsla:hasThreshold ex:thr-bandwidth ;
    evsla:hasStatistic evsla:minimum ;
    evsla:hasScope evsla:hubToAllSpokes ;
    evsla:hasMeasurementMethod evsla:twamp ;
    evsla:hasTimeWindow evsla:monthlySlaWindow .

ex:thr-bandwidth
    a quan:Quantity ;
    rdf:value "300"^^xsd:decimal ;
    quan:unit "Mbps" .

ex:cond-latency
    a log:Condition ;
    quan:smaller ( ex:obs-latency-value ex:thr-latency ) .

ex:obs-latency
    evsla:hasMetric evsla:latency .

ex:obs-latency-value
    a quan:Quantity ;
    fun:valueOf ( ex:obs-latency ) .

ex:cond-bandwidth
    a log:Condition ;
    quan:atLeast ( ex:obs-bandwidth-value ex:thr-bandwidth ) .

ex:obs-bandwidth
    evsla:hasMetric evsla:guaranteedBandwidth .

ex:obs-bandwidth-value
    a quan:Quantity ;
    fun:valueOf ( ex:obs-bandwidth ) .

ex:topology
    a icm:Context, evsla:HubAndSpokeTopology ;
    evsla:hasHub ex:hub-taoyuan ;
    evsla:hasSpoke ex:spoke-taichung, ex:spoke-kaohsiung .

ex:hub-taoyuan
    a evsla:HubSite ;
    rdfs:label "桃園航太製造總部"@zh .

ex:spoke-taichung
    a evsla:SpokeSite ;
    rdfs:label "台中零件廠"@zh .

ex:spoke-kaohsiung
    a evsla:SpokeSite ;
    rdfs:label "高雄組裝廠"@zh .