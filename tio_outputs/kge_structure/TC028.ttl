@prefix ex: <http://example.org/tio-instance/tc028/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix met: <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:intent
    a icm:Intent, evsla:SlaExpectation ;
    icm:intentElements ex:exp-taichung, ex:exp-kaohsiung, ex:topology, ex:cond-bandwidth-taichung, ex:cond-bandwidth-kaohsiung ;
    rdfs:comment "亞翔科技要求新竹總部到台中研發中心保證頻寬不低於200Mbps，且到高雄測試中心保證頻寬不低於100Mbps。"@en .

ex:exp-taichung
    a icm:PropertyExpectation, evsla:SlaExpectation ;
    icm:target ex:tgt-taichung .

ex:tgt-taichung
    a icm:Target ;
    evsla:hasMetric evsla:guaranteedBandwidth ;
    icm:valuesOfTargetProperty ex:thr-bandwidth-taichung ;
    evsla:hasThreshold ex:thr-bandwidth-taichung ;
    evsla:hasStatistic evsla:minimum ;
    evsla:hasScope evsla:specificSpoke ;
    evsla:hasMeasurementMethod evsla:twamp ;
    evsla:hasTimeWindow evsla:monthlySlaWindow .

ex:thr-bandwidth-taichung
    a quan:Quantity ;
    rdf:value "200"^^xsd:decimal ;
    quan:unit "Mbps" .

ex:exp-kaohsiung
    a icm:PropertyExpectation, evsla:SlaExpectation ;
    icm:target ex:tgt-kaohsiung .

ex:tgt-kaohsiung
    a icm:Target ;
    evsla:hasMetric evsla:guaranteedBandwidth ;
    icm:valuesOfTargetProperty ex:thr-bandwidth-kaohsiung ;
    evsla:hasThreshold ex:thr-bandwidth-kaohsiung ;
    evsla:hasStatistic evsla:minimum ;
    evsla:hasScope evsla:specificSpoke ;
    evsla:hasMeasurementMethod evsla:twamp ;
    evsla:hasTimeWindow evsla:monthlySlaWindow .

ex:thr-bandwidth-kaohsiung
    a quan:Quantity ;
    rdf:value "100"^^xsd:decimal ;
    quan:unit "Mbps" .

ex:cond-bandwidth-taichung
    a log:Condition ;
    quan:atLeast ( ex:obs-bandwidth-taichung-value ex:thr-bandwidth-taichung ) .

ex:obs-bandwidth-taichung
    evsla:guaranteedBandwidth evsla:guaranteedBandwidth ;
    icm:valuesOfTargetProperty ex:obs-bandwidth-taichung-value .

ex:obs-bandwidth-taichung-value
    a quan:Quantity .

ex:cond-bandwidth-kaohsiung
    a log:Condition ;
    quan:atLeast ( ex:obs-bandwidth-kaohsiung-value ex:thr-bandwidth-kaohsiung ) .

ex:obs-bandwidth-kaohsiung
    evsla:guaranteedBandwidth evsla:guaranteedBandwidth ;
    icm:valuesOfTargetProperty ex:obs-bandwidth-kaohsiung-value .

ex:obs-bandwidth-kaohsiung-value
    a quan:Quantity .

ex:topology
    a icm:Context, evsla:HubAndSpokeTopology ;
    evsla:hasHub ex:hsinchu-hq ;
    evsla:hasSpoke ex:taichung-rd, ex:kaohsiung-test .

ex:hsinchu-hq
    a evsla:HubSite ;
    rdfs:label "新竹總部"@en .

ex:taichung-rd
    a evsla:SpokeSite ;
    rdfs:label "台中研發中心"@en .

ex:kaohsiung-test
    a evsla:SpokeSite ;
    rdfs:label "高雄測試中心"@en .