@prefix ex: <http://example.org/tio-instance/tc028/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix met: <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:intent
    a icm:Intent, evsla:EnterpriseVpnService ;
    icm:intentElements ex:exp-hsinchu-taichung, ex:exp-hsinchu-kaohsiung, ex:topology, ex:cond-hsinchu-taichung, ex:cond-kaohsiung ;
    evsla:forTenant ex:tenant ;
    rdfs:comment "Enterprise VPN hub-and-spoke SLA intent for guaranteed bandwidth from Hsinchu headquarters to Taichung R&D Center at least 200 Mbps and to Kaohsiung Test Center at least 100 Mbps."@en .

ex:tenant
    a evsla:Tenant ;
    rdfs:label "亞翔科技"@zh .

ex:topology
    a icm:Context, evsla:HubAndSpokeTopology ;
    evsla:hasHub ex:hub-hsinchu ;
    evsla:hasSpoke ex:spoke-taichung, ex:spoke-kaohsiung .

ex:hub-hsinchu
    a evsla:HubSite ;
    rdfs:label "新竹總部"@zh .

ex:spoke-taichung
    a evsla:SpokeSite ;
    rdfs:label "台中研發中心"@zh .

ex:spoke-kaohsiung
    a evsla:SpokeSite ;
    rdfs:label "高雄測試中心"@zh .

ex:exp-hsinchu-taichung
    a icm:PropertyExpectation, evsla:SlaExpectation ;
    icm:target ex:tgt-hsinchu-taichung ;
    evsla:hasMetric evsla:guaranteedBandwidth ;
    evsla:hasThreshold ex:thr-hsinchu-taichung ;
    evsla:hasStatistic evsla:minimum ;
    evsla:hasScope evsla:specificSpoke ;
    evsla:hasMeasurementMethod evsla:activeMeasurement ;
    evsla:hasTimeWindow evsla:fiveMinuteWindow .

ex:tgt-hsinchu-taichung
    a icm:Target ;
    icm:valuesOfTargetProperty ex:thr-hsinchu-taichung .

ex:thr-hsinchu-taichung
    a quan:Quantity ;
    rdf:value "200"^^xsd:decimal ;
    quan:unit "Mbps" .

ex:cond-hsinchu-taichung
    a log:Condition ;
    quan:atLeast ( ex:obs-hsinchu-taichung-value ex:thr-hsinchu-taichung ) .

ex:obs-hsinchu-taichung
    evsla:guaranteedBandwidth evsla:guaranteedBandwidth ;
    ex:obs-hsinchu-taichung-value ( ex:obs-hsinchu-taichung ) .

ex:obs-hsinchu-taichung-value
    a quan:Quantity .

ex:exp-hsinchu-kaohsiung
    a icm:PropertyExpectation, evsla:SlaExpectation ;
    icm:target ex:tgt-hsinchu-kaohsiung ;
    evsla:hasMetric evsla:guaranteedBandwidth ;
    evsla:hasThreshold ex:thr-hsinchu-kaohsiung ;
    evsla:hasStatistic evsla:minimum ;
    evsla:hasScope evsla:specificSpoke ;
    evsla:hasMeasurementMethod evsla:activeMeasurement ;
    evsla:hasTimeWindow evsla:fiveMinuteWindow .

ex:tgt-hsinchu-kaohsiung
    a icm:Target ;
    icm:valuesOfTargetProperty ex:thr-hsinchu-kaohsiung .

ex:thr-hsinchu-kaohsiung
    a quan:Quantity ;
    rdf:value "100"^^xsd:decimal ;
    quan:unit "Mbps" .

ex:cond-kaohsiung
    a log:Condition ;
    quan:atLeast ( ex:obs-kaohsiung-value ex:thr-hsinchu-kaohsiung ) .

ex:obs-kaohsiung
    evsla:guaranteedBandwidth evsla:guaranteedBandwidth ;
    ex:obs-kaohsiung-value ( ex:obs-kaohsiung ) .

ex:obs-kaohsiung-value
    a quan:Quantity .