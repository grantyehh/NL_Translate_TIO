@prefix ex: <http://example.org/tio-instance/tc040/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix met: <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:intent
    a icm:Intent, evsla:SlaExpectation ;
    icm:intentElements ex:exp-packetloss, ex:exp-bandwidth, ex:topology, ex:cond-packetloss, ex:cond-bandwidth ;
    rdfs:comment "Taipei core site to five PoP spokes: within the monthly SLA window, packet loss maximum must be at most 0.3%, and guaranteed bandwidth monthly average must be at least 500 Mbps."@en .

ex:exp-packetloss
    a icm:PropertyExpectation, evsla:SlaExpectation ;
    icm:target ex:tgt-packetloss ;
    evsla:hasMetric evsla:packetLoss ;
    evsla:hasThreshold ex:thr-packetloss ;
    evsla:hasStatistic evsla:maximum ;
    evsla:hasScope evsla:hubToAllSpokes ;
    evsla:hasMeasurementMethod evsla:activeMeasurement ;
    evsla:hasTimeWindow evsla:monthlySlaWindow .

ex:tgt-packetloss
    a icm:Target ;
    evsla:packetLoss evsla:packetLoss ;
    icm:valuesOfTargetProperty ex:thr-packetloss ;
    evsla:hasThreshold ex:thr-packetloss ;
    evsla:hasStatistic evsla:maximum ;
    evsla:hasScope evsla:hubToAllSpokes ;
    evsla:hasMeasurementMethod evsla:activeMeasurement ;
    evsla:hasTimeWindow evsla:monthlySlaWindow .

ex:thr-packetloss
    a quan:Quantity ;
    rdf:value "0.3"^^xsd:decimal ;
    quan:unit "%" .

ex:cond-packetloss
    a log:Condition ;
    quan:atMost ( ex:obs-packetloss-value ex:thr-packetloss ) .

ex:obs-packetloss
    evsla:packetLoss evsla:packetLoss .

ex:obs-packetloss-value
    a quan:Quantity ;
    met:observedValue ( ex:obs-packetloss ) .

ex:exp-bandwidth
    a icm:PropertyExpectation, evsla:SlaExpectation ;
    icm:target ex:tgt-bandwidth ;
    evsla:hasMetric evsla:guaranteedBandwidth ;
    evsla:hasThreshold ex:thr-bandwidth ;
    evsla:hasStatistic evsla:average ;
    evsla:hasScope evsla:hubToAllSpokes ;
    evsla:hasMeasurementMethod evsla:activeMeasurement ;
    evsla:hasTimeWindow evsla:monthlySlaWindow .

ex:tgt-bandwidth
    a icm:Target ;
    evsla:guaranteedBandwidth evsla:guaranteedBandwidth ;
    icm:valuesOfTargetProperty ex:thr-bandwidth ;
    evsla:hasThreshold ex:thr-bandwidth ;
    evsla:hasStatistic evsla:average ;
    evsla:hasScope evsla:hubToAllSpokes ;
    evsla:hasMeasurementMethod evsla:activeMeasurement ;
    evsla:hasTimeWindow evsla:monthlySlaWindow .

ex:thr-bandwidth
    a quan:Quantity ;
    rdf:value "500"^^xsd:decimal ;
    quan:unit "Mbps" .

ex:cond-bandwidth
    a log:Condition ;
    quan:atLeast ( ex:obs-bandwidth-value ex:thr-bandwidth ) .

ex:obs-bandwidth
    evsla:guaranteedBandwidth evsla:guaranteedBandwidth .

ex:obs-bandwidth-value
    a quan:Quantity ;
    met:observedValue ( ex:obs-bandwidth ) .

ex:topology
    a icm:Context ;
    rdfs:comment "Hub-and-spoke topology with one Taipei core hub and five PoP spokes."@en ;
    evsla:hubToAllSpokes ex:hub .

ex:hub
    rdfs:label "台北核心機房"@zh .

ex:spoke-1
    rdfs:label "PoP 節點 1"@zh .

ex:spoke-2
    rdfs:label "PoP 節點 2"@zh .

ex:spoke-3
    rdfs:label "PoP 節點 3"@zh .

ex:spoke-4
    rdfs:label "PoP 節點 4"@zh .

ex:spoke-5
    rdfs:label "PoP 節點 5"@zh .

ex:hub
    evsla:specificSpoke ex:spoke-1, ex:spoke-2, ex:spoke-3, ex:spoke-4, ex:spoke-5 .