@prefix ex: <http://example.org/tio-instance/tc040/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix met: <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:intent
    a icm:Intent, evsla:EnterpriseVpnService ;
    icm:intentElements ex:exp-pl, ex:exp-bw, ex:topology, ex:cond-pl, ex:cond-bw ;
    evsla:forTenant ex:tenant ;
    rdfs:comment "Monthly SLA for Taipei hub to five PoP spokes: packet loss maximum at most 0.3% and guaranteed bandwidth average at least 500Mbps."@en .

ex:tenant
    a evsla:Tenant ;
    rdfs:label "聯光電信"@zh .

ex:exp-pl
    a icm:PropertyExpectation, evsla:SlaExpectation ;
    icm:target ex:tgt-pl ;
    evsla:hasMetric evsla:packetLoss ;
    evsla:hasThreshold ex:thr-pl ;
    evsla:hasStatistic evsla:maximum ;
    evsla:hasScope evsla:hubToAllSpokes ;
    evsla:hasMeasurementMethod evsla:twamp ;
    evsla:hasTimeWindow evsla:monthlySlaWindow .

ex:tgt-pl
    a icm:Target ;
    icm:valuesOfTargetProperty ex:thr-pl .

ex:thr-pl
    a quan:Quantity ;
    rdf:value "0.3"^^xsd:decimal ;
    quan:unit "%" .

ex:exp-bw
    a icm:PropertyExpectation, evsla:SlaExpectation ;
    icm:target ex:tgt-bw ;
    evsla:hasMetric evsla:guaranteedBandwidth ;
    evsla:hasThreshold ex:thr-bw ;
    evsla:hasStatistic evsla:average ;
    evsla:hasScope evsla:hubToAllSpokes ;
    evsla:hasMeasurementMethod evsla:activeMeasurement ;
    evsla:hasTimeWindow evsla:monthlySlaWindow .

ex:tgt-bw
    a icm:Target ;
    icm:valuesOfTargetProperty ex:thr-bw .

ex:thr-bw
    a quan:Quantity ;
    rdf:value "500"^^xsd:decimal ;
    quan:unit "Mbps" .

ex:cond-pl
    a log:Condition ;
    quan:atMost ( ex:obs-pl-value ex:thr-pl ) .

ex:obs-pl
    evsla:packetLoss evsla:packetLoss .

ex:obs-pl-value
    a quan:Quantity ;
    rdf:value ( ex:obs-pl ) .

ex:cond-bw
    a log:Condition ;
    quan:atLeast ( ex:obs-bw-value ex:thr-bw ) .

ex:obs-bw
    evsla:guaranteedBandwidth evsla:guaranteedBandwidth .

ex:obs-bw-value
    a quan:Quantity ;
    rdf:value ( ex:obs-bw ) .

ex:topology
    a icm:Context, evsla:HubAndSpokeTopology ;
    evsla:hasHub ex:hub ;
    evsla:hasSpoke ex:spoke1, ex:spoke2, ex:spoke3, ex:spoke4, ex:spoke5 .

ex:hub
    a evsla:HubSite ;
    rdfs:label "台北核心機房"@zh .

ex:spoke1
    a evsla:SpokeSite ;
    rdfs:label "PoP節點1"@zh .

ex:spoke2
    a evsla:SpokeSite ;
    rdfs:label "PoP節點2"@zh .

ex:spoke3
    a evsla:SpokeSite ;
    rdfs:label "PoP節點3"@zh .

ex:spoke4
    a evsla:SpokeSite ;
    rdfs:label "PoP節點4"@zh .

ex:spoke5
    a evsla:SpokeSite ;
    rdfs:label "PoP節點5"@zh .