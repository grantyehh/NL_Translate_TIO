@prefix ex: <http://example.org/tio-instance/tc029/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix ig: <http://tio.models.tmforum.org/tio/v3.6.0/IntentGuaranteeOntology/> .
@prefix imo: <http://tio.models.tmforum.org/tio/v3.6.0/IntentManagementOntology/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix set: <http://tio.models.tmforum.org/tio/v3.6.0/SetOperators/> .
@prefix pbi: <http://tio.models.tmforum.org/tio/v3.6.0/ProposalBestIntent/> .
@prefix insp: <http://tio.models.tmforum.org/tio/v3.6.0/IntentSpecification/> .
@prefix mf: <http://tio.models.tmforum.org/tio/v3.6.0/MathFunctionslogistic> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:intent
    a icm:Intent ;
    icm:intentElements ex:exp-1, ex:exp-2, ex:topology, ex:cond-1, ex:cond-2 ;
    rdfs:comment "Federated Hospital requires latency from the Taipei Medical Information Center hub to Banqiao campus to stay below 10 ms at the 99% level, and latency to Xizhi and Sanchong campuses to stay below 25 ms at the 95% level."@en .

ex:exp-1
    a icm:PropertyExpectation ;
    icm:target ex:tgt-1 .

ex:tgt-1
    a icm:Target ;
    evsla:latency evsla:latency ;
    icm:valuesOfTargetProperty ex:thr-1 ;
    evsla:hasThreshold ex:thr-1 .

ex:thr-1
    a quan:Quantity ;
    rdf:value "10"^^xsd:decimal ;
    quan:unit "ms" .

ex:exp-2
    a icm:PropertyExpectation ;
    icm:target ex:tgt-2 .

ex:tgt-2
    a icm:Target ;
    evsla:latency evsla:latency ;
    icm:valuesOfTargetProperty ex:thr-2 ;
    evsla:hasThreshold ex:thr-2 ;
    evsla:p95 evsla:p95 .

ex:thr-2
    a quan:Quantity ;
    rdf:value "25"^^xsd:decimal ;
    quan:unit "ms" .

ex:cond-1
    a log:Condition ;
    log:matchAll ( ex:obs-1-value ex:thr-1 ) .

ex:obs-1
    evsla:latency evsla:latency .

ex:obs-1-value
    a quan:Quantity .

ex:cond-2
    a log:Condition ;
    log:matchAll ( ex:obs-2-value ex:thr-2 ) .

ex:obs-2
    evsla:latency evsla:latency .

ex:obs-2-value
    a quan:Quantity .

ex:topology
    a icm:Context ;
    rdfs:comment "Hub-and-spoke topology with Taipei Medical Information Center as hub and Banqiao, Xizhi, and Sanchong as spokes."@en ;
    ex:hub
        [ rdfs:label "台北醫療資訊中心"@zh ] ;
    ex:spoke
        [ rdfs:label "板橋院區"@zh ],
        [ rdfs:label "汐止院區"@zh ],
        [ rdfs:label "三重院區"@zh ] .