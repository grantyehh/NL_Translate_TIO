@prefix ex: <http://example.org/tio-instance/tc029/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix met: <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:intent
  a icm:Intent, evsla:EnterpriseVpnService ;
  icm:intentElements ex:exp-1, ex:exp-2, ex:topology, ex:cond-latency-1, ex:cond-latency-2 ;
  evsla:forTenant ex:tenant ;
  rdfs:comment "Federal Hospital requires latency from Taipei Medical Information Center to Banqiao Campus to stay below 10 ms at p99, and to Xizhi Campus and Sanchong Campus to stay below 25 ms at p95."@en .

ex:tenant
  a evsla:Tenant ;
  rdfs:label "聯邦醫院"@zh .

ex:exp-1
  a icm:PropertyExpectation, evsla:SlaExpectation ;
  icm:target ex:tgt-1 .

ex:tgt-1
  a icm:Target ;
  evsla:hasMetric evsla:latency ;
  icm:valuesOfTargetProperty ex:thr-latency-1 ;
  evsla:hasThreshold ex:thr-latency-1 ;
  evsla:hasStatistic evsla:p99 ;
  evsla:hasScope evsla:specificSpoke ;
  evsla:hasMeasurementMethod evsla:twamp ;
  evsla:hasTimeWindow evsla:fiveMinuteWindow .

ex:thr-latency-1
  a quan:Quantity ;
  rdf:value "10"^^xsd:decimal ;
  quan:unit "ms" .

ex:exp-2
  a icm:PropertyExpectation, evsla:SlaExpectation ;
  icm:target ex:tgt-2 .

ex:tgt-2
  a icm:Target ;
  evsla:hasMetric evsla:latency ;
  icm:valuesOfTargetProperty ex:thr-latency-2 ;
  evsla:hasThreshold ex:thr-latency-2 ;
  evsla:hasStatistic evsla:p95 ;
  evsla:hasScope evsla:perSpoke ;
  evsla:hasMeasurementMethod evsla:twamp ;
  evsla:hasTimeWindow evsla:fiveMinuteWindow .

ex:thr-latency-2
  a quan:Quantity ;
  rdf:value "25"^^xsd:decimal ;
  quan:unit "ms" .

ex:cond-latency-1
  a log:Condition ;
  quan:smaller ( ex:obs-latency-1-value ex:thr-latency-1 ) .

ex:obs-latency-1
  evsla:hasMetric evsla:latency .

ex:obs-latency-1-value
  a quan:Quantity ;
  fun:valueOf ( ex:obs-latency-1 ) .

ex:cond-latency-2
  a log:Condition ;
  quan:smaller ( ex:obs-latency-2-value ex:thr-latency-2 ) .

ex:obs-latency-2
  evsla:hasMetric evsla:latency .

ex:obs-latency-2-value
  a quan:Quantity ;
  fun:valueOf ( ex:obs-latency-2 ) .

ex:topology
  a icm:Context, evsla:HubAndSpokeTopology ;
  evsla:hasHub ex:hub ;
  evsla:hasSpoke ex:spoke-banqiao, ex:spoke-xizhi, ex:spoke-sanchong .

ex:hub
  a evsla:HubSite ;
  rdfs:label "台北醫療資訊中心"@zh .

ex:spoke-banqiao
  a evsla:SpokeSite ;
  rdfs:label "板橋院區"@zh .

ex:spoke-xizhi
  a evsla:SpokeSite ;
  rdfs:label "汐止院區"@zh .

ex:spoke-sanchong
  a evsla:SpokeSite ;
  rdfs:label "三重院區"@zh .