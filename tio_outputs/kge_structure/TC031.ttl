@prefix ex: <http://example.org/tio-instance/tc031/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix met: <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:intent
    a icm:Intent, evsla:EnterpriseVpnService ;
    icm:intentElements ex:exp-latency, ex:exp-packetloss, ex:topology, ex:cond-latency, ex:cond-packetloss ;
    evsla:forTenant ex:tenant ;
    rdfs:comment "Enterprise VPN hub-and-spoke SLA for tenant 映盛科技: latency p95 below 30 ms and packet loss p99 below 0.05% from 台北數據中心 to all spokes."@en .

ex:tenant
    a evsla:Tenant ;
    rdfs:label "映盛科技"@zh .

ex:exp-latency
    a icm:PropertyExpectation, evsla:SlaExpectation ;
    icm:target ex:tgt-latency ;
    evsla:hasMetric evsla:latency ;
    evsla:hasThreshold ex:thr-latency ;
    evsla:hasStatistic evsla:p95 ;
    evsla:hasScope evsla:hubToAllSpokes ;
    evsla:hasMeasurementMethod evsla:twamp ;
    evsla:hasTimeWindow evsla:fiveMinuteWindow .

ex:tgt-latency
    a icm:Target ;
    icm:valuesOfTargetProperty ex:thr-latency .

ex:thr-latency
    a quan:Quantity ;
    rdf:value "30"^^xsd:decimal ;
    quan:unit "ms" .

ex:exp-packetloss
    a icm:PropertyExpectation, evsla:SlaExpectation ;
    icm:target ex:tgt-packetloss ;
    evsla:hasMetric evsla:packetLoss ;
    evsla:hasThreshold ex:thr-packetloss ;
    evsla:hasStatistic evsla:p99 ;
    evsla:hasScope evsla:hubToAllSpokes ;
    evsla:hasMeasurementMethod evsla:twamp ;
    evsla:hasTimeWindow evsla:fiveMinuteWindow .

ex:tgt-packetloss
    a icm:Target ;
    icm:valuesOfTargetProperty ex:thr-packetloss .

ex:thr-packetloss
    a quan:Quantity ;
    rdf:value "0.05"^^xsd:decimal ;
    quan:unit "%" .

ex:topology
    a icm:Context, evsla:HubAndSpokeTopology ;
    evsla:hasHub ex:hub ;
    evsla:hasSpoke ex:spoke-1 .

ex:hub
    a evsla:HubSite ;
    rdfs:label "台北數據中心"@zh .

ex:spoke-1
    a evsla:SpokeSite ;
    rdfs:label "所有分點"@zh .

ex:cond-latency
    a log:Condition ;
    quan:smaller ( ex:obs-latency-value ex:thr-latency ) .

ex:obs-latency
    evsla:latency evsla:latency .

ex:obs-latency-value
    a quan:Quantity ;
    fun:valueOf ( ex:obs-latency ) .

ex:cond-packetloss
    a log:Condition ;
    quan:smaller ( ex:obs-packetloss-value ex:thr-packetloss ) .

ex:obs-packetloss
    evsla:packetLoss evsla:packetLoss .

ex:obs-packetloss-value
    a quan:Quantity ;
    fun:valueOf ( ex:obs-packetloss ) .