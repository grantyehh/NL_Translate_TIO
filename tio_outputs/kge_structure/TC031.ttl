@prefix ex: <http://example.org/tio-instance/tc031/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix ig: <http://tio.models.tmforum.org/tio/v3.6.0/IntentGuaranteeOntology/> .
@prefix imo: <http://tio.models.tmforum.org/tio/v3.6.0/IntentManagementOntology/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix mf: <http://tio.models.tmforum.org/tio/v3.6.0/MathFunctions/> .
@prefix set: <http://tio.models.tmforum.org/tio/v3.6.0/SetOperators/> .
@prefix pbi: <http://tio.models.tmforum.org/tio/v3.6.0/ProposalBestIntent/> .
@prefix insp: <http://tio.models.tmforum.org/tio/v3.6.0/IntentSpecification/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:intent
    a icm:Intent ;
    icm:intentElements ex:exp-latency, ex:exp-packetloss, ex:topology, ex:cond-latency, ex:cond-packetloss ;
    rdfs:comment "Hub-and-spoke enterprise VPN SLA: latency from Taipei data center to all spokes stays below 30 ms at p95, and packet loss stays below 0.05% at p95."@en .

ex:exp-latency
    a icm:PropertyExpectation ;
    icm:target ex:tgt-latency .

ex:tgt-latency
    a icm:Target ;
    evsla:latency evsla:latency ;
    icm:valuesOfTargetProperty ex:thr-latency ;
    evsla:hasThreshold ex:thr-latency ;
    evsla:p95 evsla:p95 ;
    evsla:twamp evsla:twamp ;
    evsla:hasTimeWindow evsla:oneHourWindow .

ex:thr-latency
    a quan:Quantity ;
    rdf:value 30 ;
    quan:unit "ms" .

ex:exp-packetloss
    a icm:PropertyExpectation ;
    icm:target ex:tgt-packetloss .

ex:tgt-packetloss
    a icm:Target ;
    evsla:packetLoss evsla:packetLoss ;
    icm:valuesOfTargetProperty ex:thr-packetloss ;
    evsla:hasThreshold ex:thr-packetloss ;
    evsla:p95 evsla:p95 ;
    evsla:twamp evsla:twamp ;
    evsla:hasTimeWindow evsla:oneHourWindow .

ex:thr-packetloss
    a quan:Quantity ;
    rdf:value 0.05 ;
    quan:unit "%" .

ex:cond-latency
    a log:Condition ;
    log:matchAll ( ex:obs-latency-value ex:thr-latency ) .

ex:obs-latency
    evsla:latency evsla:latency .

ex:obs-latency-value
    a quan:Quantity ;
    evsla:hasThreshold ( ex:obs-latency ) .

ex:cond-packetloss
    a log:Condition ;
    log:matchAll ( ex:obs-packetloss-value ex:thr-packetloss ) .

ex:obs-packetloss
    evsla:packetLoss evsla:packetLoss .

ex:obs-packetloss-value
    a quan:Quantity ;
    evsla:hasThreshold ( ex:obs-packetloss ) .

ex:topology
    a icm:Context ;
    ex:hub [ rdfs:label "台北數據中心"@zh ] ;
    ex:spoke [ rdfs:label "分點1"@zh ] ;
    ex:spoke [ rdfs:label "分點2"@zh ] ;
    ex:spoke [ rdfs:label "分點3"@zh ] .