@prefix ex: <http://example.org/tio-instance/tc014/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix met: <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:intent
  a icm:Intent, evsla:EnterpriseVpnService ;
  icm:intentElements ex:exp-packetloss, ex:topology, ex:cond-packetloss ;
  evsla:forTenant ex:tenant ;
  rdfs:comment "Ensure packet loss between the United Media hub and all spokes stays below 0.05% at the p99 level."@en .

ex:exp-packetloss
  a icm:PropertyExpectation, evsla:SlaExpectation ;
  icm:target ex:tgt-packetloss .

ex:tgt-packetloss
  a icm:Target ;
  evsla:hasMetric evsla:packetLoss ;
  icm:valuesOfTargetProperty ex:thr-packetloss ;
  evsla:hasThreshold ex:thr-packetloss ;
  evsla:hasStatistic evsla:p99 ;
  evsla:hasScope evsla:hubToAllSpokes ;
  evsla:hasMeasurementMethod evsla:twamp ;
  evsla:hasTimeWindow evsla:fiveMinuteWindow .

ex:thr-packetloss
  a quan:Quantity ;
  rdf:value "0.05"^^xsd:decimal ;
  quan:unit "%" .

ex:cond-packetloss
  a log:Condition ;
  quan:smaller ( ex:obs-packetloss-value ex:thr-packetloss ) .

ex:obs-packetloss
  evsla:hasMetric evsla:packetLoss .

ex:obs-packetloss-value
  a quan:Quantity ;
  fun:valueOf ( ex:obs-packetloss ) .

ex:topology
  a icm:Context, evsla:HubAndSpokeTopology ;
  evsla:hasHub ex:hub ;
  evsla:hasSpoke ex:spoke-1 .

ex:tenant
  a evsla:Tenant ;
  rdfs:label "聯合媒體"@zh .

ex:hub
  a evsla:HubSite ;
  rdfs:label "聯合媒體Hub"@zh .

ex:spoke-1
  a evsla:SpokeSite ;
  rdfs:label "各Spoke"@zh .