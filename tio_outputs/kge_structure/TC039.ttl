@prefix ex: <http://example.org/tio-instance/tc039/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix ig: <http://tio.models.tmforum.org/tio/v3.6.0/IntentGuaranteeOntology/> .
@prefix imo: <http://tio.models.tmforum.org/tio/v3.6.0/IntentManagementOntology/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix insp: <http://tio.models.tmforum.org/tio/v3.6.0/IntentSpecification/> .
@prefix mf: <http://tio.models.tmforum.org/tio/v3.6.0/MathFunctionslogistic> .
@prefix set: <http://tio.models.tmforum.org/tio/v3.6.0/SetOperators/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix pbi: <http://tio.models.tmforum.org/tio/v3.6.0/ProposalBestIntent/> .
@prefix met: <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix quan: <http://qudt.org/schema/qudt/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:intent
    a icm:Intent ;
    icm:intentElements ex:exp-latency, ex:topology, ex:cond-latency ;
    rdfs:comment "Taichung industrial headquarters to six plant spokes requires average latency below 80 ms within the monthly SLA window."@en .

ex:exp-latency
    a icm:PropertyExpectation ;
    icm:target ex:tgt-latency .

ex:tgt-latency
    a icm:Target ;
    evsla:serviceTarget ex:topology ;
    evsla:latency ex:latency-metric ;
    icm:valuesOfTargetProperty ex:thr-latency ;
    evsla:hasThreshold ex:thr-latency ;
    evsla:hasTimeWindow evsla:monthlySlaWindow ;
    evsla:hasMeasurementMethod evsla:twamp .

ex:latency-metric
    a rdf:Property .

ex:thr-latency
    a quan:Quantity ;
    rdf:value "80"^^xsd:decimal ;
    quan:unit "ms" .

ex:cond-latency
    a log:Condition ;
    log:noneOf ( ex:obs-latency-value ex:thr-latency ) .

ex:obs-latency
    met:observedMetric evsla:latency .

ex:obs-latency-value
    a quan:Quantity ;
    met:lastObserved ( ex:obs-latency ) .

ex:topology
    a icm:Context ;
    rdfs:comment "Hub-and-spoke topology with one hub and six spokes."@en ;
    evsla:serviceTarget ex:hub ;
    evsla:serviceTarget ex:spoke-1, ex:spoke-2, ex:spoke-3, ex:spoke-4, ex:spoke-5, ex:spoke-6 .

ex:hub
    rdfs:label "台中工業總部"@zh .

ex:spoke-1
    rdfs:label "廠區分點1"@zh .

ex:spoke-2
    rdfs:label "廠區分點2"@zh .

ex:spoke-3
    rdfs:label "廠區分點3"@zh .

ex:spoke-4
    rdfs:label "廠區分點4"@zh .

ex:spoke-5
    rdfs:label "廠區分點5"@zh .

ex:spoke-6
    rdfs:label "廠區分點6"@zh .