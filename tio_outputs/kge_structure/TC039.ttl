@prefix ex: <http://example.org/tio-instance/tc039/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix met: <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:intent
    a icm:Intent, evsla:SlaExpectation ;
    icm:intentElements ex:exp-latency, ex:topology, ex:cond-latency ;
    rdfs:comment "Taichung industrial headquarters to six plant spokes requires average latency below 80 ms within the monthly SLA window."@en .

ex:exp-latency
    a icm:PropertyExpectation, evsla:SlaExpectation ;
    icm:target ex:tgt-latency .

ex:tgt-latency
    a icm:Target ;
    evsla:hasMetric evsla:latency ;
    icm:valuesOfTargetProperty ex:thr-latency ;
    evsla:hasThreshold ex:thr-latency ;
    evsla:hasStatistic evsla:average ;
    evsla:hasScope evsla:hubToAllSpokes ;
    evsla:hasMeasurementMethod evsla:activeMeasurement ;
    evsla:hasTimeWindow evsla:monthlySlaWindow .

ex:thr-latency
    a quan:Quantity ;
    rdf:value "80"^^xsd:decimal ;
    quan:unit "ms" .

ex:cond-latency
    a log:Condition ;
    quan:smaller ( ex:obs-latency-value ex:thr-latency ) .

ex:obs-latency
    evsla:hasMetric evsla:latency ;
    evsla:hasThreshold ex:obs-latency-value .

ex:obs-latency-value
    a quan:Quantity .

ex:topology
    a icm:Context ;
    evsla:hubToAllSpokes ex:hub ;
    evsla:perSpoke ex:spoke1, ex:spoke2, ex:spoke3, ex:spoke4, ex:spoke5, ex:spoke6 .

ex:hub
    rdfs:label "台中工業總部"@zh .

ex:spoke1
    rdfs:label "廠區分點1"@zh .

ex:spoke2
    rdfs:label "廠區分點2"@zh .

ex:spoke3
    rdfs:label "廠區分點3"@zh .

ex:spoke4
    rdfs:label "廠區分點4"@zh .

ex:spoke5
    rdfs:label "廠區分點5"@zh .

ex:spoke6
    rdfs:label "廠區分點6"@zh .