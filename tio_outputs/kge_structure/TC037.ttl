@prefix ex: <http://example.org/tio-instance/tc037/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix met: <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:intent
    a icm:Intent, evsla:EnterpriseVpnService ;
    icm:intentElements ex:exp-packetLoss, ex:topology, ex:cond-packetLoss ;
    evsla:forTenant ex:tenant ;
    rdfs:comment "Shengde Logistics requires packet loss from the Linkou logistics headquarters to five spoke warehouses to stay at most 0.5% at the maximum level within each one-hour window."@en .

ex:tenant
    a evsla:Tenant ;
    rdfs:label "盛德物流"@zh .

ex:exp-packetLoss
    a icm:PropertyExpectation, evsla:SlaExpectation ;
    icm:target ex:tgt-packetLoss ;
    evsla:hasMetric evsla:packetLoss ;
    evsla:hasThreshold ex:thr-packetLoss ;
    evsla:hasStatistic evsla:maximum ;
    evsla:hasScope evsla:hubToAllSpokes ;
    evsla:hasMeasurementMethod evsla:twamp ;
    evsla:hasTimeWindow evsla:oneHourWindow .

ex:tgt-packetLoss
    a icm:Target ;
    icm:valuesOfTargetProperty ex:thr-packetLoss .

ex:thr-packetLoss
    a quan:Quantity ;
    rdf:value "0.5"^^xsd:decimal ;
    quan:unit "%" .

ex:cond-packetLoss
    a log:Condition ;
    quan:atMost ( ex:obs-packetLoss-value ex:thr-packetLoss ) .

ex:obs-packetLoss
    evsla:packetLoss evsla:packetLoss .

ex:obs-packetLoss-value
    a quan:Quantity ;
    fun:valueOf ( ex:obs-packetLoss ) .

ex:topology
    a icm:Context, evsla:HubAndSpokeTopology ;
    evsla:hasHub ex:hub ;
    evsla:hasSpoke ex:spoke-1, ex:spoke-2, ex:spoke-3, ex:spoke-4, ex:spoke-5 .

ex:hub
    a evsla:HubSite ;
    rdfs:label "林口物流總部"@zh .

ex:spoke-1
    a evsla:SpokeSite ;
    rdfs:label "分倉1"@zh .

ex:spoke-2
    a evsla:SpokeSite ;
    rdfs:label "分倉2"@zh .

ex:spoke-3
    a evsla:SpokeSite ;
    rdfs:label "分倉3"@zh .

ex:spoke-4
    a evsla:SpokeSite ;
    rdfs:label "分倉4"@zh .

ex:spoke-5
    a evsla:SpokeSite ;
    rdfs:label "分倉5"@zh .