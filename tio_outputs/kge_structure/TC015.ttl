@prefix ex: <http://example.org/tio-instance/tc015/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix ig: <http://tio.models.tmforum.org/tio/v3.6.0/IntentGuaranteeOntology/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix imo: <http://tio.models.tmforum.org/tio/v3.6.0/IntentManagementOntology/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix set: <http://tio.models.tmforum.org/tio/v3.6.0/SetOperators/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix met: <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix insp: <http://tio.models.tmforum.org/tio/v3.6.0/IntentSpecification/> .
@prefix pbi: <http://tio.models.tmforum.org/tio/v3.6.0/ProposalBestIntent/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:intent
    a icm:Intent, evsla:EnterpriseVpnService ;
    icm:intentElements ex:exp-bandwidth, ex:topology, ex:cond-bandwidth ;
    rdfs:comment "Provide guaranteed bandwidth of at least 300 Mbps from Asia Air Maintenance Headquarters to Xiaogang hangar."@en .

ex:exp-bandwidth
    a icm:PropertyExpectation ;
    icm:target ex:tgt-bandwidth .

ex:tgt-bandwidth
    a icm:Target ;
    met:observedMetric evsla:guaranteedBandwidth ;
    icm:valuesOfTargetProperty ex:thr-bandwidth ;
    evsla:hasThreshold ex:thr-bandwidth ;
    evsla:hasScope evsla:hubToAllSpokes .

ex:thr-bandwidth
    a quan:Quantity ;
    rdf:value 300 ;
    quan:unit "Mbps" .

ex:cond-bandwidth
    a log:Condition ;
    log:matchAll ( ex:obs-bandwidth-value ex:thr-bandwidth ) .

ex:obs-bandwidth
    met:observedMetric evsla:guaranteedBandwidth ;
    met:observedValue ( ex:obs-bandwidth ) .

ex:obs-bandwidth-value
    a quan:Quantity .

ex:topology
    a icm:Context ;
    evsla:hasSpoke ex:spoke-xiaogang ;
    rdfs:comment "Hub-and-spoke topology with one hub site and one spoke site."@en .

ex:hub-asia-air-maintenance-hq
    a evsla:HubSite ;
    rdfs:label "亞洲航空維修總部"@zh .

ex:spoke-xiaogang
    a evsla:Site ;
    rdfs:label "小港機棚"@zh .