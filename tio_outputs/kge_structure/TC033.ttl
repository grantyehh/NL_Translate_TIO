@prefix ex: <http://example.org/tio-instance/tc033/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix ig: <http://tio.models.tmforum.org/tio/v3.6.0/IntentGuaranteeOntology/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix met: <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix imo: <http://tio.models.tmforum.org/tio/v3.6.0/IntentManagementOntology/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix insp: <http://tio.models.tmforum.org/tio/v3.6.0/IntentSpecification/> .
@prefix set: <http://tio.models.tmforum.org/tio/v3.6.0/SetOperators/> .
@prefix pbi: <http://tio.models.tmforum.org/tio/v3.6.0/ProposalBestIntent/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:intent
    a icm:Intent, evsla:EnterpriseVpnService ;
    icm:intentElements ex:exp-latency, ex:exp-loss, ex:exp-bandwidth, ex:topology, ex:cond-latency, ex:cond-loss, ex:cond-bandwidth ;
    rdfs:comment "Enterprise VPN hub-and-spoke SLA from Taichung pharmaceutical plant headquarters to all branches: latency below 50 ms for 95% of time, packet loss below 0.1% for 99% of time, and guaranteed bandwidth at least 100 Mbps."@en .

ex:exp-latency
    a icm:PropertyExpectation ;
    icm:target ex:tgt-latency .

ex:tgt-latency
    a icm:Target ;
    met:observedMetric evsla:latency ;
    icm:valuesOfTargetProperty ex:thr-latency ;
    evsla:hasThreshold ex:thr-latency ;
    evsla:hasTimeWindow evsla:oneHourWindow .

ex:thr-latency
    a quan:Quantity ;
    rdf:value 50 ;
    quan:unit "ms" .

ex:exp-loss
    a icm:PropertyExpectation ;
    icm:target ex:tgt-loss .

ex:tgt-loss
    a icm:Target ;
    met:observedMetric evsla:packetLoss ;
    icm:valuesOfTargetProperty ex:thr-loss ;
    evsla:hasThreshold ex:thr-loss ;
    evsla:hasTimeWindow evsla:oneHourWindow .

ex:thr-loss
    a quan:Quantity ;
    rdf:value 0.1 ;
    quan:unit "%" .

ex:exp-bandwidth
    a icm:PropertyExpectation ;
    icm:target ex:tgt-bandwidth .

ex:tgt-bandwidth
    a icm:Target ;
    met:observedMetric evsla:guaranteedBandwidth ;
    icm:valuesOfTargetProperty ex:thr-bandwidth ;
    evsla:hasThreshold ex:thr-bandwidth ;
    evsla:hasTimeWindow evsla:oneHourWindow .

ex:thr-bandwidth
    a quan:Quantity ;
    rdf:value 100 ;
    quan:unit "Mbps" .

ex:cond-latency
    a log:Condition ;
    log:matchAll ( ex:obs-latency-value ex:thr-latency ) .

ex:obs-latency
    met:observedMetric evsla:latency ;
    ex:obs-latency-value ( ex:obs-latency ) .

ex:obs-latency-value
    a quan:Quantity .

ex:cond-loss
    a log:Condition ;
    log:matchAll ( ex:obs-loss-value ex:thr-loss ) .

ex:obs-loss
    met:observedMetric evsla:packetLoss ;
    ex:obs-loss-value ( ex:obs-loss ) .

ex:obs-loss-value
    a quan:Quantity .

ex:cond-bandwidth
    a log:Condition ;
    log:matchOne ( ex:obs-bandwidth-value ex:thr-bandwidth ) .

ex:obs-bandwidth
    met:observedMetric evsla:guaranteedBandwidth ;
    ex:obs-bandwidth-value ( ex:obs-bandwidth ) .

ex:obs-bandwidth-value
    a quan:Quantity .

ex:topology
    a evsla:HubAndSpokeTopology ;
    rdfs:comment "One hub in Taichung pharmaceutical plant headquarters connected to all branch spokes."@en ;
    ex:hub [ rdfs:label "台中藥廠總部"@zh ] ;
    ex:spoke [ rdfs:label "分點1"@zh ],
             [ rdfs:label "分點2"@zh ],
             [ rdfs:label "分點3"@zh ] .