@prefix ex: <http://example.org/tio-instance/tc027/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix met: <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:intent
    a icm:Intent, evsla:EnterpriseVpnService ;
    icm:intentElements ex:exp-latency, ex:exp-packetloss, ex:topology, ex:cond-latency, ex:cond-packetloss ;
    evsla:forTenant ex:tenant ;
    rdfs:comment "昇晟能源 requires latency below 20 ms at p99 from 台北能源調度中心 to 基隆電廠, and packet loss below 0.05% for 苗栗電廠 and 彰濱電廠 over a monthly SLA window."@en .

ex:tenant
    a evsla:Tenant ;
    rdfs:label "昇晟能源"@zh .

ex:exp-latency
    a icm:PropertyExpectation, evsla:SlaExpectation ;
    icm:target ex:tgt-latency .

ex:tgt-latency
    a icm:Target ;
    evsla:hasMetric evsla:latency ;
    icm:valuesOfTargetProperty ex:thr-latency ;
    evsla:hasThreshold ex:thr-latency ;
    evsla:hasStatistic evsla:p99 ;
    evsla:hasScope evsla:specificSpoke ;
    evsla:hasMeasurementMethod evsla:twamp ;
    evsla:hasTimeWindow evsla:fiveMinuteWindow .

ex:thr-latency
    a quan:Quantity ;
    rdf:value "20"^^xsd:decimal ;
    quan:unit "ms" .

ex:exp-packetloss
    a icm:PropertyExpectation, evsla:SlaExpectation ;
    icm:target ex:tgt-packetloss .

ex:tgt-packetloss
    a icm:Target ;
    evsla:hasMetric evsla:packetLoss ;
    icm:valuesOfTargetProperty ex:thr-packetloss ;
    evsla:hasThreshold ex:thr-packetloss ;
    evsla:hasStatistic evsla:p99 ;
    evsla:hasScope evsla:perSpoke ;
    evsla:hasMeasurementMethod evsla:twamp ;
    evsla:hasTimeWindow evsla:monthlySlaWindow .

ex:thr-packetloss
    a quan:Quantity ;
    rdf:value "0.05"^^xsd:decimal ;
    quan:unit "%" .

ex:cond-latency
    a log:Condition ;
    quan:smaller ( ex:obs-latency-value ex:thr-latency ) .

ex:obs-latency
    evsla:hasMetric evsla:latency .

ex:obs-latency-value
    a quan:Quantity ;
    fun:valueOf ( ex:obs-latency ) .

ex:cond-packetloss
    a log:Condition ;
    quan:smaller ( ex:obs-packetloss-value ex:thr-packetloss ) .

ex:obs-packetloss
    evsla:hasMetric evsla:packetLoss .

ex:obs-packetloss-value
    a quan:Quantity ;
    fun:valueOf ( ex:obs-packetloss ) .

ex:topology
    a icm:Context, evsla:HubAndSpokeTopology ;
    evsla:hasHub ex:hub ;
    evsla:hasSpoke ex:spoke-keelung, ex:spoke-miaoli, ex:spoke-changbin .

ex:hub
    a evsla:HubSite ;
    rdfs:label "台北能源調度中心"@zh .

ex:spoke-keelung
    a evsla:SpokeSite ;
    rdfs:label "基隆電廠"@zh .

ex:spoke-miaoli
    a evsla:SpokeSite ;
    rdfs:label "苗栗電廠"@zh .

ex:spoke-changbin
    a evsla:SpokeSite ;
    rdfs:label "彰濱電廠"@zh .