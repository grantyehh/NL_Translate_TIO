@prefix ex: <http://example.org/tio-instance/tc027/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix ig: <http://tio.models.tmforum.org/tio/v3.6.0/IntentGuaranteeOntology/> .
@prefix imo: <http://tio.models.tmforum.org/tio/v3.6.0/IntentManagementOntology/> .
@prefix met: <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix mf: <http://tio.models.tmforum.org/tio/v3.6.0/MathFunctionsinput> .
@prefix insp: <http://tio.models.tmforum.org/tio/v3.6.0/IntentSpecification/> .
@prefix set: <http://tio.models.tmforum.org/tio/v3.6.0/SetOperators/> .
@prefix pbi: <http://tio.models.tmforum.org/tio/v3.6.0/ProposalBestIntent/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:intent
    a icm:Intent, evsla:EnterpriseVpnService ;
    icm:intentElements ex:exp-latency, ex:exp-packetloss, ex:topology, ex:cond-latency, ex:cond-packetloss ;
    rdfs:comment "Taipei energy dispatch center to Keelung power plant latency below 20 ms at p99, and to Miaoli and Changbin power plants packet loss below 0.05% at p99."@en .

ex:exp-latency
    a icm:PropertyExpectation ;
    icm:target ex:tgt-latency .

ex:tgt-latency
    a icm:Target ;
    met:observedMetric evsla:latency ;
    icm:valuesOfTargetProperty ex:thr-latency ;
    evsla:hasThreshold ex:thr-latency ;
    evsla:p99 evsla:p99 .

ex:thr-latency
    a quan:Quantity ;
    rdf:value 20 ;
    quan:unit "ms" .

ex:exp-packetloss
    a icm:PropertyExpectation ;
    icm:target ex:tgt-packetloss .

ex:tgt-packetloss
    a icm:Target ;
    met:observedMetric evsla:packetLoss ;
    icm:valuesOfTargetProperty ex:thr-packetloss ;
    evsla:hasThreshold ex:thr-packetloss ;
    evsla:p99 evsla:p99 .

ex:thr-packetloss
    a quan:Quantity ;
    rdf:value 0.05 ;
    quan:unit "%" .

ex:cond-latency
    a log:Condition ;
    log:noneOf ( ex:obs-latency-value ex:thr-latency ) .

ex:obs-latency
    a met:Observation ;
    met:observedMetric evsla:latency ;
    ex:obs-latency-value ex:obs-latency .

ex:obs-latency-value
    a quan:Quantity .

ex:cond-packetloss
    a log:Condition ;
    log:noneOf ( ex:obs-packetloss-value ex:thr-packetloss ) .

ex:obs-packetloss
    a met:Observation ;
    met:observedMetric evsla:packetLoss ;
    ex:obs-packetloss-value ex:obs-packetloss .

ex:obs-packetloss-value
    a quan:Quantity .

ex:topology
    a icm:Context ;
    ex:hub [ rdfs:label "台北能源調度中心"@zh ] ;
    ex:spoke [ rdfs:label "基隆電廠"@zh ] ;
    ex:spoke [ rdfs:label "苗栗電廠"@zh ] ;
    ex:spoke [ rdfs:label "彰濱電廠"@zh ] .