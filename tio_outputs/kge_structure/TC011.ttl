@prefix ex: <http://example.org/tio-instance/tc011/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix quan: <http://qudt.org/schema/qudt/> .
@prefix met: <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .

ex:intent
    a icm:Intent ;
    icm:intentElements ex:exp-packetloss, ex:topology, ex:cond-packetloss ;
    rdfs:comment "Ensure packet loss between the City Transportation Bureau hub and all spokes stays below 0.2% at the p99 level."@en .

ex:exp-packetloss
    a icm:PropertyExpectation ;
    icm:target ex:tgt-packetloss .

ex:tgt-packetloss
    a icm:Target ;
    evsla:packetLoss evsla:packetLoss ;
    icm:valuesOfTargetProperty ex:thr-packetloss ;
    met:observedValue ex:thr-packetloss ;
    evsla:hubToAllSpokes evsla:hubToAllSpokes ;
    evsla:p99 evsla:p99 .

ex:thr-packetloss
    a quan:Quantity ;
    rdf:value 0.2 ;
    quan:unit "%" .

ex:cond-packetloss
    a log:Condition ;
    log:lessThan ( ex:obs-packetloss-value ex:thr-packetloss ) .

ex:obs-packetloss
    evsla:packetLoss evsla:packetLoss .

ex:obs-packetloss-value
    a quan:Quantity ;
    met:observedValue ( ex:obs-packetloss ) .

ex:topology
    a evsla:HubAndSpokeTopology ;
    evsla:hasHub ex:hub ;
    evsla:hasSpoke ex:spoke-1 .

ex:hub
    a evsla:HubSite ;
    rdfs:label "城市交通局Hub"@zh .

ex:spoke-1
    a evsla:SpokeSite ;
    rdfs:label "Spoke"@en .