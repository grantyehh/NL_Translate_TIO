@prefix ex: <http://example.org/tio-instance/tc021/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix met: <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:intent
    a icm:Intent, evsla:EnterpriseVpnService ;
    icm:intentElements ex:exp-latency-taoyuan, ex:exp-latency-tainan, ex:topology, ex:cond-latency-taoyuan, ex:cond-latency-tainan ;
    evsla:forTenant ex:tenant ;
    rdfs:comment "Hongyuan Technology requires latency from Taipei headquarters to Taoyuan plant and Tainan plant to stay below 40 ms at the 95th percentile for each spoke."@en .

ex:tenant
    a evsla:Tenant ;
    rdfs:label "宏遠科技"@zh .

ex:exp-latency-taoyuan
    a icm:PropertyExpectation, evsla:SlaExpectation ;
    icm:target ex:tgt-latency-taoyuan .

ex:tgt-latency-taoyuan
    a icm:Target ;
    evsla:hasMetric evsla:latency ;
    icm:valuesOfTargetProperty ex:thr-latency ;
    evsla:hasThreshold ex:thr-latency ;
    evsla:hasStatistic evsla:p95 ;
    evsla:hasScope evsla:specificSpoke ;
    evsla:hasMeasurementMethod evsla:twamp ;
    evsla:hasTimeWindow evsla:fiveMinuteWindow .

ex:exp-latency-tainan
    a icm:PropertyExpectation, evsla:SlaExpectation ;
    icm:target ex:tgt-latency-tainan .

ex:tgt-latency-tainan
    a icm:Target ;
    evsla:hasMetric evsla:latency ;
    icm:valuesOfTargetProperty ex:thr-latency ;
    evsla:hasThreshold ex:thr-latency ;
    evsla:hasStatistic evsla:p95 ;
    evsla:hasScope evsla:specificSpoke ;
    evsla:hasMeasurementMethod evsla:twamp ;
    evsla:hasTimeWindow evsla:fiveMinuteWindow .

ex:thr-latency
    a quan:Quantity ;
    rdf:value "40"^^xsd:decimal ;
    quan:unit "ms" .

ex:cond-latency-taoyuan
    a log:Condition ;
    quan:smaller ( ex:obs-latency-taoyuan-value ex:thr-latency ) .

ex:obs-latency-taoyuan
    met:latency evsla:latency ;
    ex:obs-latency-taoyuan-value ( ex:obs-latency-taoyuan ) .

ex:obs-latency-taoyuan-value
    a quan:Quantity .

ex:cond-latency-tainan
    a log:Condition ;
    quan:smaller ( ex:obs-latency-tainan-value ex:thr-latency ) .

ex:obs-latency-tainan
    met:latency evsla:latency ;
    ex:obs-latency-tainan-value ( ex:obs-latency-tainan ) .

ex:obs-latency-tainan-value
    a quan:Quantity .

ex:topology
    a icm:Context, evsla:HubAndSpokeTopology ;
    evsla:hasHub ex:hub-taipei ;
    evsla:hasSpoke ex:spoke-taoyuan, ex:spoke-tainan .

ex:hub-taipei
    a evsla:HubSite ;
    rdfs:label "台北總部"@zh .

ex:spoke-taoyuan
    a evsla:SpokeSite ;
    rdfs:label "桃園廠"@zh .

ex:spoke-tainan
    a evsla:SpokeSite ;
    rdfs:label "台南廠"@zh .