@prefix ex: <http://example.org/tio-instance/tc032/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix ig: <http://tio.models.tmforum.org/tio/v3.6.0/IntentGuaranteeOntology/> .
@prefix imo: <http://tio.models.tmforum.org/tio/v3.6.0/IntentManagementOntology/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix set: <http://tio.models.tmforum.org/tio/v3.6.0/SetOperators/> .
@prefix pbi: <http://tio.models.tmforum.org/tio/v3.6.0/ProposalBestIntent/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix met: <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix mf: <http://tio.models.tmforum.org/tio/v3.6.0/MathFunctions> .

ex:intent
    a icm:Intent, evsla:EnterpriseVpnSlaIntent ;
    icm:intentElements ex:exp-latency, ex:exp-bandwidth, ex:topology, ex:cond-latency, ex:cond-bandwidth ;
    rdfs:comment "Xinqiao Financial requires latency from Xinyi Financial headquarters to all trading rooms to stay below 15 ms for 99% of the time, and guaranteed bandwidth to be no less than 500 Mbps."@en .

ex:exp-latency
    a icm:PropertyExpectation ;
    icm:target ex:tgt-latency .

ex:tgt-latency
    a icm:Target ;
    evsla:serviceTarget ex:topology ;
    icm:valuesOfTargetProperty ex:thr-latency ;
    evsla:hasThreshold ex:thr-latency .

ex:thr-latency
    a quan:Quantity ;
    rdf:value 15 ;
    quan:unit "ms" .

ex:exp-bandwidth
    a icm:PropertyExpectation ;
    icm:target ex:tgt-bandwidth .

ex:tgt-bandwidth
    a icm:Target ;
    evsla:serviceTarget ex:topology ;
    evsla:guaranteedBandwidth ex:thr-bandwidth ;
    icm:valuesOfTargetProperty ex:thr-bandwidth .

ex:thr-bandwidth
    a quan:Quantity ;
    rdf:value 500 ;
    quan:unit "Mbps" .

ex:cond-latency
    a log:Condition ;
    log:oneOf ( ex:obs-latency-value ex:thr-latency ) .

ex:obs-latency
    met:observedMetric ex:tgt-latency .

ex:obs-latency-value
    a quan:Quantity .

ex:cond-bandwidth
    a log:Condition ;
    log:matchOne ( ex:obs-bandwidth-value ex:thr-bandwidth ) .

ex:obs-bandwidth
    met:observedMetric evsla:guaranteedBandwidth .

ex:obs-bandwidth-value
    a quan:Quantity .

ex:topology
    a icm:Context ;
    ex:hub [ rdfs:label "信義金融總部"@zh ] ;
    ex:spoke [ rdfs:label "交易室1"@zh ] ;
    ex:spoke [ rdfs:label "交易室2"@zh ] ;
    ex:spoke [ rdfs:label "交易室3"@zh ] .