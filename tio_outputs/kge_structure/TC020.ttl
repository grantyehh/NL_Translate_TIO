@prefix ex: <http://example.org/tio-instance/tc020/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix met: <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:intent a icm:Intent, evsla:SlaExpectation ;
  icm:intentElements ex:exp-latency, ex:exp-packetloss, ex:topology, ex:cond-latency, ex:cond-packetloss ;
  rdfs:comment "Ensure latency from the Taipei R&D headquarters hub to the Hsinchu lab and Tainan manufacturing plant stays below 35 ms at p95, and packet loss between the hub and each spoke stays below 0.05% at p99."@en .

ex:exp-latency a icm:PropertyExpectation, evsla:SlaExpectation ;
  icm:target ex:tgt-latency ;
  evsla:hasMetric evsla:latency ;
  evsla:hasThreshold ex:thr-latency ;
  evsla:hasStatistic evsla:p95 ;
  evsla:hasScope evsla:hubToAllSpokes ;
  evsla:hasMeasurementMethod evsla:activeMeasurement ;
  evsla:hasTimeWindow evsla:monthlySlaWindow .

ex:tgt-latency a icm:Target ;
  evsla:hasMetric evsla:latency ;
  icm:valuesOfTargetProperty ex:thr-latency ;
  evsla:hasThreshold ex:thr-latency ;
  evsla:hasStatistic evsla:p95 ;
  evsla:hasScope evsla:hubToAllSpokes ;
  evsla:hasMeasurementMethod evsla:activeMeasurement ;
  evsla:hasTimeWindow evsla:monthlySlaWindow .

ex:thr-latency a quan:Quantity ;
  rdf:value "35"^^xsd:decimal ;
  quan:unit "ms" .

ex:exp-packetloss a icm:PropertyExpectation, evsla:SlaExpectation ;
  icm:target ex:tgt-packetloss ;
  evsla:hasMetric evsla:packetLoss ;
  evsla:hasThreshold ex:thr-packetloss ;
  evsla:hasStatistic evsla:p99 ;
  evsla:hasScope evsla:perSpoke ;
  evsla:hasMeasurementMethod evsla:activeMeasurement ;
  evsla:hasTimeWindow evsla:monthlySlaWindow .

ex:tgt-packetloss a icm:Target ;
  evsla:hasMetric evsla:packetLoss ;
  icm:valuesOfTargetProperty ex:thr-packetloss ;
  evsla:hasThreshold ex:thr-packetloss ;
  evsla:hasStatistic evsla:p99 ;
  evsla:hasScope evsla:perSpoke ;
  evsla:hasMeasurementMethod evsla:activeMeasurement ;
  evsla:hasTimeWindow evsla:monthlySlaWindow .

ex:thr-packetloss a quan:Quantity ;
  rdf:value "0.05"^^xsd:decimal ;
  quan:unit "%" .

ex:cond-latency a log:Condition ;
  quan:smaller ( ex:obs-latency-value ex:thr-latency ) .

ex:obs-latency evsla:latency evsla:latency ;
  ex:obs-latency-value ex:obs-latency .

ex:obs-latency-value a quan:Quantity .

ex:cond-packetloss a log:Condition ;
  quan:smaller ( ex:obs-packetloss-value ex:thr-packetloss ) .

ex:obs-packetloss evsla:packetLoss evsla:packetLoss ;
  ex:obs-packetloss-value ex:obs-packetloss .

ex:obs-packetloss-value a quan:Quantity .

ex:topology a icm:Context ;
  evsla:hubToAllSpokes ex:site-taipei-hq ;
  evsla:perSpoke ex:site-hsinchu-lab, ex:site-tainan-plant .

ex:site-taipei-hq rdfs:label "精準醫材台北研發總部"@zh .
ex:site-hsinchu-lab rdfs:label "竹北實驗室"@zh .
ex:site-tainan-plant rdfs:label "台南製造廠"@zh .