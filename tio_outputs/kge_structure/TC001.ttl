@prefix ex: <http://example.org/tio-instance/tc001/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix ig: <http://tio.models.tmforum.org/tio/v3.6.0/IntentGuaranteeOntology/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix met: <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix pbi: <http://tio.models.tmforum.org/tio/v3.6.0/ProposalBestIntent/> .
@prefix imo: <http://tio.models.tmforum.org/tio/v3.6.0/IntentManagementOntology/> .
@prefix insp: <http://tio.models.tmforum.org/tio/v3.6.0/IntentSpecification/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix set: <http://tio.models.tmforum.org/tio/v3.6.0/SetOperators/> .
@prefix mf: <http://tio.models.tmforum.org/tio/v3.6.0/MathFunctions> .

ex:intent
    a icm:Intent, evsla:EnterpriseVpnService ;
    icm:intentElements ex:exp-latency, ex:topology, ex:cond-latency ;
    rdfs:comment "Ensure latency from Galaxy Bank headquarters to all branches stays below 50 ms for 95% of the time."@en .

ex:exp-latency
    a icm:PropertyExpectation ;
    icm:target ex:tgt-latency .

ex:tgt-latency
    a icm:Target ;
    met:observedMetric evsla:hasThreshold ;
    icm:valuesOfTargetProperty ex:thr-latency ;
    evsla:hasThreshold ex:thr-latency ;
    evsla:hasScope evsla:HubAndSpokeTopology ;
    ig:guaranteePeriod evsla:oneHourWindow .

ex:thr-latency
    a quan:Quantity ;
    rdf:value 50 ;
    quan:unit "ms" .

ex:cond-latency
    a log:Condition ;
    rdfs:comment "Latency shall be below 50 ms for 95% of the time."@en .

ex:obs-latency
    met:observedMetric evsla:hasThreshold .

ex:obs-latency-value
    a quan:Quantity .

ex:topology
    a evsla:HubAndSpokeTopology ;
    rdfs:comment "Hub-and-spoke topology with one headquarters hub and branch spokes."@en ;
    evsla:hasScope ex:hub-site, ex:spoke-1, ex:spoke-2, ex:spoke-3 .

ex:hub-site
    rdfs:label "星河銀行總部"@zh .

ex:spoke-1
    rdfs:label "分點1"@zh .

ex:spoke-2
    rdfs:label "分點2"@zh .

ex:spoke-3
    rdfs:label "分點3"@zh .