@prefix ex: <http://example.org/tio-instance/tc024/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix met: <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix imo: <http://tio.models.tmforum.org/tio/v3.6.0/IntentManagementOntology/> .
@prefix mf: <http://tio.models.tmforum.org/tio/v3.6.0/MathFunctions/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix pbi: <http://tio.models.tmforum.org/tio/v3.6.0/ProposalBestIntent/> .
@prefix insp: <http://tio.models.tmforum.org/tio/v3.6.0/IntentSpecification/> .
@prefix ig: <http://tio.models.tmforum.org/tio/v3.6.0/IntentGuaranteeOntology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:intent
    a icm:Intent ;
    icm:intentElements ex:exp-latency-xinying, ex:exp-latency-madou, ex:exp-latency-yujing, ex:topology ;
    rdfs:comment "Fengmao Agriculture requires latency from Chiayi Agricultural Information Center to Xinying Farm, Madou Farm, and Yujing Farm to stay below 70 ms for each spoke at the 95% level."@en .

ex:exp-latency-xinying
    a icm:PropertyExpectation ;
    icm:target ex:tgt-latency-xinying .

ex:tgt-latency-xinying
    a icm:Target ;
    evsla:latency ex:metric-latency-xinying ;
    icm:valuesOfTargetProperty ex:thr-latency ;
    evsla:hasThreshold ex:thr-latency ;
    rdfs:comment "Latency target for Chiayi Agricultural Information Center to Xinying Farm."@en .

ex:exp-latency-madou
    a icm:PropertyExpectation ;
    icm:target ex:tgt-latency-madou .

ex:tgt-latency-madou
    a icm:Target ;
    evsla:latency ex:metric-latency-madou ;
    icm:valuesOfTargetProperty ex:thr-latency ;
    evsla:hasThreshold ex:thr-latency ;
    rdfs:comment "Latency target for Chiayi Agricultural Information Center to Madou Farm."@en .

ex:exp-latency-yujing
    a icm:PropertyExpectation ;
    icm:target ex:tgt-latency-yujing .

ex:tgt-latency-yujing
    a icm:Target ;
    evsla:latency ex:metric-latency-yujing ;
    icm:valuesOfTargetProperty ex:thr-latency ;
    evsla:hasThreshold ex:thr-latency ;
    rdfs:comment "Latency target for Chiayi Agricultural Information Center to Yujing Farm."@en .

ex:thr-latency
    a quan:Quantity ;
    rdf:value "70"^^xsd:decimal ;
    quan:unit "ms" .

ex:metric-latency-xinying
    a met:Metric ;
    rdfs:label "latency between Chiayi Agricultural Information Center and Xinying Farm at 95% level"@en .

ex:metric-latency-madou
    a met:Metric ;
    rdfs:label "latency between Chiayi Agricultural Information Center and Madou Farm at 95% level"@en .

ex:metric-latency-yujing
    a met:Metric ;
    rdfs:label "latency between Chiayi Agricultural Information Center and Yujing Farm at 95% level"@en .

ex:topology
    a icm:Context ;
    rdfs:comment "Hub-and-spoke topology with one hub and three spokes."@en ;
    rdfs:member ex:hub, ex:spoke-xinying, ex:spoke-madou, ex:spoke-yujing .

ex:hub
    rdfs:label "嘉義農業資訊中心"@zh .

ex:spoke-xinying
    rdfs:label "新營農場"@zh .

ex:spoke-madou
    rdfs:label "麻豆農場"@zh .

ex:spoke-yujing
    rdfs:label "玉井農場"@zh .