@prefix icm:   <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix quan:  <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex:    <http://example.org/tio-instance/tc020/> .

ex:intent a icm:Intent, evsla:EnterpriseVpnSlaIntent ;
  icm:intentElements ex:exp-latency, ex:exp-packet-loss, ex:topology ;
  rdfs:comment "Assure latency and packet loss SLA hub-to-all-spokes for 精準醫材 enterprise VPN."@en .

ex:tenant a evsla:Tenant ;
  rdfs:label "精準醫材"@zh .

ex:service a evsla:EnterpriseVpnService ;
  evsla:forTenant ex:tenant .

ex:exp-latency a icm:PropertyExpectation, evsla:SlaExpectation ;
  icm:target ex:tgt-latency ;
  rdfs:comment "Latency must stay below 35 ms at p95 across all spokes."@en .

ex:tgt-latency a icm:Target ;
  evsla:hasMetric evsla:latency ;
  icm:valuesOfTargetProperty [ a quan:Quantity ; rdf:value 35 ; quan:unit "ms" ] ;
  evsla:hasThreshold [ a quan:Quantity ; rdf:value 35 ; quan:unit "ms" ] ;
  evsla:hasStatistic evsla:p95 ;
  evsla:hasScope evsla:hubToAllSpokes ;
  evsla:hasMeasurementMethod evsla:twamp ;
  evsla:hasTimeWindow evsla:fiveMinuteWindow .

ex:exp-packet-loss a icm:PropertyExpectation, evsla:SlaExpectation ;
  icm:target ex:tgt-packet-loss ;
  rdfs:comment "Packet loss must stay below 0.05% at p99 across all spokes."@en .

ex:tgt-packet-loss a icm:Target ;
  evsla:hasMetric evsla:packetLoss ;
  icm:valuesOfTargetProperty [ a quan:Quantity ; rdf:value 0.05 ; quan:unit "%" ] ;
  evsla:hasThreshold [ a quan:Quantity ; rdf:value 0.05 ; quan:unit "%" ] ;
  evsla:hasStatistic evsla:p99 ;
  evsla:hasScope evsla:hubToAllSpokes ;
  evsla:hasMeasurementMethod evsla:twamp ;
  evsla:hasTimeWindow evsla:fiveMinuteWindow .

ex:topology a icm:Context, evsla:HubAndSpokeTopology ;
  evsla:hasHub [ a evsla:HubSite ; rdfs:label "台北研發總部"@zh ] ;
  evsla:hasSpoke [ a evsla:SpokeSite ; rdfs:label "竹北實驗室"@zh ] ;
  evsla:hasSpoke [ a evsla:SpokeSite ; rdfs:label "台南製造廠"@zh ] .