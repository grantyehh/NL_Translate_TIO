@prefix ex: <http://example.org/tio-instance/tc028/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix met: <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:intent
    a icm:Intent, evsla:EnterpriseVpnService ;
    icm:intentElements ex:exp-taichung, ex:exp-kaohsiung, ex:topology, ex:cond-taichung, ex:cond-kaohsiung ;
    evsla:forTenant ex:tenant ;
    rdfs:comment "亞翔科技 requires guaranteed bandwidth from 新竹總部 to 台中研發中心 at least 200 Mbps and to 高雄測試中心 at least 100 Mbps."@en .

ex:tenant
    a evsla:Tenant ;
    rdfs:label "亞翔科技"@zh .

ex:topology
    a icm:Context, evsla:HubAndSpokeTopology ;
    evsla:hasHub ex:hub ;
    evsla:hasSpoke ex:spoke-taichung, ex:spoke-kaohsiung .

ex:hub
    a evsla:HubSite ;
    rdfs:label "新竹總部"@zh .

ex:spoke-taichung
    a evsla:SpokeSite ;
    rdfs:label "台中研發中心"@zh .

ex:spoke-kaohsiung
    a evsla:SpokeSite ;
    rdfs:label "高雄測試中心"@zh .

ex:exp-taichung
    a icm:PropertyExpectation, evsla:SlaExpectation ;
    icm:target ex:tgt-taichung .

ex:tgt-taichung
    a icm:Target ;
    evsla:hasMetric evsla:guaranteedBandwidth ;
    icm:valuesOfTargetProperty ex:thr-taichung ;
    evsla:hasThreshold ex:thr-taichung ;
    evsla:hasStatistic evsla:minimum ;
    evsla:hasScope evsla:specificSpoke ;
    evsla:hasMeasurementMethod evsla:activeMeasurement ;
    evsla:hasTimeWindow evsla:fiveMinuteWindow .

ex:thr-taichung
    a quan:Quantity ;
    rdf:value "200"^^xsd:decimal ;
    quan:unit "Mbps" .

ex:cond-taichung
    a log:Condition ;
    quan:atLeast ( ex:obs-taichung-value ex:thr-taichung ) .

ex:obs-taichung
    evsla:hasMetric evsla:guaranteedBandwidth .

ex:obs-taichung-value
    a quan:Quantity ;
    fun:valueOf ( ex:obs-taichung ) .

ex:exp-kaohsiung
    a icm:PropertyExpectation, evsla:SlaExpectation ;
    icm:target ex:tgt-kaohsiung .

ex:tgt-kaohsiung
    a icm:Target ;
    evsla:hasMetric evsla:guaranteedBandwidth ;
    icm:valuesOfTargetProperty ex:thr-kaohsiung ;
    evsla:hasThreshold ex:thr-kaohsiung ;
    evsla:hasStatistic evsla:minimum ;
    evsla:hasScope evsla:specificSpoke ;
    evsla:hasMeasurementMethod evsla:activeMeasurement ;
    evsla:hasTimeWindow evsla:fiveMinuteWindow .

ex:thr-kaohsiung
    a quan:Quantity ;
    rdf:value "100"^^xsd:decimal ;
    quan:unit "Mbps" .

ex:cond-kaohsiung
    a log:Condition ;
    quan:atLeast ( ex:obs-kaohsiung-value ex:thr-kaohsiung ) .

ex:obs-kaohsiung
    evsla:hasMetric evsla:guaranteedBandwidth .

ex:obs-kaohsiung-value
    a quan:Quantity ;
    fun:valueOf ( ex:obs-kaohsiung ) .