@prefix ex: <http://example.org/tio-instance/tc036/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix met: <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:intent
    a icm:Intent, evsla:SlaExpectation ;
    icm:intentElements ex:exp-latency, ex:topology, ex:cond-latency ;
    rdfs:comment "Taipei headquarters distribution center to six store spokes shall maintain average latency below 60 ms in a one-hour window."@en .

ex:exp-latency
    a icm:PropertyExpectation, evsla:SlaExpectation ;
    icm:target ex:tgt-latency ;
    evsla:hasMetric evsla:latency ;
    evsla:hasThreshold ex:thr-latency ;
    evsla:hasStatistic evsla:average ;
    evsla:hasScope evsla:hubToAllSpokes ;
    evsla:hasMeasurementMethod evsla:twamp ;
    evsla:hasTimeWindow evsla:oneHourWindow .

ex:tgt-latency
    a icm:Target ;
    evsla:hasMetric evsla:latency ;
    icm:valuesOfTargetProperty ex:thr-latency ;
    evsla:hasThreshold ex:thr-latency ;
    evsla:hasStatistic evsla:average ;
    evsla:hasScope evsla:hubToAllSpokes ;
    evsla:hasMeasurementMethod evsla:twamp ;
    evsla:hasTimeWindow evsla:oneHourWindow .

ex:thr-latency
    a quan:Quantity ;
    rdf:value "60"^^xsd:decimal ;
    quan:unit "ms" .

ex:cond-latency
    a log:Condition ;
    quan:smaller ( ex:obs-latency-value ex:thr-latency ) .

ex:obs-latency
    evsla:hasMetric evsla:latency ;
    met:observedValue ( ex:obs-latency ) .

ex:obs-latency-value
    a quan:Quantity .

ex:topology
    a icm:Context ;
    evsla:hubToAllSpokes ex:hub-site ;
    rdfs:comment "One hub in Taipei and six spoke store sites."@en .

ex:hub-site
    rdfs:label "台北總部配送中心"@zh .

ex:spoke-1
    rdfs:label "門市分點1"@zh .

ex:spoke-2
    rdfs:label "門市分點2"@zh .

ex:spoke-3
    rdfs:label "門市分點3"@zh .

ex:spoke-4
    rdfs:label "門市分點4"@zh .

ex:spoke-5
    rdfs:label "門市分點5"@zh .

ex:spoke-6
    rdfs:label "門市分點6"@zh .