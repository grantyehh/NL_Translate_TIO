@prefix ex: <http://example.org/tio-instance/tc036/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix met: <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:intent
    a icm:Intent, evsla:EnterpriseVpnService ;
    icm:intentElements ex:exp-latency, ex:topology, ex:cond-latency ;
    evsla:forTenant ex:tenant ;
    rdfs:comment "Tenant requires hub-to-all-spokes average latency to stay below 60 ms in a one-hour window."@en .

ex:tenant
    a evsla:Tenant ;
    rdfs:label "全台連鎖超市"@zh .

ex:exp-latency
    a icm:PropertyExpectation, evsla:SlaExpectation ;
    icm:target ex:tgt-latency .

ex:tgt-latency
    a icm:Target ;
    evsla:hasMetric evsla:latency ;
    icm:valuesOfTargetProperty ex:thr-latency ;
    evsla:hasThreshold ex:thr-latency ;
    evsla:hasStatistic evsla:average ;
    evsla:hasScope evsla:hubToAllSpokes ;
    evsla:hasMeasurementMethod evsla:twamp ;
    evsla:hasTimeWindow evsla:oneHourWindow .

ex:thr-latency
    a quan:Quantity ;
    rdf:value "60"^^xsd:decimal ;
    quan:unit "ms" .

ex:cond-latency
    a log:Condition ;
    quan:smaller ( ex:obs-latency-value ex:thr-latency ) .

ex:obs-latency
    evsla:hasMetric evsla:latency .

ex:obs-latency-value
    a quan:Quantity ;
    fun:valueOf ( ex:obs-latency ) .

ex:topology
    a icm:Context, evsla:HubAndSpokeTopology ;
    evsla:hasHub ex:hub ;
    evsla:hasSpoke ex:spoke-1, ex:spoke-2, ex:spoke-3, ex:spoke-4, ex:spoke-5, ex:spoke-6 .

ex:hub
    a evsla:HubSite ;
    rdfs:label "台北總部配送中心"@zh .

ex:spoke-1
    a evsla:SpokeSite ;
    rdfs:label "門市分點1"@zh .

ex:spoke-2
    a evsla:SpokeSite ;
    rdfs:label "門市分點2"@zh .

ex:spoke-3
    a evsla:SpokeSite ;
    rdfs:label "門市分點3"@zh .

ex:spoke-4
    a evsla:SpokeSite ;
    rdfs:label "門市分點4"@zh .

ex:spoke-5
    a evsla:SpokeSite ;
    rdfs:label "門市分點5"@zh .

ex:spoke-6
    a evsla:SpokeSite ;
    rdfs:label "門市分點6"@zh .