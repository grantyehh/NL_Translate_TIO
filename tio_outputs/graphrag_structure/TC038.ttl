@prefix ex: <http://example.org/tio-instance/tc038/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix met: <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:intent
    a icm:Intent, evsla:SlaExpectation ;
    icm:intentElements ex:exp-bandwidth, ex:topology, ex:cond-bandwidth ;
    rdfs:comment "Ensure the minimum guaranteed bandwidth from the Taipei retail cloud hub to five flagship store spokes is at least 80 Mbps within the monthly SLA window."@en .

ex:exp-bandwidth
    a icm:PropertyExpectation ;
    icm:target ex:tgt-bandwidth .

ex:tgt-bandwidth
    a icm:Target ;
    evsla:hasMetric evsla:guaranteedBandwidth ;
    icm:valuesOfTargetProperty ex:thr-bandwidth ;
    evsla:hasThreshold ex:thr-bandwidth ;
    evsla:hasStatistic evsla:minimum ;
    evsla:hasScope evsla:hubToAllSpokes ;
    evsla:hasMeasurementMethod evsla:activeMeasurement ;
    evsla:hasTimeWindow evsla:monthlySlaWindow .

ex:thr-bandwidth
    a quan:Quantity ;
    rdf:value "80"^^xsd:decimal ;
    quan:unit "Mbps" .

ex:cond-bandwidth
    a log:Condition ;
    quan:atLeast ( ex:obs-bandwidth-value ex:thr-bandwidth ) .

ex:obs-bandwidth
    evsla:guaranteedBandwidth evsla:guaranteedBandwidth ;
    icm:valuesOfTargetProperty ex:obs-bandwidth-value .

ex:obs-bandwidth-value
    a quan:Quantity .

ex:topology
    a icm:Context ;
    evsla:hubToAllSpokes ex:hub ;
    rdfs:comment "Hub-and-spoke topology with one hub and five flagship store spokes."@en .

ex:hub
    rdfs:label "台北零售雲總部"@zh .

ex:spoke1
    rdfs:label "旗艦門市1"@zh .

ex:spoke2
    rdfs:label "旗艦門市2"@zh .

ex:spoke3
    rdfs:label "旗艦門市3"@zh .

ex:spoke4
    rdfs:label "旗艦門市4"@zh .

ex:spoke5
    rdfs:label "旗艦門市5"@zh .

ex:topology
    evsla:perSpoke ex:spoke1, ex:spoke2, ex:spoke3, ex:spoke4, ex:spoke5 .