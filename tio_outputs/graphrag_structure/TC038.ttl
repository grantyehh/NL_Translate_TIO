@prefix ex: <http://example.org/tio-instance/tc038/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix met: <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:intent
    a icm:Intent, evsla:EnterpriseVpnService ;
    icm:intentElements ex:exp-bandwidth, ex:topology, ex:cond-bandwidth ;
    evsla:forTenant ex:tenant ;
    rdfs:comment "Monthly SLA window guaranteeing minimum bandwidth of at least 80 Mbps from the hub to all five flagship spokes."@en .

ex:tenant
    a evsla:Tenant ;
    rdfs:label "遠傳智慧零售"@zh .

ex:exp-bandwidth
    a icm:PropertyExpectation, evsla:SlaExpectation ;
    icm:target ex:tgt-bandwidth .

ex:tgt-bandwidth
    a icm:Target ;
    evsla:hasMetric evsla:guaranteedBandwidth ;
    icm:valuesOfTargetProperty ex:thr-bandwidth ;
    evsla:hasThreshold ex:thr-bandwidth ;
    evsla:hasStatistic evsla:minimum ;
    evsla:hasScope evsla:hubToAllSpokes ;
    evsla:hasMeasurementMethod evsla:activeMeasurement ;
    evsla:hasTimeWindow evsla:monthlySlaWindow .

ex:thr-bandwidth
    a quan:Quantity ;
    rdf:value "80"^^xsd:decimal ;
    quan:unit "Mbps" .

ex:cond-bandwidth
    a log:Condition ;
    quan:atLeast ( ex:obs-bandwidth-value ex:thr-bandwidth ) .

ex:obs-bandwidth
    evsla:hasMetric evsla:guaranteedBandwidth .

ex:obs-bandwidth-value
    a quan:Quantity ;
    fun:valueOf ( ex:obs-bandwidth ) .

ex:topology
    a icm:Context, evsla:HubAndSpokeTopology ;
    evsla:hasHub ex:hub ;
    evsla:hasSpoke ex:spoke-1, ex:spoke-2, ex:spoke-3, ex:spoke-4, ex:spoke-5 .

ex:hub
    a evsla:HubSite ;
    rdfs:label "台北零售雲總部"@zh .

ex:spoke-1
    a evsla:SpokeSite ;
    rdfs:label "旗艦門市1"@zh .

ex:spoke-2
    a evsla:SpokeSite ;
    rdfs:label "旗艦門市2"@zh .

ex:spoke-3
    a evsla:SpokeSite ;
    rdfs:label "旗艦門市3"@zh .

ex:spoke-4
    a evsla:SpokeSite ;
    rdfs:label "旗艦門市4"@zh .

ex:spoke-5
    a evsla:SpokeSite ;
    rdfs:label "旗艦門市5"@zh .