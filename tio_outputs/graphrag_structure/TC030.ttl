@prefix ex: <http://example.org/tio-instance/tc030/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix met: <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:intent
    a icm:Intent, evsla:EnterpriseVpnService ;
    icm:intentElements ex:exp-packetloss, ex:exp-bandwidth, ex:topology, ex:cond-packetloss, ex:cond-bandwidth ;
    evsla:forTenant ex:tenant ;
    rdfs:comment "瑞德電信要求台北機房到台南機房封包遺失率在99%時間內低於0.01%，到高雄機房保證頻寬不低於1000Mbps。"@en .

ex:tenant
    a evsla:Tenant ;
    rdfs:label "瑞德電信"@zh .

ex:topology
    a evsla:HubAndSpokeTopology ;
    evsla:hasHub ex:hub-taipei ;
    evsla:hasSpoke ex:spoke-tainan, ex:spoke-kaohsiung .

ex:hub-taipei
    a evsla:HubSite ;
    rdfs:label "台北機房"@zh .

ex:spoke-tainan
    a evsla:SpokeSite ;
    rdfs:label "台南機房"@zh .

ex:spoke-kaohsiung
    a evsla:SpokeSite ;
    rdfs:label "高雄機房"@zh .

ex:exp-packetloss
    a icm:PropertyExpectation, evsla:SlaExpectation ;
    icm:target ex:tgt-packetloss ;
    evsla:hasMetric evsla:packetLoss ;
    evsla:hasThreshold ex:thr-packetloss ;
    evsla:hasStatistic evsla:p99 ;
    evsla:hasScope evsla:specificSpoke ;
    evsla:hasMeasurementMethod evsla:twamp ;
    evsla:hasTimeWindow evsla:fiveMinuteWindow .

ex:tgt-packetloss
    a icm:Target ;
    icm:valuesOfTargetProperty ex:thr-packetloss .

ex:thr-packetloss
    a quan:Quantity ;
    rdf:value "0.01"^^xsd:decimal ;
    quan:unit "%" .

ex:cond-packetloss
    a log:Condition ;
    quan:smaller ( ex:obs-packetloss-value ex:thr-packetloss ) .

ex:obs-packetloss
    evsla:packetLoss evsla:packetLoss .

ex:obs-packetloss-value
    a quan:Quantity ;
    fun:valueOf ( ex:obs-packetloss ) .

ex:exp-bandwidth
    a icm:PropertyExpectation, evsla:SlaExpectation ;
    icm:target ex:tgt-bandwidth ;
    evsla:hasMetric evsla:guaranteedBandwidth ;
    evsla:hasThreshold ex:thr-bandwidth ;
    evsla:hasStatistic evsla:minimum ;
    evsla:hasScope evsla:specificSpoke ;
    evsla:hasMeasurementMethod evsla:activeMeasurement ;
    evsla:hasTimeWindow evsla:fiveMinuteWindow .

ex:tgt-bandwidth
    a icm:Target ;
    icm:valuesOfTargetProperty ex:thr-bandwidth .

ex:thr-bandwidth
    a quan:Quantity ;
    rdf:value "1000"^^xsd:decimal ;
    quan:unit "Mbps" .

ex:cond-bandwidth
    a log:Condition ;
    quan:atLeast ( ex:obs-bandwidth-value ex:thr-bandwidth ) .

ex:obs-bandwidth
    evsla:guaranteedBandwidth evsla:guaranteedBandwidth .

ex:obs-bandwidth-value
    a quan:Quantity ;
    fun:valueOf ( ex:obs-bandwidth ) .