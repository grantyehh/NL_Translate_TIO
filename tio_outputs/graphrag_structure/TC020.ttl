@prefix ex: <http://example.org/tio-instance/tc020/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix met: <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:intent
    a icm:Intent, evsla:EnterpriseVpnService ;
    icm:intentElements ex:exp-latency, ex:exp-loss, ex:topology, ex:cond-latency, ex:cond-loss ;
    evsla:forTenant ex:tenant ;
    rdfs:comment "Ensure latency from the Taipei R&D headquarters hub to Hsinchu Experimental Lab and Tainan Manufacturing Plant stays below 35 ms at the p95 level, and packet loss between the hub and each spoke stays below 0.05% at the p99 level."@en .

ex:tenant
    a evsla:Tenant ;
    rdfs:label "精準醫材"@zh .

ex:exp-latency
    a icm:PropertyExpectation, evsla:SlaExpectation ;
    icm:target ex:tgt-latency .

ex:tgt-latency
    a icm:Target ;
    evsla:hasMetric evsla:latency ;
    icm:valuesOfTargetProperty ex:thr-latency ;
    evsla:hasThreshold ex:thr-latency ;
    evsla:hasStatistic evsla:p95 ;
    evsla:hasScope evsla:hubToAllSpokes ;
    evsla:hasMeasurementMethod evsla:twamp ;
    evsla:hasTimeWindow evsla:fiveMinuteWindow .

ex:thr-latency
    a quan:Quantity ;
    rdf:value "35"^^xsd:decimal ;
    quan:unit "ms" .

ex:exp-loss
    a icm:PropertyExpectation, evsla:SlaExpectation ;
    icm:target ex:tgt-loss .

ex:tgt-loss
    a icm:Target ;
    evsla:hasMetric evsla:packetLoss ;
    icm:valuesOfTargetProperty ex:thr-loss ;
    evsla:hasThreshold ex:thr-loss ;
    evsla:hasStatistic evsla:p99 ;
    evsla:hasScope evsla:perSpoke ;
    evsla:hasMeasurementMethod evsla:twamp ;
    evsla:hasTimeWindow evsla:fiveMinuteWindow .

ex:thr-loss
    a quan:Quantity ;
    rdf:value "0.05"^^xsd:decimal ;
    quan:unit "%" .

ex:cond-latency
    a log:Condition ;
    quan:smaller ( ex:obs-latency-value ex:thr-latency ) .

ex:obs-latency
    evsla:hasMetric evsla:latency .

ex:obs-latency-value
    a quan:Quantity ;
    fun:valueOf ( ex:obs-latency ) .

ex:cond-loss
    a log:Condition ;
    quan:smaller ( ex:obs-loss-value ex:thr-loss ) .

ex:obs-loss
    evsla:hasMetric evsla:packetLoss .

ex:obs-loss-value
    a quan:Quantity ;
    fun:valueOf ( ex:obs-loss ) .

ex:topology
    a icm:Context, evsla:HubAndSpokeTopology ;
    evsla:hasHub ex:hub ;
    evsla:hasSpoke ex:spoke-zhubei, ex:spoke-tainan .

ex:hub
    a evsla:HubSite ;
    rdfs:label "台北研發總部"@zh .

ex:spoke-zhubei
    a evsla:SpokeSite ;
    rdfs:label "竹北實驗室"@zh .

ex:spoke-tainan
    a evsla:SpokeSite ;
    rdfs:label "台南製造廠"@zh .