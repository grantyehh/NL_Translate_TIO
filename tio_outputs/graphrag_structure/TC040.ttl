@prefix ex: <http://example.org/tio-instance/tc040/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix met: <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:intent
    a icm:Intent, evsla:SlaExpectation ;
    icm:intentElements ex:exp-packetLoss, ex:exp-guaranteedBandwidth, ex:topology, ex:cond-packetLoss, ex:cond-guaranteedBandwidth ;
    rdfs:comment "Taipei core site to five PoP spokes in a hub-and-spoke VPN: monthly SLA requires maximum packet loss at most 0.3% and average guaranteed bandwidth at least 500 Mbps."@en .

ex:exp-packetLoss
    a icm:PropertyExpectation, evsla:SlaExpectation ;
    icm:target ex:tgt-packetLoss .

ex:tgt-packetLoss
    a icm:Target ;
    evsla:hasMetric evsla:packetLoss ;
    icm:valuesOfTargetProperty ex:thr-packetLoss ;
    evsla:hasThreshold ex:thr-packetLoss ;
    evsla:hasStatistic evsla:maximum ;
    evsla:hasScope evsla:hubToAllSpokes ;
    evsla:hasMeasurementMethod evsla:activeMeasurement ;
    evsla:hasTimeWindow evsla:monthlySlaWindow .

ex:thr-packetLoss
    a quan:Quantity ;
    rdf:value "0.3"^^xsd:decimal ;
    quan:unit "%" .

ex:cond-packetLoss
    a log:Condition ;
    quan:atMost ( ex:obs-packetLoss-value ex:thr-packetLoss ) .

ex:obs-packetLoss
    met:packetLoss evsla:packetLoss .

ex:obs-packetLoss-value
    a quan:Quantity ;
    met:observedValue ( ex:obs-packetLoss ) .

ex:exp-guaranteedBandwidth
    a icm:PropertyExpectation, evsla:SlaExpectation ;
    icm:target ex:tgt-guaranteedBandwidth .

ex:tgt-guaranteedBandwidth
    a icm:Target ;
    evsla:hasMetric evsla:guaranteedBandwidth ;
    icm:valuesOfTargetProperty ex:thr-guaranteedBandwidth ;
    evsla:hasThreshold ex:thr-guaranteedBandwidth ;
    evsla:hasStatistic evsla:average ;
    evsla:hasScope evsla:hubToAllSpokes ;
    evsla:hasMeasurementMethod evsla:activeMeasurement ;
    evsla:hasTimeWindow evsla:monthlySlaWindow .

ex:thr-guaranteedBandwidth
    a quan:Quantity ;
    rdf:value "500"^^xsd:decimal ;
    quan:unit "Mbps" .

ex:cond-guaranteedBandwidth
    a log:Condition ;
    quan:atLeast ( ex:obs-guaranteedBandwidth-value ex:thr-guaranteedBandwidth ) .

ex:obs-guaranteedBandwidth
    met:guaranteedBandwidth evsla:guaranteedBandwidth .

ex:obs-guaranteedBandwidth-value
    a quan:Quantity ;
    met:observedValue ( ex:obs-guaranteedBandwidth ) .

ex:topology
    a icm:Context ;
    evsla:hubSite ex:hub-taipei ;
    evsla:spokeSite ex:spoke-1, ex:spoke-2, ex:spoke-3, ex:spoke-4, ex:spoke-5 .

ex:hub-taipei
    rdfs:label "台北核心機房"@zh .

ex:spoke-1
    rdfs:label "PoP 節點 1"@zh .

ex:spoke-2
    rdfs:label "PoP 節點 2"@zh .

ex:spoke-3
    rdfs:label "PoP 節點 3"@zh .

ex:spoke-4
    rdfs:label "PoP 節點 4"@zh .

ex:spoke-5
    rdfs:label "PoP 節點 5"@zh .