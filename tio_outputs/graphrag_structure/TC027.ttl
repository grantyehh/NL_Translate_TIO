@prefix ex: <http://example.org/tio-instance/tc027/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix met: <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:intent
    a icm:Intent, evsla:EnterpriseVpnService ;
    icm:intentElements ex:exp-latency-keelung, ex:exp-loss-miaoli, ex:exp-loss-changbin, ex:topology, ex:cond-latency-keelung, ex:cond-loss-miaoli, ex:cond-loss-changbin ;
    evsla:forTenant ex:tenant ;
    rdfs:comment "昇晟能源 requires latency below 20 ms at p99 from 台北能源調度中心 to 基隆電廠, and packet loss below 0.05% to 苗栗電廠 and 彰濱電廠 over the default five-minute window."@en .

ex:tenant
    a evsla:Tenant ;
    rdfs:label "昇晟能源"@zh .

ex:exp-latency-keelung
    a icm:PropertyExpectation, evsla:SlaExpectation ;
    icm:target ex:tgt-latency-keelung .

ex:tgt-latency-keelung
    a icm:Target ;
    evsla:hasMetric evsla:latency ;
    icm:valuesOfTargetProperty ex:thr-latency-keelung ;
    evsla:hasThreshold ex:thr-latency-keelung ;
    evsla:hasStatistic evsla:p99 ;
    evsla:hasScope evsla:specificSpoke ;
    evsla:hasMeasurementMethod evsla:twamp ;
    evsla:hasTimeWindow evsla:fiveMinuteWindow .

ex:thr-latency-keelung
    a quan:Quantity ;
    rdf:value "20"^^xsd:decimal ;
    quan:unit "ms" .

ex:exp-loss-miaoli
    a icm:PropertyExpectation, evsla:SlaExpectation ;
    icm:target ex:tgt-loss-miaoli .

ex:tgt-loss-miaoli
    a icm:Target ;
    evsla:hasMetric evsla:packetLoss ;
    icm:valuesOfTargetProperty ex:thr-loss ;
    evsla:hasThreshold ex:thr-loss ;
    evsla:hasStatistic evsla:p99 ;
    evsla:hasScope evsla:specificSpoke ;
    evsla:hasMeasurementMethod evsla:twamp ;
    evsla:hasTimeWindow evsla:fiveMinuteWindow .

ex:exp-loss-changbin
    a icm:PropertyExpectation, evsla:SlaExpectation ;
    icm:target ex:tgt-loss-changbin .

ex:tgt-loss-changbin
    a icm:Target ;
    evsla:hasMetric evsla:packetLoss ;
    icm:valuesOfTargetProperty ex:thr-loss ;
    evsla:hasThreshold ex:thr-loss ;
    evsla:hasStatistic evsla:p99 ;
    evsla:hasScope evsla:specificSpoke ;
    evsla:hasMeasurementMethod evsla:twamp ;
    evsla:hasTimeWindow evsla:fiveMinuteWindow .

ex:thr-loss
    a quan:Quantity ;
    rdf:value "0.05"^^xsd:decimal ;
    quan:unit "%" .

ex:cond-latency-keelung
    a log:Condition ;
    quan:smaller ( ex:obs-latency-keelung-value ex:thr-latency-keelung ) .

ex:obs-latency-keelung
    evsla:hasMetric evsla:latency ;
    icm:valuesOfTargetProperty ex:obs-latency-keelung-value .

ex:obs-latency-keelung-value
    a quan:Quantity .

ex:cond-loss-miaoli
    a log:Condition ;
    quan:smaller ( ex:obs-loss-miaoli-value ex:thr-loss ) .

ex:obs-loss-miaoli
    evsla:hasMetric evsla:packetLoss ;
    icm:valuesOfTargetProperty ex:obs-loss-miaoli-value .

ex:obs-loss-miaoli-value
    a quan:Quantity .

ex:cond-loss-changbin
    a log:Condition ;
    quan:smaller ( ex:obs-loss-changbin-value ex:thr-loss ) .

ex:obs-loss-changbin
    evsla:hasMetric evsla:packetLoss ;
    icm:valuesOfTargetProperty ex:obs-loss-changbin-value .

ex:obs-loss-changbin-value
    a quan:Quantity .

ex:topology
    a icm:Context, evsla:HubAndSpokeTopology ;
    evsla:hasHub ex:hub-taipei ;
    evsla:hasSpoke ex:spoke-keelung, ex:spoke-miaoli, ex:spoke-changbin .

ex:hub-taipei
    a evsla:HubSite ;
    rdfs:label "台北能源調度中心"@zh .

ex:spoke-keelung
    a evsla:SpokeSite ;
    rdfs:label "基隆電廠"@zh .

ex:spoke-miaoli
    a evsla:SpokeSite ;
    rdfs:label "苗栗電廠"@zh .

ex:spoke-changbin
    a evsla:SpokeSite ;
    rdfs:label "彰濱電廠"@zh .