@prefix ex: <http://example.org/tio-instance/tc015/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix met: <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:intent
    a icm:Intent, evsla:EnterpriseVpnService ;
    icm:intentElements ex:exp-guaranteedBandwidth, ex:topology, ex:cond-guaranteedBandwidth ;
    evsla:forTenant ex:tenant ;
    rdfs:comment "Provide guaranteed bandwidth of at least 300 Mbps from 亞洲航空維修總部 to 小港機棚."@en .

ex:exp-guaranteedBandwidth
    a icm:PropertyExpectation, evsla:SlaExpectation ;
    icm:target ex:tgt-guaranteedBandwidth .

ex:tgt-guaranteedBandwidth
    a icm:Target ;
    evsla:hasMetric evsla:guaranteedBandwidth ;
    icm:valuesOfTargetProperty ex:thr-guaranteedBandwidth ;
    evsla:hasThreshold ex:thr-guaranteedBandwidth ;
    evsla:hasStatistic evsla:minimum ;
    evsla:hasScope evsla:specificSpoke ;
    evsla:hasMeasurementMethod evsla:activeMeasurement ;
    evsla:hasTimeWindow evsla:fiveMinuteWindow .

ex:thr-guaranteedBandwidth
    a quan:Quantity ;
    rdf:value "300"^^xsd:decimal ;
    quan:unit "Mbps" .

ex:cond-guaranteedBandwidth
    a log:Condition ;
    quan:atLeast ( ex:obs-guaranteedBandwidth-value ex:thr-guaranteedBandwidth ) .

ex:obs-guaranteedBandwidth
    evsla:guaranteedBandwidth evsla:guaranteedBandwidth .

ex:obs-guaranteedBandwidth-value
    a quan:Quantity ;
    met:observedValue ( ex:obs-guaranteedBandwidth ) .

ex:topology
    a icm:Context, evsla:HubAndSpokeTopology ;
    evsla:hasHub ex:hub ;
    evsla:hasSpoke ex:spoke-1 .

ex:hub
    a evsla:HubSite ;
    rdfs:label "亞洲航空維修總部"@zh .

ex:spoke-1
    a evsla:SpokeSite ;
    rdfs:label "小港機棚"@zh .

ex:tenant
    a evsla:Tenant ;
    rdfs:label "亞洲航空"@zh .