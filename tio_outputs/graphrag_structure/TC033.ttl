@prefix ex: <http://example.org/tio-instance/tc033/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix met: <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:intent
  a icm:Intent, evsla:EnterpriseVpnService ;
  icm:intentElements ex:exp-latency, ex:exp-loss, ex:exp-bandwidth, ex:topology, ex:cond-latency, ex:cond-loss, ex:cond-bandwidth ;
  evsla:forTenant ex:tenant ;
  rdfs:comment "鴻旭製藥要求台中藥廠總部至所有分點延遲在95%時間內低於50ms、封包遺失率在99%時間內低於0.1%，且保證頻寬不低於100Mbps。"@en .

ex:tenant
  a evsla:Tenant ;
  rdfs:label "鴻旭製藥"@zh .

ex:exp-latency
  a icm:PropertyExpectation, evsla:SlaExpectation ;
  icm:target ex:tgt-latency .

ex:tgt-latency
  a icm:Target ;
  evsla:hasMetric evsla:latency ;
  icm:valuesOfTargetProperty ex:thr-latency ;
  evsla:hasThreshold ex:thr-latency ;
  evsla:hasStatistic evsla:p95 ;
  evsla:hasScope evsla:hubToAllSpokes ;
  evsla:hasMeasurementMethod evsla:twamp ;
  evsla:hasTimeWindow evsla:fiveMinuteWindow .

ex:thr-latency
  a quan:Quantity ;
  rdf:value "50"^^xsd:decimal ;
  quan:unit "ms" .

ex:exp-loss
  a icm:PropertyExpectation, evsla:SlaExpectation ;
  icm:target ex:tgt-loss .

ex:tgt-loss
  a icm:Target ;
  evsla:hasMetric evsla:packetLoss ;
  icm:valuesOfTargetProperty ex:thr-loss ;
  evsla:hasThreshold ex:thr-loss ;
  evsla:hasStatistic evsla:p99 ;
  evsla:hasScope evsla:hubToAllSpokes ;
  evsla:hasMeasurementMethod evsla:twamp ;
  evsla:hasTimeWindow evsla:fiveMinuteWindow .

ex:thr-loss
  a quan:Quantity ;
  rdf:value "0.1"^^xsd:decimal ;
  quan:unit "%" .

ex:exp-bandwidth
  a icm:PropertyExpectation, evsla:SlaExpectation ;
  icm:target ex:tgt-bandwidth .

ex:tgt-bandwidth
  a icm:Target ;
  evsla:hasMetric evsla:guaranteedBandwidth ;
  icm:valuesOfTargetProperty ex:thr-bandwidth ;
  evsla:hasThreshold ex:thr-bandwidth ;
  evsla:hasScope evsla:hubToAllSpokes ;
  evsla:hasMeasurementMethod evsla:activeMeasurement ;
  evsla:hasTimeWindow evsla:fiveMinuteWindow .

ex:thr-bandwidth
  a quan:Quantity ;
  rdf:value "100"^^xsd:decimal ;
  quan:unit "Mbps" .

ex:cond-latency
  a log:Condition ;
  quan:smaller ( ex:obs-latency-value ex:thr-latency ) .

ex:obs-latency
  evsla:latency evsla:latency .

ex:obs-latency-value
  a quan:Quantity ;
  fun:valueOf ( ex:obs-latency ) .

ex:cond-loss
  a log:Condition ;
  quan:smaller ( ex:obs-loss-value ex:thr-loss ) .

ex:obs-loss
  evsla:packetLoss evsla:packetLoss .

ex:obs-loss-value
  a quan:Quantity ;
  fun:valueOf ( ex:obs-loss ) .

ex:cond-bandwidth
  a log:Condition ;
  quan:atLeast ( ex:obs-bandwidth-value ex:thr-bandwidth ) .

ex:obs-bandwidth
  evsla:guaranteedBandwidth evsla:guaranteedBandwidth .

ex:obs-bandwidth-value
  a quan:Quantity ;
  fun:valueOf ( ex:obs-bandwidth ) .

ex:topology
  a icm:Context, evsla:HubAndSpokeTopology ;
  evsla:hasHub ex:hub ;
  evsla:hasSpoke ex:spoke-1 .

ex:hub
  a evsla:HubSite ;
  rdfs:label "台中藥廠總部"@zh .

ex:spoke-1
  a evsla:SpokeSite ;
  rdfs:label "所有分點"@zh .