@prefix ex: <http://example.org/tio-instance/tc029/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix met: <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:intent
    a icm:Intent, evsla:EnterpriseVpnService ;
    icm:intentElements ex:exp-banqiao, ex:exp-xizhi-san-chong, ex:topology, ex:cond-banqiao, ex:cond-xizhi-san-chong ;
    evsla:forTenant ex:tenant ;
    rdfs:comment "Federal Hospital requires latency from Taipei Medical Information Center to Banqiao Campus to stay below 10 ms at p99, and latency to Xizhi Campus and Sanchong Campus to stay below 25 ms at p95."@en .

ex:tenant
    a evsla:Tenant ;
    rdfs:label "聯邦醫院"@zh .

ex:exp-banqiao
    a icm:PropertyExpectation, evsla:SlaExpectation ;
    icm:target ex:tgt-banqiao ;
    evsla:hasMetric evsla:latency ;
    evsla:hasThreshold ex:thr-banqiao ;
    evsla:hasStatistic evsla:p99 ;
    evsla:hasScope evsla:specificSpoke ;
    evsla:hasMeasurementMethod evsla:twamp ;
    evsla:hasTimeWindow evsla:fiveMinuteWindow .

ex:tgt-banqiao
    a icm:Target ;
    icm:valuesOfTargetProperty ex:thr-banqiao .

ex:thr-banqiao
    a quan:Quantity ;
    rdf:value "10"^^xsd:decimal ;
    quan:unit "ms" .

ex:exp-xizhi-san-chong
    a icm:PropertyExpectation, evsla:SlaExpectation ;
    icm:target ex:tgt-xizhi-san-chong ;
    evsla:hasMetric evsla:latency ;
    evsla:hasThreshold ex:thr-xizhi-san-chong ;
    evsla:hasStatistic evsla:p95 ;
    evsla:hasScope evsla:perSpoke ;
    evsla:hasMeasurementMethod evsla:twamp ;
    evsla:hasTimeWindow evsla:fiveMinuteWindow .

ex:tgt-xizhi-san-chong
    a icm:Target ;
    icm:valuesOfTargetProperty ex:thr-xizhi-san-chong .

ex:thr-xizhi-san-chong
    a quan:Quantity ;
    rdf:value "25"^^xsd:decimal ;
    quan:unit "ms" .

ex:cond-banqiao
    a log:Condition ;
    quan:smaller ( ex:obs-banqiao-value ex:thr-banqiao ) .

ex:obs-banqiao
    evsla:hasMetric evsla:latency .

ex:obs-banqiao-value
    a quan:Quantity ;
    fun:valueOf ( ex:obs-banqiao ) .

ex:cond-xizhi-san-chong
    a log:Condition ;
    quan:smaller ( ex:obs-xizhi-san-chong-value ex:thr-xizhi-san-chong ) .

ex:obs-xizhi-san-chong
    evsla:hasMetric evsla:latency .

ex:obs-xizhi-san-chong-value
    a quan:Quantity ;
    fun:valueOf ( ex:obs-xizhi-san-chong ) .

ex:topology
    a icm:Context, evsla:HubAndSpokeTopology ;
    evsla:hasHub ex:hub-taipei ;
    evsla:hasSpoke ex:spoke-banqiao, ex:spoke-xizhi, ex:spoke-san-chong .

ex:hub-taipei
    a evsla:HubSite ;
    rdfs:label "台北醫療資訊中心"@zh .

ex:spoke-banqiao
    a evsla:SpokeSite ;
    rdfs:label "板橋院區"@zh .

ex:spoke-xizhi
    a evsla:SpokeSite ;
    rdfs:label "汐止院區"@zh .

ex:spoke-san-chong
    a evsla:SpokeSite ;
    rdfs:label "三重院區"@zh .