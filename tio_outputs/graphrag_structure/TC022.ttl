@prefix ex: <http://example.org/tio-instance/tc022/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix met: <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:intent
    a icm:Intent, evsla:EnterpriseVpnService ;
    icm:intentElements ex:exp-packetloss, ex:topology, ex:cond-packetloss ;
    evsla:forTenant ex:tenant ;
    rdfs:comment "翔益電商要求台北倉儲中心到新北倉、桃園倉與台中倉，每個分點各自的封包遺失率在99%時間內低於0.1%。"@en .

ex:tenant
    a evsla:Tenant ;
    rdfs:label "翔益電商"@zh .

ex:exp-packetloss
    a icm:PropertyExpectation, evsla:SlaExpectation ;
    icm:target ex:tgt-packetloss .

ex:tgt-packetloss
    a icm:Target ;
    evsla:hasMetric evsla:packetLoss ;
    icm:valuesOfTargetProperty ex:thr-packetloss ;
    evsla:hasThreshold ex:thr-packetloss ;
    evsla:hasStatistic evsla:p99 ;
    evsla:hasScope evsla:perSpoke ;
    evsla:hasMeasurementMethod evsla:twamp ;
    evsla:hasTimeWindow evsla:fiveMinuteWindow .

ex:thr-packetloss
    a quan:Quantity ;
    rdf:value "0.1"^^xsd:decimal ;
    quan:unit "%" .

ex:cond-packetloss
    a log:Condition ;
    quan:smaller ( ex:obs-packetloss-value ex:thr-packetloss ) .

ex:obs-packetloss
    met:observedProperty evsla:packetLoss .

ex:obs-packetloss-value
    a quan:Quantity ;
    met:hasValue ( ex:obs-packetloss ) .

ex:topology
    a icm:Context, evsla:HubAndSpokeTopology ;
    evsla:hasHub ex:hub-taipei ;
    evsla:hasSpoke ex:spoke-newtaipei, ex:spoke-taoyuan, ex:spoke-taichung .

ex:hub-taipei
    a evsla:HubSite ;
    rdfs:label "台北倉儲中心"@zh .

ex:spoke-newtaipei
    a evsla:SpokeSite ;
    rdfs:label "新北倉"@zh .

ex:spoke-taoyuan
    a evsla:SpokeSite ;
    rdfs:label "桃園倉"@zh .

ex:spoke-taichung
    a evsla:SpokeSite ;
    rdfs:label "台中倉"@zh .