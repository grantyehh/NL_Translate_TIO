@prefix ex: <http://example.org/tio-instance/tc022/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix met: <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:intent
    a icm:Intent, evsla:EnterpriseVpnService ;
    icm:intentElements ex:exp-packetLoss, ex:topology, ex:cond-packetLoss ;
    evsla:forTenant ex:tenant ;
    rdfs:comment "Packet loss from Taipei warehouse hub to each spoke must stay below 0.1% at p99 level."@en .

ex:exp-packetLoss
    a icm:PropertyExpectation, evsla:SlaExpectation ;
    icm:target ex:tgt-packetLoss ;
    evsla:hasMetric evsla:packetLoss ;
    evsla:hasThreshold ex:thr-packetLoss ;
    evsla:hasStatistic evsla:p99 ;
    evsla:hasScope evsla:perSpoke ;
    evsla:hasMeasurementMethod evsla:twamp ;
    evsla:hasTimeWindow evsla:fiveMinuteWindow .

ex:tgt-packetLoss
    a icm:Target ;
    icm:valuesOfTargetProperty ex:thr-packetLoss .

ex:thr-packetLoss
    a quan:Quantity ;
    rdf:value "0.1"^^xsd:decimal ;
    quan:unit "%" .

ex:cond-packetLoss
    a log:Condition ;
    quan:smaller ( ex:obs-packetLoss-value ex:thr-packetLoss ) .

ex:obs-packetLoss
    met:metric evsla:packetLoss .

ex:obs-packetLoss-value
    a quan:Quantity ;
    fun:valueOf ( ex:obs-packetLoss ) .

ex:topology
    a icm:Context, evsla:HubAndSpokeTopology ;
    evsla:hasHub ex:hub-taipei ;
    evsla:hasSpoke ex:spoke-newtaipei, ex:spoke-taoyuan, ex:spoke-taichung .

ex:hub-taipei
    a evsla:HubSite ;
    rdfs:label "台北倉儲中心"@zh .

ex:spoke-newtaipei
    a evsla:SpokeSite ;
    rdfs:label "新北倉"@zh .

ex:spoke-taoyuan
    a evsla:SpokeSite ;
    rdfs:label "桃園倉"@zh .

ex:spoke-taichung
    a evsla:SpokeSite ;
    rdfs:label "台中倉"@zh .

ex:tenant
    a evsla:Tenant ;
    rdfs:label "翔益電商"@zh .