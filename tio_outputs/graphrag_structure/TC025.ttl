@prefix ex: <http://example.org/tio-instance/tc025/> .
@prefix evsla: <http://tio.models.tmforum.org/tio/v3.6.0/EnterpriseVpnSlaOntology/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix met: <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:intent
    a icm:Intent, evsla:SlaExpectation ;
    icm:intentElements ex:exp-packetloss, ex:topology, ex:cond-packetloss ;
    rdfs:comment "Kaohsiung logistics center to Pingtung delivery station and Taitung delivery station, each spoke packet loss stays below 0.2% at the p95 level."@en .

ex:exp-packetloss
    a icm:PropertyExpectation, evsla:SlaExpectation ;
    icm:target ex:tgt-packetloss ;
    evsla:hasMetric evsla:packetLoss ;
    evsla:hasThreshold ex:thr-packetloss ;
    evsla:hasStatistic evsla:p95 ;
    evsla:hasScope evsla:perSpoke ;
    evsla:hasMeasurementMethod evsla:activeMeasurement .

ex:tgt-packetloss
    a icm:Target ;
    evsla:hasMetric evsla:packetLoss ;
    icm:valuesOfTargetProperty ex:thr-packetloss ;
    evsla:hasThreshold ex:thr-packetloss ;
    evsla:hasStatistic evsla:p95 ;
    evsla:hasScope evsla:perSpoke ;
    evsla:hasMeasurementMethod evsla:activeMeasurement .

ex:thr-packetloss
    a quan:Quantity ;
    rdf:value "0.2"^^xsd:decimal ;
    quan:unit "%" .

ex:cond-packetloss
    a log:Condition ;
    quan:smaller ( ex:obs-packetloss-value ex:thr-packetloss ) .

ex:obs-packetloss
    evsla:hasMetric evsla:packetLoss .

ex:obs-packetloss-value
    a quan:Quantity ;
    fun:valueOf ( ex:obs-packetloss ) .

ex:topology
    a icm:Context ;
    rdfs:comment "Hub-and-spoke topology with one hub and two spokes."@en ;
    evsla:hasScope evsla:perSpoke ;
    ex:hub [ rdfs:label "高雄物流中心"@zh ] ;
    ex:spoke [ rdfs:label "屏東配送站"@zh ] ;
    ex:spoke [ rdfs:label "台東配送站"@zh ] .