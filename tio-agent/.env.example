# Copy to .env and fill in. bun auto-loads .env from cwd.
#
# ─── OpenAI (default) ───
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o          # or gpt-4o-mini, gpt-4.1, etc.
#
# ─── Ollama (local, free) ────────────────────────────────────────
# brew install ollama && ollama pull llama3.1:8b && ollama serve
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.1:8b     # or qwen2.5:14b, mistral-nemo, etc.
#
# ─── OpenRouter (one key, many models, small $ top-up) ───────────
# https://openrouter.ai/
# OPENAI_API_KEY=sk-or-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=anthropic/claude-3.5-sonnet
#   or openai/gpt-4o-mini, google/gemini-2.0-flash-exp, etc.
#
# ─── Groq (free tier, ultra fast) ────────────────────────────────
# https://console.groq.com/
# OPENAI_API_KEY=gsk_...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile
