{
  "@context": "https://tmforum.org/schemas/intent-ontology/v1.jsonld",
  "@type": "Intent",
  "id": "intent-tc014",
  "name": "Autonomous Vehicle Control Service Quality Intent",
  "description": "Provide connection quality for autonomous vehicle control service with latency below 10ms, jitter below 2ms, and packet loss rate below 0.1%.",
  "intentOwner": {
    "id": "ops-manager-01",
    "name": "Network Operations Center"
  },
  "intentExpectation": [
    {
      "id": "exp-latency-01",
      "name": "Latency Expectation",
      "description": "Ensure latency is below 10 ms for autonomous vehicle control service.",
      "@type": "PropertyExpectation",
      "expectationObject": {
        "id": "service-autonomous-vehicle-control",
        "name": "Autonomous Vehicle Control Service",
        "@type": "Service"
      },
      "expectationTarget": [
        {
          "name": "Latency",
          "targetProperty": "latency",
          "matchCondition": "LESS_THAN",
          "targetValue": {
            "value": 10,
            "unit": "ms"
          }
        }
      ]
    },
    {
      "id": "exp-jitter-01",
      "name": "Jitter Expectation",
      "description": "Ensure jitter is below 2 ms for autonomous vehicle control service.",
      "@type": "PropertyExpectation",
      "expectationObject": {
        "id": "service-autonomous-vehicle-control",
        "name": "Autonomous Vehicle Control Service",
        "@type": "Service"
      },
      "expectationTarget": [
        {
          "name": "Jitter",
          "targetProperty": "jitter",
          "matchCondition": "LESS_THAN",
          "targetValue": {
            "value": 2,
            "unit": "ms"
          }
        }
      ]
    },
    {
      "id": "exp-packet-loss-01",
      "name": "Packet Loss Rate Expectation",
      "description": "Ensure packet loss rate is below 0.1% for autonomous vehicle control service.",
      "@type": "PropertyExpectation",
      "expectationObject": {
        "id": "service-autonomous-vehicle-control",
        "name": "Autonomous Vehicle Control Service",
        "@type": "Service"
      },
      "expectationTarget": [
        {
          "name": "Packet Loss Rate",
          "targetProperty": "packetLossRate",
          "matchCondition": "LESS_THAN",
          "targetValue": {
            "value": 0.1,
            "unit": "%"
          }
        }
      ]
    }
  ],
  "intentContext": [],
  "intentReport": {
    "reportingInterval": "PT5M",
    "handlerResponse": "Continuous"
  }
}