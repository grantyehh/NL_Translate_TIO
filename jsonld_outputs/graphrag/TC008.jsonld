{
  "@context": "https://tmforum.org/schemas/intent-ontology/v1.jsonld",
  "@type": "Intent",
  "id": "intent-tc008",
  "name": "Medical Image Upload Throughput Intent",
  "description": "Ensure the upload throughput of the medical image uploading service is at least 500 Mbps.",
  "intentOwner": {
    "id": "ops-manager-01",
    "name": "Network Operations Center"
  },
  "intentExpectation": [
    {
      "id": "exp-throughput-01",
      "name": "Upload Throughput Expectation",
      "description": "The upload throughput must be at least 500 Mbps.",
      "@type": "PropertyExpectation",
      "expectationObject": {
        "id": "service-medical-image-upload",
        "name": "Medical Image Uploading Service",
        "@type": "Service"
      },
      "expectationTarget": [
        {
          "name": "Upload Throughput",
          "targetProperty": "throughput",
          "matchCondition": "GREATER_THAN_OR_EQUAL",
          "targetValue": {
            "value": 500,
            "unit": "Mbps"
          }
        }
      ]
    }
  ],
  "intentContext": [],
  "intentReport": {
    "reportingInterval": "PT5M",
    "handlerResponse": "Continuous"
  }
}