{
  "@context": "https://tmforum.org/schemas/intent-ontology/v1.jsonld",
  "@type": "Intent",
  "id": "intent-tc006",
  "name": "Kaohsiung Port Crane Control Latency Intent",
  "description": "Ensure the latency of automated crane control traffic at Kaohsiung Port is below 5 ms.",
  "intentOwner": {
    "id": "ops-manager-01",
    "name": "Network Operations Center"
  },
  "intentExpectation": [
    {
      "id": "exp-latency-01",
      "name": "Crane Control Latency Expectation",
      "description": "The latency for automated crane control traffic must be less than 5 ms.",
      "@type": "PropertyExpectation",
      "expectationObject": {
        "id": "service-kaohsiung-port-crane-control",
        "name": "Kaohsiung Port Automated Crane Control Traffic",
        "@type": "Service"
      },
      "expectationTarget": [
        {
          "name": "Control Traffic Latency",
          "targetProperty": "latency",
          "matchCondition": "LESS_THAN",
          "targetValue": {
            "value": 5,
            "unit": "ms"
          }
        }
      ]
    }
  ],
  "intentContext": [],
  "intentReport": {
    "reportingInterval": "PT5M",
    "handlerResponse": "Continuous"
  }
}