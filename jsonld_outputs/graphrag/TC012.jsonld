{
  "@context": "https://tmforum.org/schemas/intent-ontology/v1.jsonld",
  "@type": "Intent",
  "id": "intent-tc012",
  "name": "Data Center Link Failover Intent",
  "description": "Switch traffic to backup line within 30 seconds if the primary data center link fails.",
  "intentOwner": {
    "id": "ops-manager-01",
    "name": "Network Operations Center"
  },
  "intentExpectation": [
    {
      "id": "exp-failover-01",
      "name": "Link Failover Expectation",
      "description": "Traffic must be switched to the backup line within 30 seconds upon primary link failure.",
      "@type": "DeliveryExpectation",
      "expectationObject": {
        "id": "resource-backup-line",
        "name": "Backup Line",
        "@type": "Resource"
      },
      "expectationTarget": [
        {
          "name": "Failover Time",
          "targetProperty": "failoverTime",
          "matchCondition": "LESS_THAN_OR_EQUAL",
          "targetValue": {
            "value": 30,
            "unit": "seconds"
          }
        }
      ]
    }
  ],
  "intentContext": [
    {
      "id": "ctx-primary-link-failure",
      "name": "Primary Link Failure Condition",
      "@type": "ConditionContext",
      "value": "primary_link_failure"
    }
  ],
  "intentReport": {
    "reportingInterval": "PT5M",
    "handlerResponse": "Continuous"
  }
}