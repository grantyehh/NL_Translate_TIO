{
  "@context": "https://tmforum.org/schemas/intent-ontology/v1.jsonld",
  "@type": "Intent",
  "id": "intent-tc017",
  "name": "Smart Meter Data Delivery Intent",
  "description": "Ensure smart meter data is successfully delivered at least once per day.",
  "intentOwner": {
    "id": "ops-manager-01",
    "name": "Network Operations Center"
  },
  "intentExpectation": [
    {
      "id": "exp-delivery-01",
      "name": "Daily Data Delivery Expectation",
      "description": "Smart meter data must be delivered successfully at least once every day.",
      "@type": "DeliveryExpectation",
      "expectationObject": {
        "id": "device-smart-meter",
        "name": "Smart Meter",
        "@type": "Device"
      },
      "expectationTarget": [
        {
          "name": "Daily Delivery Frequency",
          "targetProperty": "deliveryFrequency",
          "matchCondition": "GREATER_THAN_OR_EQUAL",
          "targetValue": {
            "value": 1,
            "unit": "times/day"
          }
        }
      ]
    }
  ],
  "intentContext": [],
  "intentReport": {
    "reportingInterval": "PT5M",
    "handlerResponse": "Continuous"
  }
}