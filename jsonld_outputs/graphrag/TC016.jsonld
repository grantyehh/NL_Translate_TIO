{
  "@context": "https://tmforum.org/schemas/intent-ontology/v1.jsonld",
  "@type": "Intent",
  "id": "intent-tc016",
  "name": "Financial Transaction API Traffic Security Intent",
  "description": "Ensure financial transaction API traffic is transmitted via encrypted and protected dedicated slices.",
  "intentOwner": {
    "id": "ops-manager-01",
    "name": "Network Operations Center"
  },
  "intentExpectation": [
    {
      "id": "exp-delivery-01",
      "name": "Encrypted Dedicated Slice Delivery",
      "description": "Deliver financial transaction API traffic through encrypted and protected dedicated slices.",
      "@type": "DeliveryExpectation",
      "expectationObject": {
        "id": "service-financial-transaction-api",
        "name": "Financial Transaction API Traffic",
        "@type": "Service"
      },
      "expectationTarget": [
        {
          "name": "Encryption Requirement",
          "targetProperty": "encryption",
          "matchCondition": "EQUALS",
          "targetValue": {
            "value": "enabled",
            "unit": "boolean"
          }
        },
        {
          "name": "Dedicated Slice Usage",
          "targetProperty": "dedicatedSlice",
          "matchCondition": "EQUALS",
          "targetValue": {
            "value": "true",
            "unit": "boolean"
          }
        }
      ]
    }
  ],
  "intentContext": [],
  "intentReport": {
    "reportingInterval": "PT5M",
    "handlerResponse": "Continuous"
  }
}