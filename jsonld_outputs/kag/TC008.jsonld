{
  "@context": "https://tmforum.org/schemas/intent-ontology/v1.jsonld",
  "@type": "Intent",
  "id": "intent-tc008",
  "name": "Enterprise VPN Hub-Spoke SLA Intent",
  "description": "Assure enterprise VPN SLA requirements for 晶耀半導體 using EnterpriseVpnSlaOntology vocabulary.",
  "intentOwner": {
    "id": "ops-manager-01",
    "name": "Network Operations Center"
  },
  "intentExpectation": [
    {
      "id": "exp-tc008-packet-loss",
      "name": "Hub-to-Spoke Packet Loss SLA Expectation",
      "description": "Guarantee evsla:packetLoss for 晶耀半導體 enterprise VPN service within the requested hub-and-spoke scope.",
      "@type": "PropertyExpectation",
      "expectationObject": {
        "id": "service-晶耀半導體-enterprise-vpn",
        "name": "晶耀半導體 Enterprise VPN Service",
        "@type": "Service",
        "evsla:forTenant": {
          "id": "tenant-晶耀半導體",
          "name": "晶耀半導體",
          "@type": "evsla:Tenant"
        },
        "ontologyType": "evsla:EnterpriseVpnService"
      },
      "expectationTarget": [
        {
          "name": "Hub-to-Spoke Packet Loss",
          "targetProperty": "evsla:packetLoss",
          "matchCondition": "LESS_THAN",
          "targetValue": {
            "value": 0.01,
            "unit": "%",
            "@type": "quan:Quantity"
          },
          "evsla:hasMetric": "evsla:packetLoss",
          "evsla:hasThreshold": {
            "value": 0.01,
            "unit": "%",
            "@type": "quan:Quantity"
          },
          "evsla:hasStatistic": "evsla:p99",
          "evsla:hasScope": "evsla:hubToAllSpokes",
          "evsla:hasMeasurementMethod": "evsla:twamp",
          "evsla:hasTimeWindow": "evsla:fiveMinuteWindow"
        }
      ],
      "ontologyType": "evsla:SlaExpectation"
    }
  ],
  "intentContext": [
    {
      "id": "tenant-context-tc008",
      "@type": "Context",
      "name": "Enterprise VPN Tenant Context",
      "evsla:forTenant": {
        "id": "tenant-晶耀半導體",
        "name": "晶耀半導體",
        "@type": "evsla:Tenant"
      }
    }
  ],
  "intentReport": {
    "reportingInterval": "PT5M",
    "handlerResponse": "Continuous"
  },
  "ontologyType": "evsla:EnterpriseVpnSlaIntent"
}