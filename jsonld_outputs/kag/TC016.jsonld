{
  "@context": "https://tmforum.org/schemas/intent-ontology/v1.jsonld",
  "@type": "Intent",
  "id": "intent-tc016",
  "name": "Enterprise VPN Hub-Spoke SLA Intent",
  "description": "Assure enterprise VPN SLA requirements for 智慧農業 using EnterpriseVpnSlaOntology vocabulary.",
  "intentOwner": {
    "id": "ops-manager-01",
    "name": "Network Operations Center"
  },
  "intentExpectation": [
    {
      "id": "exp-tc016-latency",
      "name": "Hub-to-Spoke Latency SLA Expectation",
      "description": "Guarantee evsla:latency for 智慧農業 enterprise VPN service within the requested hub-and-spoke scope.",
      "@type": "PropertyExpectation",
      "expectationObject": {
        "id": "service-智慧農業-enterprise-vpn",
        "name": "智慧農業 Enterprise VPN Service",
        "@type": "Service",
        "evsla:forTenant": {
          "id": "tenant-智慧農業",
          "name": "智慧農業",
          "@type": "evsla:Tenant"
        },
        "ontologyType": "evsla:EnterpriseVpnService"
      },
      "expectationTarget": [
        {
          "name": "Hub-to-Spoke Latency",
          "targetProperty": "evsla:latency",
          "matchCondition": "LESS_THAN",
          "targetValue": {
            "value": 100,
            "unit": "ms",
            "@type": "quan:Quantity"
          },
          "evsla:hasMetric": "evsla:latency",
          "evsla:hasThreshold": {
            "value": 100,
            "unit": "ms",
            "@type": "quan:Quantity"
          },
          "evsla:hasStatistic": "evsla:p95",
          "evsla:hasScope": "evsla:hubToAllSpokes",
          "evsla:hasMeasurementMethod": "evsla:twamp",
          "evsla:hasTimeWindow": "evsla:fiveMinuteWindow",
          "scope": {
            "hub": "Hub",
            "spokes": [
              "All Spokes"
            ]
          }
        }
      ],
      "ontologyType": "evsla:SlaExpectation"
    }
  ],
  "intentContext": [
    {
      "id": "topology-tc016",
      "@type": "Context",
      "name": "Hub-and-Spoke Topology",
      "evsla:hasHub": {
        "@type": "evsla:HubSite",
        "name": "Hub"
      },
      "evsla:hasSpoke": [
        {
          "@type": "evsla:SpokeSite",
          "name": "All Spokes"
        }
      ],
      "ontologyType": "evsla:HubAndSpokeTopology"
    }
  ],
  "intentReport": {
    "reportingInterval": "PT5M",
    "handlerResponse": "Continuous"
  },
  "ontologyType": "evsla:EnterpriseVpnSlaIntent"
}