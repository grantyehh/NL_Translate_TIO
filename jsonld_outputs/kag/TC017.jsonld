{
  "@context": "https://tmforum.org/schemas/intent-ontology/v1.jsonld",
  "@type": "Intent",
  "id": "intent-tc017",
  "name": "Enterprise VPN Hub-Spoke SLA Intent",
  "description": "Assure enterprise VPN SLA requirements for 國際會展 using EnterpriseVpnSlaOntology vocabulary.",
  "intentOwner": {
    "id": "ops-manager-01",
    "name": "Network Operations Center"
  },
  "intentExpectation": [
    {
      "id": "exp-tc017-packet-loss",
      "name": "Hub-to-Spoke Packet Loss SLA Expectation",
      "description": "Guarantee evsla:packetLoss for 國際會展 enterprise VPN service within the requested hub-and-spoke scope.",
      "@type": "PropertyExpectation",
      "expectationObject": {
        "id": "service-國際會展-enterprise-vpn",
        "name": "國際會展 Enterprise VPN Service",
        "@type": "Service",
        "ontologyType": "evsla:EnterpriseVpnService"
      },
      "expectationTarget": [
        {
          "name": "Hub-to-Spoke Packet Loss",
          "targetProperty": "evsla:packetLoss",
          "matchCondition": "LESS_THAN",
          "targetValue": {
            "value": 0.15,
            "unit": "%",
            "@type": "quan:Quantity"
          },
          "evsla:hasMetric": "evsla:packetLoss",
          "evsla:hasThreshold": {
            "value": 0.15,
            "unit": "%",
            "@type": "quan:Quantity"
          },
          "evsla:hasStatistic": "evsla:p99",
          "evsla:hasScope": "evsla:hubToAllSpokes",
          "evsla:hasMeasurementMethod": "evsla:twamp",
          "evsla:hasTimeWindow": "evsla:fiveMinuteWindow",
          "scope": {
            "hub": "國際會展Hub"
          }
        }
      ],
      "ontologyType": "evsla:SlaExpectation"
    }
  ],
  "intentContext": [
    {
      "id": "topology-tc017",
      "@type": "Context",
      "name": "Hub-and-Spoke Topology",
      "evsla:hasHub": {
        "@type": "evsla:HubSite",
        "name": "國際會展Hub"
      },
      "ontologyType": "evsla:HubAndSpokeTopology"
    }
  ],
  "intentReport": {
    "reportingInterval": "PT5M",
    "handlerResponse": "Continuous"
  },
  "ontologyType": "evsla:EnterpriseVpnSlaIntent"
}