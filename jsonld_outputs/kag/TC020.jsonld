{
  "@context": "https://tmforum.org/schemas/intent-ontology/v1.jsonld",
  "@type": "Intent",
  "id": "intent-tc020",
  "name": "Enterprise VPN Hub-Spoke SLA Intent",
  "description": "Assure enterprise VPN SLA requirements for 精準醫材 using EnterpriseVpnSlaOntology vocabulary.",
  "intentOwner": {
    "id": "ops-manager-01",
    "name": "Network Operations Center"
  },
  "tenant": {
    "id": "tenant-精準醫材",
    "name": "精準醫材",
    "@type": "evsla:Tenant"
  },
  "intentExpectation": [
    {
      "id": "exp-tc020-latency",
      "name": "Hub-to-Spoke Latency SLA Expectation",
      "description": "Guarantee evsla:latency for 精準醫材 enterprise VPN service within the requested hub-and-spoke scope.",
      "@type": "PropertyExpectation",
      "expectationObject": {
        "id": "service-精準醫材-enterprise-vpn",
        "name": "精準醫材 Enterprise VPN Service",
        "@type": "Service",
        "evsla:forTenant": {
          "id": "tenant-精準醫材",
          "name": "精準醫材",
          "@type": "evsla:Tenant"
        },
        "ontologyType": "evsla:EnterpriseVpnService"
      },
      "expectationTarget": [
        {
          "name": "Hub-to-Spoke Latency",
          "targetProperty": "evsla:latency",
          "matchCondition": "LESS_THAN",
          "targetValue": {
            "value": 35,
            "unit": "ms",
            "@type": "quan:Quantity"
          },
          "evsla:hasMetric": "evsla:latency",
          "evsla:hasThreshold": {
            "value": 35,
            "unit": "ms",
            "@type": "quan:Quantity"
          },
          "evsla:hasStatistic": "evsla:p95",
          "evsla:hasScope": "evsla:hubToAllSpokes",
          "evsla:hasMeasurementMethod": "evsla:twamp",
          "evsla:hasTimeWindow": "evsla:fiveMinuteWindow",
          "scope": {
            "hub": "台北研發總部",
            "spokes": [
              "竹北實驗室",
              "台南製造廠"
            ]
          }
        }
      ],
      "ontologyType": "evsla:SlaExpectation"
    },
    {
      "id": "exp-tc020-packet-loss",
      "name": "Hub-to-Spoke Packet Loss SLA Expectation",
      "description": "Guarantee evsla:packetLoss for 精準醫材 enterprise VPN service within the requested hub-and-spoke scope.",
      "@type": "PropertyExpectation",
      "expectationObject": {
        "id": "service-精準醫材-enterprise-vpn",
        "name": "精準醫材 Enterprise VPN Service",
        "@type": "Service",
        "evsla:forTenant": {
          "id": "tenant-精準醫材",
          "name": "精準醫材",
          "@type": "evsla:Tenant"
        },
        "ontologyType": "evsla:EnterpriseVpnService"
      },
      "expectationTarget": [
        {
          "name": "Hub-to-Spoke Packet Loss",
          "targetProperty": "evsla:packetLoss",
          "matchCondition": "LESS_THAN",
          "targetValue": {
            "value": 0.05,
            "unit": "%",
            "@type": "quan:Quantity"
          },
          "evsla:hasMetric": "evsla:packetLoss",
          "evsla:hasThreshold": {
            "value": 0.05,
            "unit": "%",
            "@type": "quan:Quantity"
          },
          "evsla:hasStatistic": "evsla:p99",
          "evsla:hasScope": "evsla:hubToAllSpokes",
          "evsla:hasMeasurementMethod": "evsla:twamp",
          "evsla:hasTimeWindow": "evsla:fiveMinuteWindow",
          "scope": {
            "hub": "台北研發總部",
            "spokes": [
              "竹北實驗室",
              "台南製造廠"
            ]
          }
        }
      ],
      "ontologyType": "evsla:SlaExpectation"
    }
  ],
  "intentContext": [
    {
      "id": "topology-tc020",
      "@type": "Context",
      "name": "Hub-and-Spoke Topology"
    }
  ],
  "intentReport": {
    "reportingInterval": "PT5M",
    "handlerResponse": "Continuous"
  }
}