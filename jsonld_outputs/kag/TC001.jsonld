{
  "@context": "https://tmforum.org/schemas/intent-ontology/v1.jsonld",
  "@type": "Intent",
  "id": "intent-tc001",
  "name": "Enterprise VPN Hub-Spoke SLA Intent",
  "description": "Assure enterprise VPN SLA requirements for 星河銀行 using EnterpriseVpnSlaOntology vocabulary.",
  "intentOwner": {
    "id": "ops-manager-01",
    "name": "Network Operations Center"
  },
  "intentExpectation": [
    {
      "id": "exp-tc001-latency",
      "name": "Hub-to-Spoke Latency SLA Expectation",
      "description": "Guarantee evsla:latency for 星河銀行 enterprise VPN service within the requested hub-and-spoke scope.",
      "@type": "PropertyExpectation",
      "expectationObject": {
        "id": "service-星河銀行-enterprise-vpn",
        "name": "星河銀行 Enterprise VPN Service",
        "@type": "Service",
        "evsla:forTenant": {
          "id": "tenant-星河銀行",
          "name": "星河銀行",
          "@type": "evsla:Tenant"
        },
        "ontologyType": "evsla:EnterpriseVpnService"
      },
      "expectationTarget": [
        {
          "name": "Hub-to-Spoke Latency",
          "targetProperty": "evsla:latency",
          "matchCondition": "LESS_THAN",
          "targetValue": {
            "value": 50,
            "unit": "ms",
            "@type": "quan:Quantity"
          },
          "evsla:hasMetric": "evsla:latency",
          "evsla:hasThreshold": {
            "value": 50,
            "unit": "ms",
            "@type": "quan:Quantity"
          },
          "evsla:hasStatistic": "evsla:p95",
          "evsla:hasScope": "evsla:hubToAllSpokes",
          "evsla:hasMeasurementMethod": "evsla:twamp",
          "evsla:hasTimeWindow": "evsla:fiveMinuteWindow"
        }
      ],
      "ontologyType": "evsla:SlaExpectation"
    }
  ],
  "intentContext": [
    {
      "id": "tenant-tc001",
      "@type": "Context",
      "name": "Enterprise Tenant Context",
      "tenant": {
        "id": "tenant-星河銀行",
        "name": "星河銀行",
        "@type": "evsla:Tenant"
      }
    }
  ],
  "intentReport": {
    "reportingInterval": "PT5M",
    "handlerResponse": "Continuous"
  },
  "ontologyType": "evsla:EnterpriseVpnSlaIntent"
}