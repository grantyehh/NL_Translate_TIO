{
  "@context": "https://tmforum.org/schemas/intent-ontology/v1.jsonld",
  "@type": "Intent",
  "id": "intent-tc009",
  "name": "Emergency Services Traffic Priority Intent",
  "description": "Ensure communication traffic for fire and rescue units always has priority over general public traffic.",
  "intentOwner": {
    "id": "ops-manager-01",
    "name": "Network Operations Center"
  },
  "intentExpectation": [
    {
      "id": "exp-priority-01",
      "name": "Emergency Services Traffic Priority",
      "description": "Traffic for fire and rescue units must always have higher priority than general public traffic.",
      "@type": "PropertyExpectation",
      "expectationObject": {
        "id": "service-emergency-traffic",
        "name": "Emergency Services Traffic",
        "@type": "Service"
      },
      "expectationTarget": [
        {
          "name": "Traffic Priority",
          "targetProperty": "priority",
          "matchCondition": "GREATER_THAN",
          "targetValue": {
            "value": 1,
            "unit": "priority_level"
          }
        }
      ]
    },
    {
      "id": "exp-priority-02",
      "name": "General Public Traffic Priority",
      "description": "Traffic for the general public must have lower priority than emergency services traffic.",
      "@type": "PropertyExpectation",
      "expectationObject": {
        "id": "service-public-traffic",
        "name": "General Public Traffic",
        "@type": "Service"
      },
      "expectationTarget": [
        {
          "name": "Traffic Priority",
          "targetProperty": "priority",
          "matchCondition": "LESS_THAN",
          "targetValue": {
            "value": 1,
            "unit": "priority_level"
          }
        }
      ]
    }
  ],
  "intentContext": [],
  "intentReport": {
    "reportingInterval": "PT5M",
    "handlerResponse": "Continuous"
  }
}