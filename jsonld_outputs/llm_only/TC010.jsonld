{
  "@context": "https://tmforum.org/schemas/intent-ontology/v1.jsonld",
  "@type": "Intent",
  "id": "intent-tc010",
  "name": "Taichung Metro Network Availability Intent",
  "description": "Ensure the Taichung Metro monitoring network maintains an availability of at least 99.95% throughout the year.",
  "intentOwner": {
    "id": "ops-manager-01",
    "name": "Network Operations Center"
  },
  "intentExpectation": [
    {
      "id": "exp-availability-01",
      "name": "Network Availability Expectation",
      "description": "The network availability must not fall below 99.95% annually.",
      "@type": "PropertyExpectation",
      "expectationObject": {
        "id": "service-taichung-metro-monitoring-network",
        "name": "Taichung Metro Monitoring Network",
        "@type": "Service"
      },
      "expectationTarget": [
        {
          "name": "Annual Availability",
          "targetProperty": "availability",
          "matchCondition": "GREATER_THAN_OR_EQUAL",
          "targetValue": {
            "value": 99.95,
            "unit": "%"
          }
        }
      ]
    }
  ],
  "intentContext": [],
  "intentReport": {
    "reportingInterval": "PT5M",
    "handlerResponse": "Continuous"
  }
}