{
  "@context": "https://tmforum.org/schemas/intent-ontology/v1.jsonld",
  "@type": "Intent",
  "id": "intent-tc003",
  "name": "Enterprise Private Network Availability Intent",
  "description": "Ensure the enterprise private network in Hsinchu campus achieves 99.99% availability.",
  "intentOwner": {
    "id": "ops-manager-01",
    "name": "Network Operations Center"
  },
  "intentExpectation": [
    {
      "id": "exp-availability-01",
      "name": "Availability Expectation",
      "description": "The availability of the enterprise private network must reach 99.99%.",
      "@type": "PropertyExpectation",
      "expectationObject": {
        "id": "service-enterprise-private-network",
        "name": "Enterprise Private Network",
        "@type": "Service"
      },
      "expectationTarget": [
        {
          "name": "Network Availability",
          "targetProperty": "availability",
          "matchCondition": "GREATER_THAN_OR_EQUAL",
          "targetValue": {
            "value": 99.99,
            "unit": "%"
          }
        }
      ]
    }
  ],
  "intentContext": [
    {
      "id": "ctx-location-hsinchu-01",
      "name": "Hsinchu Campus",
      "@type": "LocationContext",
      "value": "Hsinchu"
    }
  ],
  "intentReport": {
    "reportingInterval": "PT5M",
    "handlerResponse": "Continuous"
  }
}