{
  "@context": "https://tmforum.org/schemas/intent-ontology/v1.jsonld",
  "@type": "Intent",
  "id": "intent-tc005",
  "name": "Base Station Load and Streaming Bandwidth Control Intent",
  "description": "Automatically throttle non-essential video streaming bandwidth if base station load exceeds 80%.",
  "intentOwner": {
    "id": "ops-manager-01",
    "name": "Network Operations Center"
  },
  "intentExpectation": [
    {
      "id": "exp-load-monitor-01",
      "name": "Base Station Load Monitoring",
      "description": "Monitor base station load to ensure it does not exceed 80%.",
      "@type": "PropertyExpectation",
      "expectationObject": {
        "id": "resource-base-station",
        "name": "Base Station",
        "@type": "Resource"
      },
      "expectationTarget": [
        {
          "name": "Load Threshold",
          "targetProperty": "load",
          "matchCondition": "GREATER_THAN",
          "targetValue": {
            "value": 80,
            "unit": "%"
          }
        }
      ]
    },
    {
      "id": "exp-bandwidth-throttle-01",
      "name": "Non-Essential Streaming Bandwidth Throttle",
      "description": "Throttle bandwidth for non-essential video streaming when base station load exceeds threshold.",
      "@type": "PropertyExpectation",
      "expectationObject": {
        "id": "service-non-essential-streaming",
        "name": "Non-Essential Video Streaming",
        "@type": "Service"
      },
      "expectationTarget": [
        {
          "name": "Bandwidth Throttle",
          "targetProperty": "bandwidth",
          "matchCondition": "LESS_THAN_OR_EQUAL",
          "targetValue": {
            "value": 0,
            "unit": "Mbps"
          }
        }
      ]
    }
  ],
  "intentContext": [],
  "intentReport": {
    "reportingInterval": "PT5M",
    "handlerResponse": "Continuous"
  }
}