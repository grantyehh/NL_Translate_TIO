{
  "@context": "https://tmforum.org/schemas/intent-ontology/v1.jsonld",
  "@type": "Intent",
  "id": "intent-tc001",
  "name": "5G Slice Service Establishment Intent",
  "description": "Establish a 5G slice service between Taipei and Taichung.",
  "intentOwner": {
    "id": "ops-manager-01",
    "name": "Network Operations Center"
  },
  "intentExpectation": [
    {
      "id": "exp-delivery-01",
      "name": "5G Slice Service Delivery",
      "description": "Deliver a 5G slice service between Taipei and Taichung.",
      "@type": "DeliveryExpectation",
      "expectationObject": {
        "id": "service-5g-slice",
        "name": "5G Slice Service",
        "@type": "Service"
      },
      "expectationTarget": [
        {
          "name": "Connectivity Scope",
          "targetProperty": "connectivity",
          "matchCondition": "EQUALS",
          "targetValue": {
            "from": "Taipei",
            "to": "Taichung"
          }
        }
      ]
    }
  ],
  "intentContext": [
    {
      "id": "ctx-location-01",
      "name": "Geographic Scope",
      "@type": "LocationContext",
      "value": "Taipei_to_Taichung"
    }
  ],
  "intentReport": {
    "reportingInterval": "PT5M",
    "handlerResponse": "Continuous"
  }
}