{
  "@context": "https://tmforum.org/schemas/intent-ontology/v1.jsonld",
  "@type": "Intent",
  "id": "intent-tc009",
  "name": "Emergency Traffic Priority Intent",
  "description": "Ensure communication traffic for fire and ambulance units always takes precedence over general public traffic.",
  "intentOwner": {
    "id": "ops-manager-01",
    "name": "Network Operations Center"
  },
  "intentExpectation": [
    {
      "id": "exp-priority-01",
      "name": "Emergency Traffic Priority Expectation",
      "description": "Prioritize communication traffic for fire and ambulance units over general public traffic.",
      "@type": "DeliveryExpectation",
      "expectationObject": {
        "id": "service-emergency-communication",
        "name": "Emergency Communication Traffic",
        "@type": "Service"
      },
      "expectationTarget": [
        {
          "name": "Traffic Priority",
          "targetProperty": "priority",
          "matchCondition": "GREATER_THAN",
          "targetValue": {
            "value": 1,
            "unit": "priority-level"
          }
        }
      ]
    }
  ],
  "intentContext": [],
  "intentReport": {
    "reportingInterval": "PT5M",
    "handlerResponse": "Continuous"
  }
}