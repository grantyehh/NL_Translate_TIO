{
  "@context": "https://tmforum.org/schemas/intent-ontology/v1.jsonld",
  "@type": "Intent",
  "id": "intent-tc019",
  "name": "Suburban Small Cell Energy-Saving Intent",
  "description": "Switch suburban small cell towers to energy-saving mode between 01:00 and 05:00 if there are no high-priority business operations.",
  "intentOwner": {
    "id": "ops-manager-01",
    "name": "Network Operations Center"
  },
  "intentExpectation": [
    {
      "id": "exp-energy-saving-01",
      "name": "Energy-Saving Mode Activation",
      "description": "Activate energy-saving mode for suburban small cell towers during specified time if no high-priority business operations are detected.",
      "@type": "PropertyExpectation",
      "expectationObject": {
        "id": "resource-suburban-small-cell",
        "name": "Suburban Small Cell Towers",
        "@type": "Resource"
      },
      "expectationTarget": [
        {
          "name": "Energy-Saving Mode",
          "targetProperty": "operationalMode",
          "matchCondition": "EQUALS",
          "targetValue": {
            "value": "energy-saving"
          }
        }
      ]
    }
  ],
  "intentContext": [
    {
      "id": "ctx-time-01",
      "name": "Time Window",
      "@type": "TimeContext",
      "value": "01:00-05:00"
    },
    {
      "id": "ctx-condition-01",
      "name": "No High-Priority Business Operations",
      "@type": "ConditionContext",
      "value": "no_high_priority_business"
    }
  ],
  "intentReport": {
    "reportingInterval": "PT5M",
    "handlerResponse": "Continuous"
  }
}