{
  "@context": "https://tmforum.org/schemas/intent-ontology/v1.jsonld",
  "@type": "Intent",
  "id": "intent-tc018",
  "name": "Factory Wireless Sensor Packet Loss Intent",
  "description": "Increase wireless resource allocation if packet loss rate of factory wireless sensors exceeds 3% for 5 consecutive minutes.",
  "intentOwner": {
    "id": "ops-manager-01",
    "name": "Network Operations Center"
  },
  "intentExpectation": [
    {
      "id": "exp-packet-loss-01",
      "name": "Packet Loss Rate Monitoring",
      "description": "Monitor packet loss rate of factory wireless sensors and trigger resource allocation adjustment if it exceeds 3% for 5 consecutive minutes.",
      "@type": "PropertyExpectation",
      "expectationObject": {
        "id": "resource-factory-wireless-sensors",
        "name": "Factory Wireless Sensors",
        "@type": "Resource"
      },
      "expectationTarget": [
        {
          "name": "Packet Loss Rate",
          "targetProperty": "packetLossRate",
          "matchCondition": "GREATER_THAN",
          "targetValue": {
            "value": 3,
            "unit": "%"
          }
        }
      ]
    },
    {
      "id": "exp-resource-adjustment-01",
      "name": "Wireless Resource Allocation Adjustment",
      "description": "Adjust wireless resource allocation in the factory area when packet loss condition is met.",
      "@type": "DeliveryExpectation",
      "expectationObject": {
        "id": "resource-factory-wireless",
        "name": "Factory Wireless Resource",
        "@type": "Resource"
      },
      "expectationTarget": []
    }
  ],
  "intentContext": [
    {
      "id": "ctx-time-01",
      "name": "Consecutive Monitoring Duration",
      "@type": "TimeContext",
      "value": "PT5M"
    }
  ],
  "intentReport": {
    "reportingInterval": "PT5M",
    "handlerResponse": "Continuous"
  }
}