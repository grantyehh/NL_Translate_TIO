{
  "@context": "https://tmforum.org/schemas/intent-ontology/v1.jsonld",
  "@type": "Intent",
  "id": "intent-tc014",
  "name": "Enterprise VPN Hub-Spoke SLA Intent",
  "description": "Assure packet loss below 0.05% for 聯合媒體 enterprise VPN traffic from the hub to all spokes at p99 over five-minute windows.",
  "ontologyType": "evsla:EnterpriseVpnSlaIntent",
  "intentOwner": {
    "id": "ops-manager-01",
    "name": "Network Operations Center"
  },
  "tenant": {
    "id": "tenant:聯合媒體",
    "name": "聯合媒體",
    "@type": "evsla:Tenant"
  },
  "intentExpectation": [
    {
      "id": "exp-tc014-packet-loss",
      "name": "Hub-to-Spoke Packet Loss SLA Expectation",
      "description": "Guarantee evsla:packetLoss for 聯合媒體 enterprise VPN service across all spokes.",
      "@type": "PropertyExpectation",
      "ontologyType": "evsla:SlaExpectation",
      "expectationObject": {
        "id": "svc:聯合媒體-enterprise-vpn",
        "name": "聯合媒體 Enterprise VPN Service",
        "@type": "Service",
        "ontologyType": "evsla:EnterpriseVpnService"
      },
      "expectationTarget": [
        {
          "name": "Hub-to-Spoke Packet Loss",
          "targetProperty": "evsla:packetLoss",
          "matchCondition": "LESS_THAN",
          "targetValue": {
            "value": 0.05,
            "unit": "%",
            "@type": "quan:Quantity"
          },
          "evsla:hasMetric": "evsla:packetLoss",
          "evsla:hasThreshold": {
            "value": 0.05,
            "unit": "%",
            "@type": "quan:Quantity"
          },
          "evsla:hasStatistic": "evsla:p99",
          "evsla:hasScope": "evsla:hubToAllSpokes",
          "evsla:hasMeasurementMethod": "evsla:twamp",
          "evsla:hasTimeWindow": "evsla:fiveMinuteWindow"
        }
      ]
    }
  ],
  "intentContext": [
    {
      "id": "topology-tc014",
      "@type": "Context",
      "name": "Hub-and-Spoke Topology",
      "ontologyType": "evsla:HubAndSpokeTopology",
      "evsla:hasHub": {
        "@type": "evsla:HubSite",
        "name": "聯合媒體Hub"
      },
      "evsla:hasSpoke": [
        {
          "@type": "evsla:SpokeSite",
          "name": "Spoke-1"
        }
      ]
    }
  ],
  "intentReport": {
    "reportingInterval": "PT5M",
    "handlerResponse": "Continuous"
  }
}