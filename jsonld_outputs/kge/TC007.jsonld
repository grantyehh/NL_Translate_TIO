{
  "@context": "https://tmforum.org/schemas/intent-ontology/v1.jsonld",
  "@type": "Intent",
  "id": "intent-tc007",
  "name": "Enterprise VPN Hub-Spoke SLA Intent",
  "description": "Assure latency below 80 ms at the 95th percentile from 海港航運高雄港營運中心 to all port spoke sites.",
  "ontologyType": "evsla:EnterpriseVpnSlaIntent",
  "intentOwner": {
    "id": "ops-manager-01",
    "name": "Network Operations Center"
  },
  "tenant": {
    "id": "tenant:海港航運",
    "name": "海港航運",
    "@type": "evsla:Tenant"
  },
  "intentExpectation": [
    {
      "id": "exp-tc007-latency",
      "name": "Hub-to-Spoke Latency SLA Expectation",
      "description": "Guarantee evsla:latency for 海港航運 enterprise VPN service within the requested hub-and-spoke scope.",
      "@type": "PropertyExpectation",
      "ontologyType": "evsla:SlaExpectation",
      "expectationObject": {
        "id": "svc:海港航運-enterprise-vpn",
        "name": "海港航運 Enterprise VPN Service",
        "@type": "Service",
        "ontologyType": "evsla:EnterpriseVpnService"
      },
      "expectationTarget": [
        {
          "name": "Hub-to-Spoke Latency",
          "targetProperty": "evsla:latency",
          "matchCondition": "LESS_THAN",
          "targetValue": {
            "value": 80,
            "unit": "ms",
            "@type": "quan:Quantity"
          },
          "evsla:hasMetric": "evsla:latency",
          "evsla:hasThreshold": {
            "value": 80,
            "unit": "ms",
            "@type": "quan:Quantity"
          },
          "evsla:hasStatistic": "evsla:p95",
          "evsla:hasScope": "evsla:hubToAllSpokes",
          "evsla:hasMeasurementMethod": "evsla:twamp",
          "evsla:hasTimeWindow": "evsla:fiveMinuteWindow",
          "scope": {
            "hub": "高雄港營運中心",
            "spokes": [
              "所有港站分點"
            ]
          }
        }
      ]
    }
  ],
  "intentContext": [
    {
      "id": "topology-tc007",
      "@type": "Context",
      "name": "Hub-and-Spoke Topology",
      "ontologyType": "evsla:HubAndSpokeTopology",
      "evsla:hasHub": {
        "@type": "evsla:HubSite",
        "name": "高雄港營運中心"
      },
      "evsla:hasSpoke": [
        {
          "@type": "evsla:SpokeSite",
          "name": "所有港站分點"
        }
      ]
    }
  ],
  "intentReport": {
    "reportingInterval": "PT5M",
    "handlerResponse": "Continuous"
  }
}