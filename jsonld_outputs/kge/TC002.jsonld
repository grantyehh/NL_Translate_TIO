{
  "@context": "https://tmforum.org/schemas/intent-ontology/v1.jsonld",
  "@type": "Intent",
  "id": "intent-tc002",
  "name": "Enterprise VPN Hub-Spoke SLA Intent",
  "description": "Assure packet loss below 0.1% for 遠東製造 enterprise VPN traffic from the hub to all spokes at p99 over five-minute windows.",
  "ontologyType": "evsla:EnterpriseVpnSlaIntent",
  "intentOwner": {
    "id": "ops-manager-01",
    "name": "Network Operations Center"
  },
  "tenant": {
    "id": "tenant:遠東製造",
    "name": "遠東製造",
    "@type": "evsla:Tenant"
  },
  "intentExpectation": [
    {
      "id": "exp-tc002-packet-loss",
      "name": "Hub-to-Spoke Packet Loss SLA Expectation",
      "description": "Guarantee evsla:packetLoss for 遠東製造 enterprise VPN service within the requested hub-and-spoke scope.",
      "@type": "PropertyExpectation",
      "ontologyType": "evsla:SlaExpectation",
      "expectationObject": {
        "id": "svc:遠東製造-enterprise-vpn",
        "name": "遠東製造 Enterprise VPN Service",
        "@type": "Service",
        "ontologyType": "evsla:EnterpriseVpnService"
      },
      "expectationTarget": [
        {
          "name": "Hub-to-Spoke Packet Loss",
          "targetProperty": "evsla:packetLoss",
          "matchCondition": "LESS_THAN",
          "targetValue": {
            "value": 0.1,
            "unit": "%",
            "@type": "quan:Quantity"
          },
          "evsla:hasMetric": "evsla:packetLoss",
          "evsla:hasThreshold": {
            "value": 0.1,
            "unit": "%",
            "@type": "quan:Quantity"
          },
          "evsla:hasStatistic": "evsla:p99",
          "evsla:hasScope": "evsla:hubToAllSpokes",
          "evsla:hasMeasurementMethod": "evsla:twamp",
          "evsla:hasTimeWindow": "evsla:fiveMinuteWindow",
          "scope": {
            "hub": "遠東製造Hub",
            "spokes": [
              "All Spokes"
            ]
          }
        }
      ]
    }
  ],
  "intentContext": [
    {
      "id": "topology-tc002",
      "@type": "Context",
      "name": "Hub-and-Spoke Topology",
      "ontologyType": "evsla:HubAndSpokeTopology",
      "evsla:hasHub": {
        "@type": "evsla:HubSite",
        "name": "遠東製造Hub"
      },
      "evsla:hasSpoke": [
        {
          "@type": "evsla:SpokeSite",
          "name": "All Spokes"
        }
      ]
    }
  ],
  "intentReport": {
    "reportingInterval": "PT5M",
    "handlerResponse": "Continuous"
  }
}